<Window x:Class="DocumentManagement.GenerateDocumentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Tạo Công Văn" Height="650" Width="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1E293B">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header với thiết kế hiện đại -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="12,12,0,0" Padding="24,20" Margin="0,0,0,16">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Tạo Công Văn" FontSize="20" FontWeight="Bold" Foreground="#F1F5F9"/>
                    <TextBlock Text="{Binding ContractInfo}" FontSize="13" Foreground="#94A3B8" Margin="0,4,0,0"/>
                </StackPanel>
                
                <!-- Progress indicator -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Style="{StaticResource StatusBadge}" Background="#1E40AF">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileDocument" Width="14" Height="14" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="Bước 1/3" Foreground="White" FontSize="11" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Chọn loại công văn -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Loại công văn *" FontSize="13" Foreground="#94A3B8" Margin="0,0,0,6"/>
                <ComboBox x:Name="DocumentTypeCombo" Style="{StaticResource ModernComboBox}"
                          SelectionChanged="DocumentTypeCombo_SelectionChanged"/>
            </StackPanel>
            
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="Tổng thầu *" FontSize="13" Foreground="#94A3B8" Margin="0,0,0,6"/>
                <ComboBox x:Name="ContractorCombo" Style="{StaticResource ModernComboBox}"
                          SelectionChanged="ContractorCombo_SelectionChanged"/>
            </StackPanel>
        </Grid>
        
        <!-- Template status -->
        <Border Grid.Row="2" Background="#0F172A" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <materialDesign:PackIcon x:Name="TemplateIcon" Kind="FileDocument" Width="20" Height="20" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Margin="10,0">
                    <TextBlock x:Name="TemplateStatusText" FontSize="13" Foreground="#F1F5F9"/>
                    <TextBlock x:Name="TemplatePathText" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Grid.Column="2" Content="Mở thư mục" Height="28" Padding="12,0"
                        Background="#334155" Foreground="#F1F5F9" BorderThickness="0"
                        Click="OpenContractorFolder_Click" FontSize="11"/>
            </Grid>
        </Border>

        <!-- Nguồn dữ liệu -->
        <Border Grid.Row="3" Background="#0F172A" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Nguồn dữ liệu (tự động tìm nếu để trống)" FontSize="12" Foreground="#64748B" Margin="0,0,0,8"/>
                
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SourceWordTextBox" 
                             Background="#1E293B" Foreground="#94A3B8" 
                             BorderBrush="#334155" BorderThickness="1"
                             Padding="10,6" FontSize="11" IsReadOnly="True"
                             Text="File Word hợp đồng (tự động)"/>
                    <Button Grid.Column="1" Content="Chọn" Width="60" Height="28" Margin="6,0,0,0"
                            Background="#334155" Foreground="#F1F5F9" BorderThickness="0"
                            Click="BrowseWordFile_Click" FontSize="11"/>
                </Grid>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SourceExcelTextBox" 
                             Background="#1E293B" Foreground="#94A3B8" 
                             BorderBrush="#334155" BorderThickness="1"
                             Padding="10,6" FontSize="11" IsReadOnly="True"
                             Text="File Excel giá trị (tự động)"/>
                    <Button Grid.Column="1" Content="Chọn" Width="60" Height="28" Margin="6,0,0,0"
                            Background="#334155" Foreground="#F1F5F9" BorderThickness="0"
                            Click="BrowseExcelFile_Click" FontSize="11"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Placeholder info -->
        <Expander Grid.Row="4" Header="Danh sách Placeholder" Foreground="#64748B" Margin="0,0,0,12" FontSize="12">
            <Border Background="#0F172A" CornerRadius="8" Padding="12" MaxHeight="120">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="PlaceholderList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Placeholder}" Foreground="#3B82F6" FontSize="10" FontFamily="Consolas"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Description}" Foreground="#64748B" FontSize="10"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Expander>

        <!-- Thông tin bổ sung -->
        <StackPanel Grid.Row="5">
            <TextBlock Text="Thông tin bổ sung" FontSize="13" Foreground="#94A3B8" Margin="0,0,0,6"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ExtraFieldsPanel"/>
            </ScrollViewer>
        </StackPanel>

        <!-- Buttons -->
        <Grid Grid.Row="6" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <Button Content="Mở Templates" Height="36" Padding="14,0"
                    Background="#334155" Foreground="#F1F5F9" BorderThickness="0"
                    Click="OpenTemplateFolder_Click" FontSize="12"/>
            
            <Button Grid.Column="2" Content="Hủy" Width="80" Height="36" 
                    Background="#475569" Foreground="#F1F5F9" BorderThickness="0" Margin="0,0,10,0"
                    Click="CancelButton_Click" FontSize="12"/>
            <Button Grid.Column="3" x:Name="GenerateButton" Content="Tạo công văn" Width="120" Height="36" 
                    Background="#3B82F6" Foreground="White" BorderThickness="0"
                    Click="GenerateButton_Click" FontSize="12"/>
        </Grid>
    </Grid>
</Window>
