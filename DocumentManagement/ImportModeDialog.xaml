<Window x:Class="DocumentManagement.ImportModeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Chọn cách nạp dữ liệu"
        Width="620"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        SizeToContent="Height">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ImportActionButton" TargetType="Button">
                <Setter Property="Height" Value="42" />
                <Setter Property="MinWidth" Value="120" />
                <Setter Property="Margin" Value="8,0,0,0" />
                <Setter Property="Padding" Value="18,0" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Margin="10"
            Padding="26"
            Background="{DynamicResource Blueprint.Surface}"
            BorderBrush="{DynamicResource Blueprint.Outline}"
            BorderThickness="1"
            CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.42" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="32" />
                </Grid.ColumnDefinitions>
                <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource Blueprint.SurfaceBright}">
                    <materialDesign:PackIcon Kind="FileExcel" Width="27" Height="27" Foreground="{DynamicResource Blueprint.Primary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Nạp dữ liệu từ Excel" FontSize="18" FontWeight="ExtraBold" Foreground="{DynamicResource Blueprint.OnSurface}" />
                    <TextBlock x:Name="DescriptionText" Margin="0,4,0,0" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" />
                </StackPanel>
                <Button Grid.Column="2" Click="CancelButton_Click" Background="Transparent" BorderThickness="0" ToolTip="Hủy">
                    <materialDesign:PackIcon Kind="Close" Width="20" Height="20" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" />
                </Button>
            </Grid>

            <Border Grid.Row="1" Padding="16" Margin="0,0,0,20" CornerRadius="10" Background="{DynamicResource Blueprint.SurfaceContainer}" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Chọn cách nạp" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Blueprint.OnSurface}" />
                    <TextBlock x:Name="AppendDescriptionText" Margin="0,10,0,5" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" />
                    <TextBlock x:Name="ReplaceDescriptionText" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="HỦY" Click="CancelButton_Click" Background="Transparent" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="1" Style="{StaticResource ImportActionButton}" />
                <Button Content="NẠP THÊM" Click="AppendButton_Click" Background="{DynamicResource Blueprint.Selection}" Foreground="{DynamicResource Blueprint.OnSurface}" BorderBrush="{DynamicResource Blueprint.Primary}" BorderThickness="1" Style="{StaticResource ImportActionButton}" />
                <Button Content="NẠP ĐÈ" Click="ReplaceButton_Click" Background="{DynamicResource Blueprint.Primary}" Foreground="White" BorderThickness="0" Style="{StaticResource ImportActionButton}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
