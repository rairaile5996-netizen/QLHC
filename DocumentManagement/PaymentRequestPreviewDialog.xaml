<Window x:Class="DocumentManagement.PaymentRequestPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Xác nhận thông tin công văn thanh toán" 
        Height="480" Width="560"
        WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize"
        Background="#1E293B">
    
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Tạo Công Văn Thanh Toán" FontSize="20" FontWeight="Bold" Foreground="#F1F5F9"/>
        </StackPanel>

        <!-- Loading State - Simple Skeleton -->
        <ScrollViewer x:Name="LoadingPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Visible">
            <StackPanel>
                <!-- Contract Info Skeleton -->
                <Border Background="#0F172A" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <Border Background="#334155" CornerRadius="4" Width="140" Height="14" HorizontalAlignment="Left" Margin="0,0,0,16" Opacity="0.6"/>
                        <Border Background="#334155" CornerRadius="4" Height="12" Margin="0,0,0,10" Opacity="0.5"/>
                        <Border Background="#334155" CornerRadius="4" Height="12" Margin="0,0,0,10" Opacity="0.5"/>
                        <Border Background="#334155" CornerRadius="4" Height="12" Margin="0,0,0,10" Opacity="0.5"/>
                        <Border Background="#334155" CornerRadius="4" Height="12" Width="120" HorizontalAlignment="Left" Opacity="0.5"/>
                    </StackPanel>
                </Border>

                <!-- File Source Skeleton -->
                <Border Background="#0F172A" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#334155" CornerRadius="4" Width="24" Height="24" Opacity="0.5"/>
                        <StackPanel Margin="12,0,0,0">
                            <Border Background="#334155" CornerRadius="4" Width="60" Height="10" Margin="0,0,0,6" Opacity="0.4"/>
                            <Border Background="#334155" CornerRadius="4" Width="200" Height="14" Opacity="0.5"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Payment Info Skeleton -->
                <Border Background="#0F172A" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <Border Background="#334155" CornerRadius="4" Width="140" Height="14" HorizontalAlignment="Left" Margin="0,0,0,16" Opacity="0.6"/>
                        
                        <!-- Loading text -->
                        <TextBlock Text="Đang đọc thông tin từ file Excel..." 
                                   Foreground="#94A3B8" FontSize="13" Margin="0,8,0,16" 
                                   HorizontalAlignment="Center"/>
                        
                        <Border Background="#334155" CornerRadius="4" Width="180" Height="12" HorizontalAlignment="Left" Margin="0,0,0,8" Opacity="0.4"/>
                        <Border Background="#334155" CornerRadius="4" Height="44" Margin="0,0,0,16" Opacity="0.5"/>
                        
                        <Border Background="#334155" CornerRadius="4" Width="120" Height="12" HorizontalAlignment="Left" Margin="0,0,0,8" Opacity="0.4"/>
                        <Border Background="#334155" CornerRadius="4" Height="70" Margin="0,0,0,16" Opacity="0.5"/>
                        
                        <Border Background="#334155" CornerRadius="4" Width="90" Height="12" HorizontalAlignment="Left" Margin="0,0,0,8" Opacity="0.4"/>
                        <Border Background="#334155" CornerRadius="4" Width="150" Height="36" HorizontalAlignment="Left" Opacity="0.5"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Main Content -->
        <ScrollViewer x:Name="ContentPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel>
                <!-- Contract Info Section -->
                <Border Background="#0F172A" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="THÔNG TIN HỢP ĐỒNG" FontSize="12" FontWeight="SemiBold" 
                                   Foreground="#64748B" Margin="0,0,0,12"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Tổng thầu:" 
                                       Foreground="#94A3B8" FontSize="12" Margin="0,0,16,8"/>
                            <TextBlock x:Name="ContractorNameText" Grid.Row="0" Grid.Column="1" 
                                       Foreground="#F1F5F9" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"
                                       TextWrapping="Wrap"/>
                            
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Số hợp đồng:" 
                                       Foreground="#94A3B8" FontSize="12" Margin="0,0,16,8"/>
                            <TextBlock x:Name="ContractNumberText" Grid.Row="1" Grid.Column="1" 
                                       Foreground="#F1F5F9" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Hạng mục:" 
                                       Foreground="#94A3B8" FontSize="12" Margin="0,0,16,8"/>
                            <TextBlock x:Name="ItemNameText" Grid.Row="2" Grid.Column="1" 
                                       Foreground="#F1F5F9" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"
                                       TextWrapping="Wrap"/>
                            
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Ngày ký:" 
                                       Foreground="#94A3B8" FontSize="12" Margin="0,0,16,0"/>
                            <TextBlock x:Name="SignDateText" Grid.Row="3" Grid.Column="1" 
                                       Foreground="#F1F5F9" FontSize="12" FontWeight="SemiBold"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Source File Info -->
                <Border Background="#0F172A" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="FileExcel" Width="24" Height="24" 
                                                  Foreground="#10B981" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="File nguồn" FontSize="11" Foreground="#64748B"/>
                            <TextBlock x:Name="SourceFileText" FontSize="13" Foreground="#F1F5F9" 
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Editable Fields -->
                <Border Background="#0F172A" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="THÔNG TIN THANH TOÁN" FontSize="12" FontWeight="SemiBold" 
                                   Foreground="#64748B" Margin="0,0,0,12"/>

                        <!-- Số tiền thanh toán -->
                        <StackPanel>
                            <TextBlock Text="Số tiền đề nghị thanh toán (VNĐ)" FontSize="12" 
                                       Foreground="#94A3B8" Margin="0,0,0,6"/>
                            <TextBox x:Name="PaymentValueBox" 
                                     Background="#1E293B" Foreground="#F1F5F9" 
                                     BorderBrush="#334155" BorderThickness="1"
                                     Padding="12,10" FontSize="16" FontWeight="Bold"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                            <TextBlock x:Name="PaymentValueNote" FontSize="11" Foreground="#64748B" 
                                       Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Error Panel -->
        <Border x:Name="ErrorPanel" Grid.Row="1" 
                Background="#0F172A" CornerRadius="12" Padding="24" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <materialDesign:PackIcon Kind="AlertCircle" Width="48" Height="48" 
                                          Foreground="#EF4444" HorizontalAlignment="Center"/>
                <TextBlock x:Name="ErrorText" FontSize="14" Foreground="#F1F5F9" 
                           Margin="0,16,0,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="350"/>
                <Button Content="Thử lại" Margin="0,16,0,0" 
                        Background="#3B82F6" Foreground="White" BorderThickness="0"
                        Click="RetryButton_Click" Padding="24,8"/>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1" x:Name="CancelButton" Content="Hủy" 
                    Width="100" Height="40" Margin="0,0,12,0"
                    Background="#475569" Foreground="#F1F5F9" BorderThickness="0"
                    Click="CancelButton_Click" FontSize="13"/>
            <Button Grid.Column="2" x:Name="CreateButton" Content="Tạo công văn" 
                    Width="140" Height="40"
                    Background="#3B82F6" Foreground="White" BorderThickness="0"
                    Click="CreateButton_Click" FontSize="13" IsEnabled="False"/>
        </Grid>
    </Grid>
</Window>
