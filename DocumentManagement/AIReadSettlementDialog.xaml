<Window x:Class="DocumentManagement.AIReadSettlementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Đọc AI Quyết Toán" Height="420" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Window.Resources>
        <Style TargetType="Button" x:Key="DialogButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="MainBorder" CornerRadius="12" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
        </Border.Effect>
        <Grid>
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Robot" Width="24" Height="24" Foreground="{DynamicResource Blueprint.SuccessOutline}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TitleText" Text="Đọc AI Quyết Toán" FontSize="18" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Width="32" Height="32" Background="Transparent" BorderThickness="0" Click="CloseButton_Click" Cursor="Hand">
                        <materialDesign:PackIcon Kind="Close" x:Name="CloseIcon" Width="20" Height="20"/>
                    </Button>
                </Grid>
                
                <!-- Drop Zone -->
                <Border x:Name="DropZone" Grid.Row="1" BorderThickness="2" CornerRadius="12" 
                        Background="Transparent" AllowDrop="True" 
                        DragOver="DropZone_DragOver" DragLeave="DropZone_DragLeave" Drop="DropZone_Drop"
                        Cursor="Hand" PreviewMouseLeftButtonUp="DropZone_Click">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border x:Name="DropZoneIconDefault" Width="56" Height="56" CornerRadius="28" Background="{DynamicResource Blueprint.PrimaryContainer}" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="FilePlusOutline" Width="28" Height="28" Foreground="{DynamicResource Blueprint.Primary}" 
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="DropZoneIconSelected" Width="56" Height="56" CornerRadius="28" Background="{DynamicResource Blueprint.SuccessContainer}" HorizontalAlignment="Center" Visibility="Collapsed">
                            <materialDesign:PackIcon Kind="FileCheck" Width="28" Height="28" Foreground="{DynamicResource Blueprint.SuccessOutline}" 
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="DropZoneTitle" Text="Kéo thả file vào hoặc bấm để chọn" FontSize="14" FontWeight="Medium" 
                                   HorizontalAlignment="Center" Margin="0,12,0,4"/>
                        <TextBlock x:Name="DropZoneSubtitle" Text="Hỗ trợ: .xlsx (file quyết toán)" FontSize="12" 
                                   HorizontalAlignment="Center" Opacity="0.6"/>
                    </StackPanel>
                </Border>
                
                <!-- Read AI Button -->
                <Button x:Name="ReadAIButton" Grid.Row="2" Click="ReadAIButton_Click" 
                        Height="48" Margin="0,16,0,0" BorderThickness="0" Cursor="Hand" 
                        Style="{StaticResource DialogButton}" IsEnabled="False">
                    <Button.Background>
                        <SolidColorBrush Color="#10B981"/>
                    </Button.Background>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Robot" Width="20" Height="20" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Text="Đọc với AI" Foreground="White" FontSize="14" FontWeight="Medium" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                
                <!-- Footer -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button x:Name="CancelButton" Content="Hủy bỏ" Padding="20,12" Height="44" 
                            BorderThickness="1" Click="CloseButton_Click" Cursor="Hand" Style="{StaticResource DialogButton}"/>
                </StackPanel>
            </Grid>
            
            <!-- Loading Overlay -->
            <Border x:Name="LoadingOverlay" Background="{DynamicResource Blueprint.BusyOverlay}" CornerRadius="12" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="Loading" Width="48" Height="48" Foreground="{DynamicResource Blueprint.SuccessOutline}" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <materialDesign:PackIcon.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                        </materialDesign:PackIcon.RenderTransform>
                        <materialDesign:PackIcon.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="SpinnerRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </materialDesign:PackIcon.Triggers>
                    </materialDesign:PackIcon>
                    <TextBlock Text="AI đang đọc file quyết toán..." Foreground="{DynamicResource Blueprint.OnSurface}" FontSize="14" Margin="0,16,0,0" HorizontalAlignment="Center"/>
                    <TextBlock Text="Vui lòng chờ trong giây lát" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                    <Button x:Name="CancelAIButton" Content="Hủy" Click="CancelAI_Click" Background="#EF4444" Foreground="White" 
                            Padding="24,8" Height="36" BorderThickness="0" Cursor="Hand" Margin="0,20,0,0" Style="{StaticResource DialogButton}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
