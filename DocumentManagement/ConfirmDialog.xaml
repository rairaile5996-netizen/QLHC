<Window x:Class="DocumentManagement.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Xác nhận"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        MinWidth="350"
        MaxWidth="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    
    <Window.Resources>
        <Style TargetType="Button" x:Key="DialogButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <!-- Outer border for rounded corners and clipping -->
    <Border x:Name="MainBorder" CornerRadius="16" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.4"/>
        </Border.Effect>
        <Border.OpacityMask>
            <VisualBrush>
                <VisualBrush.Visual>
                    <Border Background="Black" CornerRadius="12"
                            Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}}"
                            Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Border}}"/>
                </VisualBrush.Visual>
            </VisualBrush>
        </Border.OpacityMask>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Header -->
            <Border Grid.Row="0" 
                    Padding="24,24,24,0">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="IconBorder" Width="48" Height="48" CornerRadius="12" Background="#1E293B">
                        <materialDesign:PackIcon Kind="HelpCircle" 
                                                 Width="28" Height="28" 
                                                 Foreground="#3B82F6"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TxtTitle"
                               Text="Xác nhận xóa" 
                               FontSize="18" 
                               FontWeight="ExtraBold"
                               Foreground="White"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            
            <!-- Content -->
            <StackPanel x:Name="ContentPanel" Grid.Row="1" Margin="24,20,24,24">
                <TextBlock x:Name="TxtMessage"
                           Text="Bạn có chắc muốn thực hiện hành động này?"
                           FontSize="14"
                           TextWrapping="Wrap"/>
                
                <TextBlock x:Name="TxtDetail"
                           Margin="0,12,0,0"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>
            </StackPanel>
            
            <!-- Buttons -->
            <Border x:Name="FooterBorder" Grid.Row="2"
                    Padding="24,0,24,24">
                <UniformGrid Rows="1"
                             Columns="2"
                             HorizontalAlignment="Right">
                    <Button x:Name="BtnConfirm"
                            Content="Xác nhận"
                            Background="#2563EB"
                            Foreground="White"
                            Width="104"
                            Height="40"
                            Margin="0,0,8,0"
                            Padding="0"
                            BorderThickness="0"
                            Click="BtnConfirm_Click"
                            Style="{StaticResource DialogButton}"/>
                    
                    <Button x:Name="BtnCancel"
                            Content="Hủy"
                            Background="#475569"
                            Foreground="White"
                            Width="104"
                            Height="40"
                            Margin="8,0,0,0"
                            Padding="0"
                            BorderThickness="0"
                            Click="BtnCancel_Click"
                            Style="{StaticResource DialogButton}"/>
                </UniformGrid>
            </Border>
        </Grid>
    </Border>
</Window>
