<Window x:Class="DocumentManagement.ImportAcceptanceExcelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Height="570"
        Width="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="Button">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Opacity" Value="0.85"/></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="border" Property="Opacity" Value="0.72"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SampleHeaderCellStyle" TargetType="Border">
                <Setter Property="Background" Value="#3B82F6"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="BorderBrush" Value="#2563EB"/>
                <Setter Property="BorderThickness" Value="0,0,1,0"/>
            </Style>
            <Style x:Key="SampleBodyCellStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Blueprint.Surface}"/>
                <Setter Property="Padding" Value="8"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Blueprint.Outline}"/>
                <Setter Property="BorderThickness" Value="0,1,1,0"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="12" Background="{DynamicResource Blueprint.Surface}" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="1">
        <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.3"/></Border.Effect>
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Blueprint.OnSurface}"/>
                <Button HorizontalAlignment="Right" Width="32" Height="32" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="CloseButton_Click">
                    <materialDesign:PackIcon Kind="Close" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" Width="20" Height="20"/>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Button Click="UploadButton_Click" Height="48" Background="#3B82F6" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Margin="16,0">
                            <materialDesign:PackIcon Kind="Upload" Width="20" Height="20" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="Tải file Excel lên" Foreground="White" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Background="{DynamicResource Blueprint.SurfaceContainer}" CornerRadius="8" Padding="16" Margin="0,16,0,0" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="File đã chọn" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Blueprint.OnSurface}"/>
                            <TextBlock x:Name="SelectedFileText" Text="Chưa chọn file Excel" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource Blueprint.SurfaceContainer}" CornerRadius="8" Padding="20" Margin="0,20,0,0" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Hướng dẫn Import" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Blueprint.OnSurface}" Margin="0,0,0,12"/>

                            <StackPanel x:Name="CvxdGuidePanel">
                                <TextBlock Text="Tên sheet phải là CVXD. Mỗi dòng dữ liệu là 1 biên bản CVXD." Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" FontSize="13" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                <Border BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="55"/><ColumnDefinition Width="80"/><ColumnDefinition Width="190"/><ColumnDefinition Width="80"/><ColumnDefinition Width="85"/><ColumnDefinition Width="85"/></Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource SampleHeaderCellStyle}"><TextBlock Text="STT" Foreground="White" FontSize="11" FontWeight="SemiBold"/></Border><Border Grid.Column="1" Style="{StaticResource SampleHeaderCellStyle}"><TextBlock Text="Loại NT" Foreground="White" FontSize="11" FontWeight="SemiBold"/></Border><Border Grid.Column="2" Style="{StaticResource SampleHeaderCellStyle}"><TextBlock Text="Nội dung nghiệm thu" Foreground="White" FontSize="11" FontWeight="SemiBold"/></Border><Border Grid.Column="3" Style="{StaticResource SampleHeaderCellStyle}"><TextBlock Text="Ngày NT" Foreground="White" FontSize="11" FontWeight="SemiBold"/></Border><Border Grid.Column="4" Style="{StaticResource SampleHeaderCellStyle}"><TextBlock Text="Bắt đầu" Foreground="White" FontSize="11" FontWeight="SemiBold"/></Border><Border Grid.Column="5" Background="#3B82F6" Padding="8,6"><TextBlock Text="Kết thúc" Foreground="White" FontSize="11" FontWeight="SemiBold"/></Border>
                                        </Grid>
                                        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="55"/><ColumnDefinition Width="80"/><ColumnDefinition Width="190"/><ColumnDefinition Width="80"/><ColumnDefinition Width="85"/><ColumnDefinition Width="85"/></Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource SampleBodyCellStyle}"><TextBlock Text="1" Foreground="{DynamicResource Blueprint.OnSurface}" FontSize="11"/></Border><Border Grid.Column="1" Style="{StaticResource SampleBodyCellStyle}"><TextBlock Text="CVXD" Foreground="{DynamicResource Blueprint.OnSurface}" FontSize="11"/></Border><Border Grid.Column="2" Style="{StaticResource SampleBodyCellStyle}"><TextBlock Text="Nghiệm thu ống cấp nước" Foreground="{DynamicResource Blueprint.OnSurface}" FontSize="11"/></Border><Border Grid.Column="3" Style="{StaticResource SampleBodyCellStyle}"><TextBlock Text="23/07/2026" Foreground="{DynamicResource Blueprint.OnSurface}" FontSize="11"/></Border><Border Grid.Column="4" Style="{StaticResource SampleBodyCellStyle}"><TextBlock Text="09h00" Foreground="{DynamicResource Blueprint.OnSurface}" FontSize="11"/></Border><Border Grid.Column="5" Background="{DynamicResource Blueprint.Surface}" Padding="8" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="0,1,0,0"><TextBlock Text="10h00" Foreground="{DynamicResource Blueprint.OnSurface}" FontSize="11"/></Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <TextBlock Text="Có thể thêm cột ở bên phải; app sẽ nhận là cột mở rộng của CVXD." Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" FontSize="13" TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel x:Name="VtdvGuidePanel">
                                <TextBlock Text="Mỗi biên bản VTĐV là 1 sheet riêng. Tên sheet phải theo thứ tự: 01, 02, 03, 04..." Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" FontSize="13" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                <Border BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="190"/><ColumnDefinition Width="95"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/><ColumnDefinition Width="105"/></Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource SampleHeaderCellStyle}"><TextBlock Text="STT" Foreground="White" FontSize="11" FontWeight="SemiBold"/></Border><Border Grid.Column="1" Style="{StaticResource SampleHeaderCellStyle}"><TextBlock Text="Tên vật tư/đối tượng" Foreground="White" FontSize="11" FontWeight="SemiBold"/></Border><Border Grid.Column="2" Style="{StaticResource SampleHeaderCellStyle}"><TextBlock Text="Số phiếu xuất" Foreground="White" FontSize="11" FontWeight="SemiBold"/></Border><Border Grid.Column="3" Style="{StaticResource SampleHeaderCellStyle}"><TextBlock Text="Số lượng" Foreground="White" FontSize="11" FontWeight="SemiBold"/></Border><Border Grid.Column="4" Style="{StaticResource SampleHeaderCellStyle}"><TextBlock Text="Đơn vị" Foreground="White" FontSize="11" FontWeight="SemiBold"/></Border><Border Grid.Column="5" Background="#3B82F6" Padding="8,6"><TextBlock Text="Ghi chú" Foreground="White" FontSize="11" FontWeight="SemiBold"/></Border>
                                        </Grid>
                                        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="190"/><ColumnDefinition Width="95"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/><ColumnDefinition Width="105"/></Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource SampleBodyCellStyle}"><TextBlock Text="1" Foreground="{DynamicResource Blueprint.OnSurface}" FontSize="11"/></Border><Border Grid.Column="1" Style="{StaticResource SampleBodyCellStyle}"><TextBlock Text="Ống thép mạ kẽm" Foreground="{DynamicResource Blueprint.OnSurface}" FontSize="11"/></Border><Border Grid.Column="2" Style="{StaticResource SampleBodyCellStyle}"><TextBlock Text="PX-01" Foreground="{DynamicResource Blueprint.OnSurface}" FontSize="11"/></Border><Border Grid.Column="3" Style="{StaticResource SampleBodyCellStyle}"><TextBlock Text="10" Foreground="{DynamicResource Blueprint.OnSurface}" FontSize="11"/></Border><Border Grid.Column="4" Style="{StaticResource SampleBodyCellStyle}"><TextBlock Text="m" Foreground="{DynamicResource Blueprint.OnSurface}" FontSize="11"/></Border><Border Grid.Column="5" Background="{DynamicResource Blueprint.Surface}" Padding="8" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="0,1,0,0"><TextBlock Text="" Foreground="{DynamicResource Blueprint.OnSurface}" FontSize="11"/></Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <TextBlock Text="Chỉ nhập thông tin vật tư. Ngày nghiệm thu, dự án, công trình, hạng mục, nhà thầu và địa điểm lấy từ thông tin đã có trong app." Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" FontSize="13" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                <TextBlock Text="Có thể thêm cột ở bên phải; app sẽ nhận là cột mở rộng của VTĐV." Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" FontSize="13" TextWrapping="Wrap"/>
                            </StackPanel>

                            <Button Click="DownloadTemplateButton_Click" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Cursor="Hand" Margin="0,16,0,0">
                                <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Download" Width="16" Height="16" Foreground="#3B82F6" VerticalAlignment="Center"/><TextBlock x:Name="DownloadTemplateText" Foreground="#3B82F6" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center" TextDecorations="Underline"/></StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" FontSize="13" TextWrapping="Wrap"/>
                <Button Grid.Column="1" Content="Đóng" Width="120" Height="42" Margin="0,0,12,0" Background="{DynamicResource Blueprint.SurfaceContainer}" Foreground="{DynamicResource Blueprint.OnSurface}" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="1" Click="CloseButton_Click"/>
                <Button x:Name="ImportButton" Grid.Column="2" Content="Import" Width="140" Height="42" Background="#3B82F6" Foreground="White" BorderThickness="0" IsEnabled="False" Click="ImportButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
