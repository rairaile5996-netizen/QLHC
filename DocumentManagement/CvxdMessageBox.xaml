<Window x:Class="DocumentManagement.CvxdMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Thông báo" 
        Height="Auto" Width="560"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        Topmost="True"
        SizeToContent="Height">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ModernButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="40"/>
                <Setter Property="MinWidth" Value="132"/>
                <Setter Property="Padding" Value="24,0"/>
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="6,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.9"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Opacity" Value="0.7"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource Blueprint.Surface}" CornerRadius="16" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.4"/>
        </Border.Effect>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Icon & Title -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                <Border x:Name="IconBorder" Width="48" Height="48" CornerRadius="12" Background="{DynamicResource Blueprint.SurfaceBright}">
                    <materialDesign:PackIcon x:Name="MainIcon" x:FieldModifier="public" Kind="Information" Width="28" Height="28" Foreground="{DynamicResource Blueprint.Primary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="TxtTitle" x:FieldModifier="public" Text="Thông báo" FontSize="18" FontWeight="ExtraBold" Foreground="{DynamicResource Blueprint.OnSurface}" VerticalAlignment="Center" Margin="16,0,0,0"/>
            </StackPanel>

            <!-- Keep the message visually light so nested square panels do not dominate the dialog. -->
            <ScrollViewer Grid.Row="1" MaxHeight="430" Margin="0,0,0,24" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                <TextBlock x:Name="TxtMessage" x:FieldModifier="public" Text="..." FontSize="13.5" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" TextWrapping="Wrap" LineHeight="20"/>
            </ScrollViewer>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnYes" x:FieldModifier="public" Content="LƯU LẠI" Click="BtnYes_Click" Background="{DynamicResource Blueprint.Primary}" Foreground="White" Style="{StaticResource ModernButtonStyle}" Visibility="Collapsed"/>
                <Button x:Name="BtnNo" x:FieldModifier="public" Content="KHÔNG LƯU" Click="BtnNo_Click" Background="{DynamicResource Blueprint.Selection}" Foreground="{DynamicResource Blueprint.OnSurface}" Style="{StaticResource ModernButtonStyle}" Visibility="Collapsed"/>
                <Button x:Name="BtnOk" x:FieldModifier="public" Content="ĐÃ HIỂU" Click="BtnOk_Click" Background="{DynamicResource Blueprint.Primary}" Foreground="White" Style="{StaticResource ModernButtonStyle}" Visibility="Collapsed"/>
                <Button x:Name="BtnCancel" x:FieldModifier="public" Content="HỦY" Click="BtnCancel_Click" Background="Transparent" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="1" Style="{StaticResource ModernButtonStyle}" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
