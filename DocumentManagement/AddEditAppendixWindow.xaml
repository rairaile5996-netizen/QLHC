<Window x:Class="DocumentManagement.AddEditAppendixWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Thêm Phụ Lục" Height="520" Width="550"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Border x:Name="MainBorder" CornerRadius="12" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Header -->
            <Grid Grid.Row="0" Margin="24,20,24,0">
                <TextBlock x:Name="TitleText" Text="Thêm Phụ Lục Hợp Đồng" FontSize="18" FontWeight="SemiBold"/>
                <Button HorizontalAlignment="Right" Width="32" Height="32" Background="Transparent" BorderThickness="0" Click="CloseButton_Click" Cursor="Hand">
                    <materialDesign:PackIcon Kind="Close" x:Name="CloseIcon" Width="20" Height="20"/>
                </Button>
            </Grid>
            
            <!-- Tabs -->
            <Border Grid.Row="1" x:Name="TabBorder" Margin="24,16,24,0" CornerRadius="8" Padding="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="TabManual" Grid.Column="0" Content="Thêm thủ công" Height="36" BorderThickness="0" Cursor="Hand" Click="TabManual_Click"/>
                    <Button x:Name="TabAI" Grid.Column="1" Content="Đọc bằng AI" Height="36" BorderThickness="0" Cursor="Hand" Click="TabAI_Click"/>
                </Grid>
            </Border>
            
            <!-- Content -->
            <Grid Grid.Row="2" Margin="24,16,24,0">
                <!-- Manual Content -->
                <StackPanel x:Name="ManualContent" Visibility="Visible">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="LblAppendixNumber" Text="SỐ PHỤ LỤC" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBox x:Name="AppendixNumberBox" Padding="12" FontSize="14" Text="PL 01"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="LblSignDate" Text="NGÀY KÝ" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <DatePicker x:Name="SignDatePicker" FontSize="14" Padding="8,6" Height="42"/>
                        </StackPanel>
                    </Grid>
                    
                    <TextBlock x:Name="LblDesc" Text="MÔ TẢ" FontSize="12" FontWeight="SemiBold" Margin="0,16,0,8"/>
                    <TextBox x:Name="DescriptionBox" Padding="12" FontSize="14"/>
                    
                    <TextBlock x:Name="LblValue" Text="GIÁ TRỊ PHỤ LỤC (VNĐ)" FontSize="12" FontWeight="SemiBold" Margin="0,16,0,8"/>
                    <TextBox x:Name="ValueBox" Padding="12" FontSize="14" HorizontalContentAlignment="Right" Text="0" GotFocus="ValueBox_GotFocus" LostFocus="ValueBox_LostFocus" PreviewTextInput="SignedNumberValidationTextBox"/>
                    
                    <TextBlock x:Name="LblPlannedAdvance" Text="SỐ TIỀN TẠM ỨNG DỰ KIẾN (VNĐ)" FontSize="12" FontWeight="SemiBold" Margin="0,16,0,8"/>
                    <TextBox x:Name="PlannedAdvanceValueBox" Padding="12" FontSize="14" HorizontalContentAlignment="Right" Text="0" GotFocus="ValueBox_GotFocus" LostFocus="ValueBox_LostFocus" PreviewTextInput="SignedNumberValidationTextBox"/>

                    <TextBlock x:Name="LblHint" Text="Nhập số dương để tăng giá trị, số âm để giảm" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
                
                <!-- AI Content -->
                <StackPanel x:Name="AIContent" Visibility="Collapsed">
                    <TextBlock x:Name="LblSelectFile" Text="CHỌN FILE PHỤ LỤC" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Border x:Name="DropZone" BorderThickness="2" BorderBrush="#3B82F6" CornerRadius="8" Padding="24" Background="Transparent" 
                            AllowDrop="True" Drop="DropZone_Drop" DragOver="DropZone_DragOver" Cursor="Hand" PreviewMouseLeftButtonDown="DropZone_Click">
                        <StackPanel HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="FileDocumentPlus" Width="40" Height="40" HorizontalAlignment="Center" Foreground="#3B82F6"/>
                            <TextBlock x:Name="DropZoneText" Text="Kéo thả file vào đây hoặc click để chọn" FontSize="13" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            <TextBlock x:Name="DropZoneHint" Text="Hỗ trợ file Word (.docx) và Excel (.xlsx)" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Selected files list -->
                    <ItemsControl x:Name="FileList" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,4" Padding="8,6" CornerRadius="4" Background="#1E3A5F">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Kind="FileDocument" Width="16" Height="16" Foreground="#3B82F6" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="12" Foreground="#94A3B8" Margin="8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="2" Width="20" Height="20" Padding="0" Background="Transparent" BorderThickness="0" 
                                                Tag="{Binding FilePath}" Click="RemoveFile_Click" Cursor="Hand">
                                            <materialDesign:PackIcon Kind="Close" Width="14" Height="14" Foreground="#EF4444"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    
                    <!-- AI Read Button -->
                    <Button x:Name="BtnReadAI" Background="#F59E0B" Foreground="White" Height="40" Margin="0,12,0,0" 
                            BorderThickness="0" Click="BtnReadAI_Click" Cursor="Hand" IsEnabled="False" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon x:Name="AIIcon" Kind="Robot" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock x:Name="AIButtonText" Text="Đọc với AI" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <TextBlock x:Name="AIStatusText" Text="" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
                
                <!-- Loading Overlay -->
                <Border x:Name="LoadingOverlay" Background="#CC1E293B" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="Loading" Width="48" Height="48" Foreground="#F59E0B" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <materialDesign:PackIcon.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                            </materialDesign:PackIcon.RenderTransform>
                            <materialDesign:PackIcon.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="SpinnerRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </materialDesign:PackIcon.Triggers>
                        </materialDesign:PackIcon>
                        <TextBlock x:Name="LoadingText" Text="AI đang đọc file..." Foreground="#F1F5F9" FontSize="14" Margin="0,16,0,0" HorizontalAlignment="Center"/>
                        <TextBlock Text="Vui lòng chờ trong giây lát" Foreground="#94A3B8" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                        <Button x:Name="CancelAIButton" Content="Hủy" Click="CancelAI_Click" Background="#EF4444" Foreground="White" 
                                Padding="24,8" Height="36" BorderThickness="0" Cursor="Hand" Margin="0,20,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
            
            <!-- Footer -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,16,24,20">
                <Button x:Name="CancelButton" Content="Hủy bỏ" Background="Transparent" Padding="20,12" Height="44" BorderThickness="0" Click="CancelButton_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="SaveButton" Content="Thêm Phụ Lục" Background="#F59E0B" Foreground="White" Padding="24,12" Height="44" MinWidth="140" BorderThickness="0" Click="SaveButton_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
