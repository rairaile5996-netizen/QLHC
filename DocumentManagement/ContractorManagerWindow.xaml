<Window x:Class="DocumentManagement.ContractorManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Quản lý Tổng thầu" Height="700" Width="850"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        
        <!-- Header với thiết kế hiện đại hơn -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="12,12,0,0" Padding="24,20">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Quản lý Tổng thầu" FontSize="20" FontWeight="Bold" Foreground="#F1F5F9"/>
                    <TextBlock Text="Thêm, sửa, xóa thông tin tổng thầu để sử dụng trong công văn" 
                               FontSize="13" Foreground="#94A3B8" Margin="0,4,0,0"/>
                </StackPanel>
                
                <!-- Quick stats -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Style="{StaticResource StatusBadge}" Background="#1E40AF" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Domain" Width="14" Height="14" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TotalContractorsText" Text="0 tổng thầu" Foreground="White" FontSize="11" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Danh sách tổng thầu với search -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="12" Margin="0,0,10,0" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Text="Danh sách tổng thầu" FontWeight="SemiBold" Foreground="#F1F5F9" Margin="0,0,0,12"/>
                    
                    <!-- Search box -->
                    <Border Grid.Row="1" Background="#0F172A" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Magnify" Width="16" Height="16" Foreground="#64748B" VerticalAlignment="Center"/>
                            <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0" 
                                     Foreground="#F1F5F9" FontSize="13" Margin="8,0,0,0"
                                     materialDesign:HintAssist.Hint="Tìm kiếm tổng thầu..."
                                     TextChanged="SearchBox_TextChanged"/>
                        </Grid>
                    </Border>
                    
                    <ListBox x:Name="ContractorList" Grid.Row="2" 
                             Background="Transparent" BorderThickness="0"
                             SelectionChanged="ContractorList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#3B82F6" CornerRadius="6" Width="32" Height="32" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Code, StringFormat='{}{0:1}'}" FontWeight="Bold" Foreground="White" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Code}" FontWeight="Bold" Foreground="#F1F5F9" FontSize="13"/>
                                        <TextBlock Text="{Binding FullName}" FontSize="11" Foreground="#94A3B8" 
                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#F1F5F9"/>
                                <Setter Property="Padding" Value="12,8"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#3B82F6"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#334155"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    
                    <!-- Nút Thêm mới và Xóa với thiết kế đẹp hơn -->
                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="AddNewButton" Grid.Column="0" Height="36"
                                Background="#10B981" Foreground="White" 
                                BorderThickness="0" materialDesign:ButtonAssist.CornerRadius="8"
                                Click="AddNewButton_Click" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="Thêm" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="DeleteButton" Grid.Column="2" Height="36"
                                Background="#EF4444" Foreground="White" 
                                BorderThickness="0" materialDesign:ButtonAssist.CornerRadius="8"
                                Click="DeleteButton_Click" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Delete" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="Xóa" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
            
            <!-- Chi tiết tổng thầu -->
            <Border Grid.Column="1" Background="#1E293B" CornerRadius="12" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DetailPanel">
                        <TextBlock Text="Thông tin chi tiết" FontWeight="SemiBold" Foreground="#F1F5F9" Margin="0,0,0,16"/>
                        
                        <!-- Mã tổng thầu -->
                        <TextBlock Text="Mã tổng thầu *" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <TextBox x:Name="CodeTextBox" Background="#0F172A" Foreground="#F1F5F9" 
                                 BorderBrush="#334155" Padding="10,8" Margin="0,0,0,12"/>
                        
                        <!-- Tên công ty -->
                        <TextBlock Text="Tên công ty đầy đủ *" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <TextBox x:Name="FullNameTextBox" Background="#0F172A" Foreground="#F1F5F9" 
                                 BorderBrush="#334155" Padding="10,8" Margin="0,0,0,12"/>
                        
                        <!-- Giám đốc -->
                        <TextBlock Text="Giám đốc / Người đại diện" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <TextBox x:Name="DirectorTextBox" Background="#0F172A" Foreground="#F1F5F9" 
                                 BorderBrush="#334155" Padding="10,8" Margin="0,0,0,12"/>
                        
                        <!-- Địa chỉ -->
                        <TextBlock Text="Địa chỉ" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <TextBox x:Name="AddressTextBox" Background="#0F172A" Foreground="#F1F5F9" 
                                 BorderBrush="#334155" Padding="10,8" Margin="0,0,0,12"/>
                        
                        <!-- MST -->
                        <TextBlock Text="Mã số thuế" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <TextBox x:Name="TaxCodeTextBox" Background="#0F172A" Foreground="#F1F5F9" 
                                 BorderBrush="#334155" Padding="10,8" Margin="0,0,0,12"/>
                        
                        <!-- SĐT -->
                        <TextBlock Text="Số điện thoại" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <TextBox x:Name="PhoneTextBox" Background="#0F172A" Foreground="#F1F5F9" 
                                 BorderBrush="#334155" Padding="10,8" Margin="0,0,0,12"/>
                        
                        <!-- STK -->
                        <TextBlock Text="Số tài khoản" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <TextBox x:Name="BankAccountTextBox" Background="#0F172A" Foreground="#F1F5F9" 
                                 BorderBrush="#334155" Padding="10,8" Margin="0,0,0,12"/>
                        
                        <!-- Ngân hàng -->
                        <TextBlock Text="Ngân hàng" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <TextBox x:Name="BankNameTextBox" Background="#0F172A" Foreground="#F1F5F9" 
                                 BorderBrush="#334155" Padding="10,8" Margin="0,0,0,12"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        
        <!-- Footer: AI đọc, Lưu, Đóng -->
        <Border Grid.Row="2" Background="#0F172A" Padding="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="AIReadButton" Content="🤖 AI đọc từ HĐ" 
                        Background="#8B5CF6" Foreground="White" 
                        Padding="16,10" Margin="0,0,8,0" Height="40"
                        Click="AIReadButton_Click"
                        Style="{StaticResource MaterialDesignFlatButton}"/>
                <Button x:Name="SaveButton" Content="Lưu" 
                        Background="#3B82F6" Foreground="White" 
                        Padding="20,10" Margin="0,0,8,0" Height="40"
                        Click="SaveButton_Click"
                        Style="{StaticResource MaterialDesignFlatButton}"/>
                <Button Content="Đóng" Background="#334155" Foreground="#F1F5F9" 
                        Padding="20,10" Height="40" Click="CloseButton_Click"
                        Style="{StaticResource MaterialDesignFlatButton}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
