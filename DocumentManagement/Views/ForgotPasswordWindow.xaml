<Window x:Class="DocumentManagement.Views.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Khôi phục mật khẩu" Width="430" Height="430"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Blueprint.Surface}" Foreground="{DynamicResource Blueprint.OnSurface}">
    <Border Margin="16" Padding="24" CornerRadius="12" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="1" Background="{DynamicResource Blueprint.SurfaceBright}">
        <StackPanel>
            <TextBlock Text="Khôi phục mật khẩu" FontSize="22" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock Text="Nhập đúng tên đăng nhập và số điện thoại đã đăng ký." Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" TextWrapping="Wrap" Margin="0,0,0,22"/>

            <TextBlock Text="Tên đăng nhập" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBox x:Name="UsernameBox" Height="38" Padding="10" Margin="0,0,0,14"/>
            <TextBlock Text="Số điện thoại" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBox x:Name="PhoneBox" Height="38" Padding="10" Margin="0,0,0,14"/>
            <TextBlock Text="Mật khẩu mới" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <PasswordBox x:Name="NewPasswordBox" Height="38" Padding="10" Margin="0,0,0,14"/>
            <TextBlock Text="Nhập lại mật khẩu mới" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Height="38" Padding="10" Margin="0,0,0,22"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy" Click="Cancel_Click" Padding="20,9" Margin="0,0,10,0"/>
                <Button Content="Đặt lại mật khẩu" Click="Reset_Click" Padding="20,9" Background="{DynamicResource Blueprint.Primary}" Foreground="{DynamicResource Blueprint.OnPrimary}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
