<Window x:Class="DocumentManagement.Views.ConstructionDirectivesWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
 Title="Quản lý chỉ thị" Width="1240" Height="760" MinWidth="560" MinHeight="400" WindowStartupLocation="CenterScreen" FontFamily="{DynamicResource Blueprint.Font.Body}" FontSize="{DynamicResource Blueprint.FontSize.Body}"
 Background="{DynamicResource Blueprint.Surface}" Foreground="{DynamicResource Blueprint.OnSurface}" AllowDrop="True" PreviewDragOver="Files_DragOver" Drop="Files_Drop" SizeChanged="ConstructionDirectivesWindow_SizeChanged">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Styles/ConstructionDirectivesStyles.xaml"/></ResourceDictionary.MergedDictionaries><BooleanToVisibilityConverter x:Key="BoolToVisibility"/></ResourceDictionary></Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="0,0,0,1" Padding="20,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="Quản lý chỉ thị" FontSize="{DynamicResource Blueprint.FontSize.Body}" FontWeight="Bold" VerticalAlignment="Center"/>
   <Button Grid.Column="1" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="Về chọn phân hệ" Click="Back_Click"><materialDesign:PackIcon Kind="ArrowLeft" Width="21" Height="21"/></Button>
  </Grid></Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="0"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Visibility="Collapsed" Background="{DynamicResource Blueprint.Surface}" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="0,0,1,0" Padding="12,22"><StackPanel>
    <Button Style="{StaticResource DirectiveActiveNavButton}"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Home" Width="23" Height="23"/><TextBlock Text="Chỉ thị" FontSize="{DynamicResource Blueprint.FontSize.Body}" Margin="14,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
   </StackPanel></Border>
   <Grid Grid.Column="1" Margin="24,20,24,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Grid.Column="0" VerticalAlignment="Center"><TextBlock Text="Quản lý chỉ thị" FontFamily="{DynamicResource Blueprint.Font.Header}" FontSize="{DynamicResource Blueprint.FontSize.Display}" FontWeight="Bold"/><TextBlock Text="Lưu trữ và tra cứu nhanh file scan" FontSize="{DynamicResource Blueprint.FontSize.Body}" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" Margin="0,3,0,0"/></StackPanel>
     <Button Grid.Column="2" Style="{StaticResource DirectivePrimaryButton}" Padding="18,0" MinWidth="132" Height="44" Click="Import_Click"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Plus" Width="21" Height="21"/><TextBlock Text="Thêm scan" FontSize="{DynamicResource Blueprint.FontSize.Body}" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
    </Grid>
    <Grid Grid.Row="2" Margin="0,18,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid x:Name="SearchFilterPanel"><Grid.RowDefinitions><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
      <Grid><TextBox x:Name="SearchBox" Style="{StaticResource DirectiveSearchTextBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Tìm số hoặc tên chỉ thị"/><TextBlock Text="Tìm số hoặc tên chỉ thị…" IsHitTestVisible="False" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" FontSize="{DynamicResource Blueprint.FontSize.Body}" VerticalAlignment="Center" Margin="43,0,42,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Text, ElementName=SearchBox}" Value=""/><Condition Binding="{Binding IsKeyboardFocused, ElementName=SearchBox}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><materialDesign:PackIcon Kind="Magnify" Width="24" Height="24" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0"/><Button Style="{StaticResource DirectiveClearSearchButton}" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Xóa bộ lọc" Click="ClearSearch_Click"><materialDesign:PackIcon Kind="Close" Width="19" Height="19"/></Button></Grid>
      <ComboBox x:Name="YearFilter" Style="{StaticResource DirectiveYearFilter}" Grid.Column="1" ItemsSource="{Binding YearOptions}" SelectedItem="{Binding SelectedYear}" Height="48" Margin="14,0,0,0" ToolTip="Lọc theo năm chỉ thị"/>
     </Grid>
     <Grid Grid.Row="2"><DataGrid x:Name="DirectiveGrid" ItemsSource="{Binding Directives}" SelectedItem="{Binding SelectedDirective}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" MouseDoubleClick="Grid_DoubleClick" Background="{DynamicResource Blueprint.SurfaceContainer}" Foreground="{DynamicResource Blueprint.OnSurface}" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="1" HeadersVisibility="Column" GridLinesVisibility="None"><DataGrid.Columns>
       <DataGridTextColumn ElementStyle="{StaticResource DirectiveCellText}" Header="Số chỉ thị" Binding="{Binding Number}" Width="180"/><DataGridTextColumn ElementStyle="{StaticResource DirectiveCellText}" Header="Tên chỉ thị" Binding="{Binding Title}" Width="*"/><DataGridTextColumn ElementStyle="{StaticResource DirectiveCellText}" Header="Ngày nhận" Binding="{Binding ReceivedDate, StringFormat=dd/MM/yyyy}" Width="125"/>
       <DataGridTemplateColumn Width="104"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource DirectiveRowAction}" ToolTip="Mở file scan" Tag="{Binding}" Click="RowOpen_Click"><materialDesign:PackIcon Kind="FolderOpenOutline" Width="21" Height="21"/></Button><Button Style="{StaticResource DirectiveRowAction}" ToolTip="Sửa thông tin" Tag="{Binding}" Click="RowEdit_Click"><materialDesign:PackIcon Kind="PencilOutline" Width="20" Height="20"/></Button></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      </DataGrid.Columns></DataGrid>
      <Border IsHitTestVisible="False" Width="390" Padding="26" CornerRadius="12" Background="{DynamicResource Blueprint.SurfaceBright}" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel HorizontalAlignment="Center"><materialDesign:PackIcon Kind="TrayArrowDown" Width="36" Height="36" Foreground="{DynamicResource Blueprint.Primary}" HorizontalAlignment="Center"/><TextBlock Text="Chưa có chỉ thị" FontWeight="SemiBold" FontSize="{DynamicResource Blueprint.FontSize.Headline}" HorizontalAlignment="Center" Margin="0,10,0,4"/><TextBlock Text="Kéo thả PDF/ảnh vào đây hoặc bấm Thêm scan." TextAlignment="Center" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"/></StackPanel></Border>
     </Grid>
    </Grid>
    <Border Grid.Row="3" Background="{DynamicResource Blueprint.Surface}" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,12,0,0"><Grid x:Name="FooterLayout"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button x:Name="StorageFolderButton" Style="{StaticResource ToolbarButtonStyle}" HorizontalContentAlignment="Stretch" Padding="0" Background="Transparent" BorderThickness="0" ToolTip="Mở thư mục chỉ thị" Click="OpenFolder_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><materialDesign:PackIcon Kind="FolderOutline" Width="25" Height="25" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" x:Name="FooterStoragePath" FontWeight="Normal" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"/></Grid></Button>
     <Button Grid.Column="1" Style="{StaticResource DirectiveFolderButton}" Content="Đổi thư mục" Click="ChooseFolder_Click"/><StackPanel Grid.Column="2" Orientation="Horizontal" Margin="18,0,0,0"><TextBlock Text="{Binding Directives.Count, StringFormat=Đã tìm thấy {0} chỉ thị}" VerticalAlignment="Center" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"/><Button Style="{StaticResource SmallIconButtonStyle}" ToolTip="Quét lại thư mục" Margin="10,0,0,0" Click="Scan_Click"><materialDesign:PackIcon Kind="Refresh" Width="19" Height="19"/></Button></StackPanel></Grid></Border>
   </Grid>
  </Grid>
 </Grid>
</Window>
