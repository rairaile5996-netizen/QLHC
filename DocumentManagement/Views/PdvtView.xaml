<UserControl x:Class="DocumentManagement.Views.PdvtView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:DocumentManagement.Converters"
             xmlns:utilities="clr-namespace:DocumentManagement.Utilities"
             Background="{DynamicResource Blueprint.Surface}"
             FontFamily="{DynamicResource Blueprint.Font.Body}"
             FontSize="13"
             Language="vi-VN"
             Foreground="{DynamicResource Blueprint.OnSurface}">

    <UserControl.InputBindings>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CloseDrawerCommand}"/>
    </UserControl.InputBindings>

    <UserControl.Resources>
        <converters:BindingProxy x:Key="Vm" Data="{Binding}"/>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="NotBoolVis"/>
        <converters:EqualsToBoolConverter x:Key="IsEqual"/>
        <converters:EqualsToVisibilityConverter x:Key="EqVis"/>
        <converters:CountToStarConverter x:Key="Star"/>
        <converters:NotNullToVisibilityConverter x:Key="NotNullVis"/>
        <converters:NullToVisibilityConverter x:Key="NullVis"/>

        <!-- ============================== TEXT ============================== -->
        <Style x:Key="Pdvt.Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurfaceVariant}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Pdvt.Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurfaceVariant}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="Pdvt.SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Blueprint.Font.Header}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ============================== PILLS ============================== -->
        <!-- Tag = kind: draft | sub | fix | ok | no | none -->
        <Style x:Key="Pdvt.Pill" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Blueprint.Outline}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Blueprint.OnSurfaceVariant}"/>
            <Setter Property="TextElement.FontSize" Value="11.5"/>
            <Setter Property="TextElement.FontWeight" Value="Bold"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="draft">
                    <Setter Property="Background" Value="{DynamicResource Blueprint.SurfaceContainerHigh}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Blueprint.SurfaceContainerHigh}"/>
                </Trigger>
                <Trigger Property="Tag" Value="sub">
                    <Setter Property="Background" Value="{DynamicResource Blueprint.PrimaryContainer}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Blueprint.PrimaryContainer}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Blueprint.OnPrimaryContainer}"/>
                </Trigger>
                <Trigger Property="Tag" Value="fix">
                    <Setter Property="Background" Value="{DynamicResource Blueprint.WarningContainer}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Blueprint.WarningContainer}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Blueprint.OnWarningContainer}"/>
                </Trigger>
                <Trigger Property="Tag" Value="ok">
                    <Setter Property="Background" Value="{DynamicResource Blueprint.SuccessContainer}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Blueprint.SuccessContainer}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Blueprint.OnSuccessContainer}"/>
                </Trigger>
                <Trigger Property="Tag" Value="no">
                    <Setter Property="Background" Value="{DynamicResource Blueprint.ErrorContainer}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Blueprint.ErrorContainer}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Blueprint.OnErrorContainer}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Material-row result pill, keyed on PdvtMaterialRow.Status -->
        <Style x:Key="Pdvt.ResultPill" TargetType="Border" BasedOn="{StaticResource Pdvt.Pill}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="DaDuyet">
                    <Setter Property="Background" Value="{DynamicResource Blueprint.SuccessContainer}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Blueprint.SuccessContainer}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Blueprint.OnSuccessContainer}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="YeuCauSua">
                    <Setter Property="Background" Value="{DynamicResource Blueprint.WarningContainer}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Blueprint.WarningContainer}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Blueprint.OnWarningContainer}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="KhongDuyet">
                    <Setter Property="Background" Value="{DynamicResource Blueprint.ErrorContainer}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Blueprint.ErrorContainer}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Blueprint.OnErrorContainer}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Pdvt.DiffTag" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Margin" Value="6,1,0,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Blueprint.Warning}"/>
            <Setter Property="Background" Value="{DynamicResource Blueprint.SurfaceContainer}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Blueprint.OnWarningContainer}"/>
            <Setter Property="TextElement.FontSize" Value="10"/>
            <Setter Property="TextElement.FontWeight" Value="ExtraBold"/>
        </Style>

        <!-- ============================== BUTTONS ============================== -->
        <Style x:Key="Pdvt.Btn" TargetType="Button" BasedOn="{StaticResource SurfaceButtonStyle}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{DynamicResource Blueprint.SurfaceContainer}"/>
        </Style>
        <Style x:Key="Pdvt.BtnPrimary" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="Pdvt.BtnGhost" TargetType="Button" BasedOn="{StaticResource Pdvt.Btn}">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style x:Key="Pdvt.BtnSm" TargetType="Button" BasedOn="{StaticResource Pdvt.Btn}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="Pdvt.BtnSmPrimary" TargetType="Button" BasedOn="{StaticResource Pdvt.BtnPrimary}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="Pdvt.BtnIcon" TargetType="Button" BasedOn="{StaticResource Pdvt.Btn}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style x:Key="Pdvt.BtnOk" TargetType="Button" BasedOn="{StaticResource Pdvt.BtnSm}">
            <Setter Property="Background" Value="{DynamicResource Blueprint.SuccessContainer}"/>
            <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSuccessContainer}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Blueprint.SuccessOutline}"/>
            <Setter Property="utilities:ButtonVisuals.HoverBackground" Value="{DynamicResource Blueprint.SuccessHover}"/>
            <Setter Property="utilities:ButtonVisuals.PressedBackground" Value="{DynamicResource Blueprint.SuccessPressed}"/>
        </Style>
        <Style x:Key="Pdvt.BtnWarn" TargetType="Button" BasedOn="{StaticResource Pdvt.BtnSm}">
            <Setter Property="Background" Value="{DynamicResource Blueprint.WarningContainer}"/>
            <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnWarningContainer}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Blueprint.Warning}"/>
            <Setter Property="utilities:ButtonVisuals.HoverBackground" Value="{DynamicResource Blueprint.WarningContainer}"/>
        </Style>
        <Style x:Key="Pdvt.BtnErr" TargetType="Button" BasedOn="{StaticResource Pdvt.BtnSm}">
            <Setter Property="Background" Value="{DynamicResource Blueprint.ErrorContainer}"/>
            <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnErrorContainer}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Blueprint.Error}"/>
            <Setter Property="utilities:ButtonVisuals.HoverBackground" Value="{DynamicResource Blueprint.DangerHover}"/>
        </Style>

        <!-- Inline link (sheet references) -->
        <Style x:Key="Pdvt.Link" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnPrimaryContainer}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource Blueprint.PrimaryContainer}" CornerRadius="4" Padding="6,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Blueprint.SelectionStrong}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================== TOGGLES ============================== -->
        <!-- Rounded filter chip (record list filters, table filters) -->
        <Style x:Key="Pdvt.Chip" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurfaceVariant}"/>
            <Setter Property="Background" Value="{DynamicResource Blueprint.SurfaceContainer}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Blueprint.Outline}"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="10,4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Blueprint.OnSurfaceVariant}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Blueprint.OnSurface}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Blueprint.OnSurface}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Blueprint.Surface}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Pdvt.ChipRadio" TargetType="RadioButton" BasedOn="{StaticResource Pdvt.Chip}"/>

        <!-- Segmented control item -->
        <Style x:Key="Pdvt.Segment" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurfaceVariant}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Blueprint.SurfaceBright}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurface}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Blueprint.Primary}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Pdvt.SegmentHost" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Blueprint.SurfaceContainer}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Blueprint.Outline}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- KPI tile (summary). Tag = accent brush. -->
        <Style x:Key="Pdvt.Kpi" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Ring" CornerRadius="11" Margin="-2" BorderThickness="2" BorderBrush="Transparent"/>
                            <Border x:Name="Bd" Background="{DynamicResource Blueprint.SurfaceContainer}" BorderBrush="{DynamicResource Blueprint.Outline}"
                                    BorderThickness="1" CornerRadius="10" Padding="16,10,14,10" ClipToBounds="True">
                                <ContentPresenter/>
                            </Border>
                            <Border Width="4" HorizontalAlignment="Left" CornerRadius="10,0,0,10" Background="{TemplateBinding Tag}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Blueprint.SurfaceBright}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Blueprint.Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Pdvt.CheckBox" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="18" Height="18" Background="Transparent">
                            <Border x:Name="Box" CornerRadius="4" BorderThickness="1.5"
                                    BorderBrush="{DynamicResource Blueprint.OnSurfaceVariant}" Background="{DynamicResource Blueprint.SurfaceContainer}"/>
                            <Path x:Name="Mark" Data="M 4,9.5 L 7.5,13 L 14,5.5" Stroke="{DynamicResource Blueprint.OnPrimary}" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                            <Rectangle x:Name="Dash" Width="9" Height="2.2" RadiusX="1" RadiusY="1" Fill="{DynamicResource Blueprint.OnPrimary}" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Blueprint.Primary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Blueprint.Primary}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Blueprint.Primary}"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Blueprint.Primary}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Blueprint.Primary}"/>
                                <Setter TargetName="Dash" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================== INPUTS ============================== -->
        <!-- Form field: Tag = placeholder -->
        <Style x:Key="Pdvt.Field" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurface}"/>
            <Setter Property="Background" Value="{DynamicResource Blueprint.SurfaceContainer}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Blueprint.Outline}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Blueprint.Primary}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="10,0">
                            <Grid>
                                <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" Opacity="0.75"
                                           VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"/>
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Blueprint.OnSurfaceVariant}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Blueprint.Primary}"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Blueprint.SurfaceBright}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Blueprint.Outline}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurfaceVariant}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Search box: Field with a magnifier -->
        <Style x:Key="Pdvt.Search" TargetType="TextBox" BasedOn="{StaticResource Pdvt.Field}">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="10,0">
                            <DockPanel>
                                <materialDesign:PackIcon Kind="Magnify" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"
                                                         Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"/>
                                <Grid>
                                    <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" Opacity="0.75"
                                               VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"/>
                                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False"
                                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                                </Grid>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Blueprint.OnSurfaceVariant}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Blueprint.Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- In-table text: looks like plain text, outlines on hover, editable with one click. Tag = placeholder. -->
        <Style x:Key="Pdvt.CellBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurface}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Blueprint.Primary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="False"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5" Padding="4,2">
                            <Grid>
                                <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" Opacity="0.7"
                                           FontStyle="Italic" Visibility="Collapsed" IsHitTestVisible="False" TextWrapping="Wrap"/>
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsReadOnly" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Blueprint.Outline}"/>
                            </MultiTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Blueprint.Primary}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Blueprint.SurfaceContainer}"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter Property="Cursor" Value="Arrow"/>
                                <Setter TargetName="Hint" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Popup list shared by the in-table combo boxes -->
        <Style x:Key="Pdvt.ComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurface}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Blueprint.Selection}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Blueprint.Primary}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Editable brand picker: free text plus the contract alternatives -->
        <Style x:Key="Pdvt.CellCombo" TargetType="ComboBox">
            <Setter Property="IsEditable" Value="True"/>
            <Setter Property="IsTextSearchEnabled" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurface}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource Pdvt.ComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5"/>
                            <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" Margin="4,2,20,2" Padding="0"
                                     Background="Transparent" BorderThickness="0" TextWrapping="Wrap"
                                     Foreground="{TemplateBinding Foreground}" CaretBrush="{DynamicResource Blueprint.Primary}"
                                     FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                                     IsReadOnly="{TemplateBinding IsReadOnly}" VerticalAlignment="Center"/>
                            <ToggleButton x:Name="Toggle" Style="{x:Null}" Width="20" HorizontalAlignment="Right" Focusable="False" Cursor="Hand"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <Path Data="M 0 0 L 4 4 L 8 0 Z" Width="8" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Fill="{DynamicResource Blueprint.OnSurfaceVariant}"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Background="{DynamicResource Blueprint.SurfaceContainer}" BorderBrush="{DynamicResource Blueprint.Outline}"
                                        BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,2,0,0">
                                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Toggle" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Margin" Value="4,2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Blueprint.Outline}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Blueprint.Primary}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Blueprint.SurfaceContainer}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Result picker drawn as a coloured pill -->
        <Style x:Key="Pdvt.StatusCombo" TargetType="ComboBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource Pdvt.ComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Style="{x:Null}" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <Border Style="{StaticResource Pdvt.ResultPill}" Padding="9,3">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding StatusLabel}"/>
                                        <Path Data="M 0 0 L 4 4 L 8 0 Z" Width="8" Height="4" Margin="6,1,0,0" VerticalAlignment="Center"
                                              Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}"/>
                                    </StackPanel>
                                </Border>
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="{DynamicResource Blueprint.SurfaceContainer}" BorderBrush="{DynamicResource Blueprint.Outline}"
                                        BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,2,0,0" MinWidth="160">
                                    <ItemsPresenter/>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================== TABLES ============================== -->
        <Style x:Key="Pdvt.Header" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="{DynamicResource Blueprint.SurfaceContainerHigh}"/>
            <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurfaceVariant}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Blueprint.Outline}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Pdvt.Cell" TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurface}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="8,7" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Top"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Implicit copies: MaterialDesign's app-level cell/header styles otherwise win over DataGrid.CellStyle (16px padding, sort-arrow column). -->
        <Style TargetType="DataGridCell" BasedOn="{StaticResource Pdvt.Cell}"/>
        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource Pdvt.Header}"/>

        <Style x:Key="Pdvt.Grid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <!-- Cells host their own editors; read-only avoids DataGrid edit transactions blocking view refresh. -->
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Blueprint.Outline}"/>
            <Setter Property="Background" Value="{DynamicResource Blueprint.SurfaceContainer}"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Blueprint.Outline}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurface}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource Pdvt.Header}"/>
            <Setter Property="CellStyle" Value="{StaticResource Pdvt.Cell}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
        </Style>

        <Style x:Key="Pdvt.MaterialRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Blueprint.SurfaceBright}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsChecked}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Blueprint.Selection}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Pdvt.BoqRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Blueprint.SurfaceBright}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Blueprint.Selection}"/>
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Blueprint.Selection}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsHeading}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Blueprint.SurfaceBright}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsTopHeading}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Blueprint.SurfaceContainerHigh}"/>
                    <Setter Property="FontWeight" Value="ExtraBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsInDraft}" Value="True">
                    <Setter Property="Opacity" Value="0.5"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Sheet list card -->
        <Style x:Key="Pdvt.Card" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{DynamicResource Blueprint.SurfaceContainer}" BorderBrush="{DynamicResource Blueprint.Outline}"
                                BorderThickness="1" CornerRadius="10" Padding="12,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Blueprint.OnSurfaceVariant}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Blueprint.Primary}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Blueprint.Selection}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Pdvt.Panel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Blueprint.SurfaceContainer}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Blueprint.Outline}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <Style x:Key="Pdvt.Dot" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Header of the BoQ checkbox column -->
        <DataTemplate x:Key="Pdvt.BoqCheckCell">
            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <CheckBox.Style>
                    <Style TargetType="CheckBox" BasedOn="{StaticResource Pdvt.CheckBox}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsInDraft}" Value="True">
                                <Setter Property="Visibility" Value="Hidden"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </CheckBox.Style>
            </CheckBox>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================================================================= -->
        <!-- HEADER                                                            -->
        <!-- ================================================================= -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="0,0,0,1" Padding="24,12">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock Text="Phê duyệt vật tư" FontFamily="{DynamicResource Blueprint.Font.Header}" FontSize="18" FontWeight="ExtraBold"/>
                    <TextBlock Text="{Binding ContractLabel}" Style="{StaticResource Pdvt.Muted}"/>
                </StackPanel>

                <Border DockPanel.Dock="Left" Style="{StaticResource Pdvt.SegmentHost}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Pdvt.Segment}" Padding="14,7" GroupName="PdvtView"
                                     Command="{Binding ShowRecordsCommand}"
                                     IsChecked="{Binding IsSummaryView, Mode=OneWay, Converter={StaticResource IsEqual}, ConverterParameter=False}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileDocumentMultipleOutline" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Phiếu PDVT" FontSize="12.5"/>
                                <TextBlock Text="{Binding CountAllRecords}" FontSize="12.5" Margin="6,0,0,0" Opacity="0.75"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Pdvt.Segment}" Padding="14,7" Margin="2,0,0,0" GroupName="PdvtView"
                                     Command="{Binding ShowSummaryCommand}"
                                     IsChecked="{Binding IsSummaryView, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TableCheck" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Tổng hợp BoQ" FontSize="12.5"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ImportBoqCommand}" Style="{StaticResource Pdvt.BtnGhost}" Margin="0,0,8,0"
                            ToolTip="Đọc danh mục vật tư từ file BoQ hợp đồng">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileImportOutline" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Nạp BoQ Excel"/>
                        </StackPanel>
                    </Button>
                    <!-- Records view -->
                    <Button Command="{Binding NewCommand}" Style="{StaticResource Pdvt.BtnPrimary}"
                            Visibility="{Binding IsSummaryView, Converter={StaticResource NotBoolVis}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Phiếu mới"/>
                        </StackPanel>
                    </Button>
                    <!-- Summary view -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsSummaryView, Converter={StaticResource BoolVis}}">
                        <Button Command="{Binding ExportSummaryCommand}" Style="{StaticResource Pdvt.Btn}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileExcelOutline" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"
                                                         Foreground="{DynamicResource Blueprint.SuccessOutline}"/>
                                <TextBlock Text="Xuất bảng tổng hợp"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding NewFromSelectedCommand}" Style="{StaticResource Pdvt.BtnPrimary}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Lập phiếu từ dòng chọn"/>
                                <TextBlock Margin="4,0,0,0" Visibility="{Binding SelectedBoqCount, Converter={StaticResource EqVis}, ConverterParameter=!0}">
                                    <Run Text="("/><Run Text="{Binding SelectedBoqCount, Mode=OneWay}"/><Run Text=")"/>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================================================================= -->
        <!-- VIEW A/B: SHEETS                                                  -->
        <!-- ================================================================= -->
        <Grid Grid.Row="1" Visibility="{Binding IsSummaryView, Converter={StaticResource NotBoolVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" MinWidth="240" MaxWidth="480"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sheet list -->
            <Border Grid.Column="0" Background="{DynamicResource Blueprint.SurfaceBright}" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="0,0,1,0">
                <DockPanel Margin="14,16,14,0">
                    <TextBox DockPanel.Dock="Top" Style="{StaticResource Pdvt.Search}" Tag="Tìm số phiếu, vật tư, nhà cung cấp…"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <RadioButton Style="{StaticResource Pdvt.ChipRadio}" GroupName="RecordFilter"
                                     IsChecked="{Binding RecordFilter, Converter={StaticResource IsEqual}, ConverterParameter=all}">
                            <TextBlock><Run Text="Tất cả "/><Run Text="{Binding CountAllRecords, Mode=OneWay}" FontWeight="Bold"/></TextBlock>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Pdvt.ChipRadio}" GroupName="RecordFilter"
                                     IsChecked="{Binding RecordFilter, Converter={StaticResource IsEqual}, ConverterParameter=draft}">
                            <TextBlock><Run Text="Nháp "/><Run Text="{Binding CountDraftRecords, Mode=OneWay}" FontWeight="Bold"/></TextBlock>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Pdvt.ChipRadio}" GroupName="RecordFilter"
                                     IsChecked="{Binding RecordFilter, Converter={StaticResource IsEqual}, ConverterParameter=sub}">
                            <TextBlock><Run Text="Đã trình "/><Run Text="{Binding CountSubmittedRecords, Mode=OneWay}" FontWeight="Bold"/></TextBlock>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Pdvt.ChipRadio}" GroupName="RecordFilter"
                                     IsChecked="{Binding RecordFilter, Converter={StaticResource IsEqual}, ConverterParameter=fix}">
                            <TextBlock><Run Text="Cần trình lại "/><Run Text="{Binding CountReworkRecords, Mode=OneWay}" FontWeight="Bold"/></TextBlock>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Pdvt.ChipRadio}" GroupName="RecordFilter"
                                     IsChecked="{Binding RecordFilter, Converter={StaticResource IsEqual}, ConverterParameter=ok}">
                            <TextBlock><Run Text="Đã duyệt "/><Run Text="{Binding CountApprovedRecords, Mode=OneWay}" FontWeight="Bold"/></TextBlock>
                        </RadioButton>
                    </WrapPanel>

                    <Grid>
                        <ListBox ItemsSource="{Binding Records}" SelectedItem="{Binding SelectedRecord, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 ItemContainerStyle="{StaticResource Pdvt.Card}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Style="{StaticResource Pdvt.Pill}" Tag="{Binding StatusKind}">
                                                <TextBlock Text="{Binding StatusLabel}"/>
                                            </Border>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Number}" FontSize="14" FontWeight="ExtraBold" VerticalAlignment="Center"/>
                                                <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="5" BorderThickness="1" VerticalAlignment="Center"
                                                        BorderBrush="{DynamicResource Blueprint.Outline}" Background="{DynamicResource Blueprint.SurfaceContainer}"
                                                        Visibility="{Binding RoundLabel, Converter={StaticResource EqVis}, ConverterParameter=!}">
                                                    <TextBlock Text="{Binding RoundLabel}" FontSize="11" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"/>
                                                </Border>
                                            </StackPanel>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Pdvt.Muted}" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                                        <Border Height="5" CornerRadius="3" Margin="0,7,0,0" Background="{DynamicResource Blueprint.SurfaceContainerHigh}"
                                                Visibility="{Binding IsSubmitted, Converter={StaticResource BoolVis}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding ApprovedCount, Converter={StaticResource Star}}"/>
                                                    <ColumnDefinition Width="{Binding ReworkCount, Converter={StaticResource Star}}"/>
                                                    <ColumnDefinition Width="{Binding RejectedCount, Converter={StaticResource Star}}"/>
                                                    <ColumnDefinition Width="{Binding PendingCount, Converter={StaticResource Star}}"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="{DynamicResource Status.Completed}" CornerRadius="3,0,0,3"/>
                                                <Border Grid.Column="1" Background="{DynamicResource Status.Pending}"/>
                                                <Border Grid.Column="2" Background="{DynamicResource Status.Error}"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Pdvt.Muted}" FontSize="11.5" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel VerticalAlignment="Top" Margin="0,40,0,0" HorizontalAlignment="Center"
                                    Visibility="{Binding Records.Count, Converter={StaticResource EqVis}, ConverterParameter=0}">
                            <materialDesign:PackIcon Kind="FileDocumentOutline" Width="36" Height="36" HorizontalAlignment="Center"
                                                     Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"/>
                            <TextBlock Text="Không có phiếu nào" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,2"/>
                            <TextBlock Text="Đổi bộ lọc hoặc tạo phiếu mới." Style="{StaticResource Pdvt.Muted}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="0" Width="5" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE"/>

            <!-- Editor -->
            <Grid Grid.Column="1" Margin="20,16,20,16" Visibility="{Binding HasDraft, Converter={StaticResource BoolVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top card -->
                <Border Grid.Row="0" Style="{StaticResource Pdvt.Panel}" Padding="18,14" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DraftNumber}" FontFamily="{DynamicResource Blueprint.Font.Header}" FontSize="20" FontWeight="ExtraBold" VerticalAlignment="Center"/>
                                <Border Margin="10,0,0,0" Padding="8,2" CornerRadius="6" BorderThickness="1" VerticalAlignment="Center"
                                        BorderBrush="{DynamicResource Blueprint.Outline}" Background="{DynamicResource Blueprint.Surface}"
                                        Visibility="{Binding IsLocked, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="{Binding RoundLabel}" FontSize="12" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"/>
                                </Border>
                                <Border Margin="10,0,0,0" Style="{StaticResource Pdvt.Pill}" Tag="{Binding DraftStatusKind}">
                                    <TextBlock Text="{Binding DraftStatusLabel}"/>
                                </Border>
                                <TextBlock Text="• Chưa lưu" Margin="10,0,0,0" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Blueprint.Warning}"
                                           Visibility="{Binding IsDirty, Converter={StaticResource BoolVis}}"/>
                            </StackPanel>

                            <!-- Stepper: shrinks instead of pushing the action buttons out on narrow windows -->
                            <Viewbox Grid.Column="1" StretchDirection="DownOnly" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,18,0">
                                <ItemsControl ItemsSource="{Binding Steps}" VerticalAlignment="Center" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" ToolTip="{Binding Label}">
                                                <Grid Width="20" Height="20" VerticalAlignment="Center">
                                                    <Ellipse x:Name="Circle" StrokeThickness="2" Stroke="{DynamicResource Blueprint.Outline}" Fill="{DynamicResource Blueprint.SurfaceContainer}"/>
                                                    <TextBlock x:Name="Num" Text="{Binding Number}" FontSize="11" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"/>
                                                    <materialDesign:PackIcon x:Name="Tick" Kind="Check" Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                             Foreground="{DynamicResource Blueprint.OnPrimary}" Visibility="Collapsed"/>
                                                </Grid>
                                                <TextBlock x:Name="Label" Text="{Binding Label}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"
                                                           Visibility="{Binding ShowLabel, Converter={StaticResource BoolVis}}"/>
                                                <Rectangle x:Name="Line" Width="22" Height="2" Margin="6,0" VerticalAlignment="Center" Fill="{DynamicResource Blueprint.Outline}"/>
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="done">
                                                    <Setter TargetName="Circle" Property="Fill" Value="{DynamicResource Blueprint.Primary}"/>
                                                    <Setter TargetName="Circle" Property="Stroke" Value="{DynamicResource Blueprint.Primary}"/>
                                                    <Setter TargetName="Num" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="Line" Property="Fill" Value="{DynamicResource Blueprint.Primary}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="cur">
                                                    <Setter TargetName="Circle" Property="Stroke" Value="{DynamicResource Blueprint.Primary}"/>
                                                    <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource Blueprint.Primary}"/>
                                                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Blueprint.OnSurface}"/>
                                                    <Setter TargetName="Label" Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                    <Setter TargetName="Line" Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Viewbox>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Draft actions -->
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsLocked, Converter={StaticResource NotBoolVis}}">
                                    <Button Command="{Binding SaveCommand}" Style="{StaticResource Pdvt.Btn}" Margin="0,0,8,0" ToolTip="Lưu phiếu và cập nhật file Excel (Ctrl+S)">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ContentSaveOutline" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Lưu"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding SubmitCommand}" Style="{StaticResource Pdvt.BtnPrimary}" Margin="0,0,8,0"
                                            ToolTip="Đánh dấu phiếu đã gửi TVGS; nội dung sẽ được khóa">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Send" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Trình duyệt"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- Submitted actions -->
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsLocked, Converter={StaticResource BoolVis}}">
                                    <Button Command="{Binding OpenExcelFileCommand}" Style="{StaticResource Pdvt.Btn}" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FileExcelOutline" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                     Foreground="{DynamicResource Blueprint.SuccessOutline}"/>
                                            <TextBlock Text="Xuất Excel"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding SaveCommand}" Margin="0,0,8,0" ToolTip="Ghi lại kết quả duyệt (Ctrl+S)">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource Pdvt.BtnPrimary}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanResubmit}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Blueprint.SurfaceContainer}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurface}"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Blueprint.Outline}"/>
                                                        <Setter Property="utilities:ButtonVisuals.HoverBackground" Value="{DynamicResource Blueprint.ButtonHover}"/>
                                                        <Setter Property="utilities:ButtonVisuals.PressedBackground" Value="{DynamicResource Blueprint.ButtonPressed}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Check" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Lưu kết quả"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding ResubmitCommand}" Style="{StaticResource Pdvt.BtnPrimary}" Margin="0,0,8,0"
                                            Visibility="{Binding CanResubmit, Converter={StaticResource BoolVis}}"
                                            ToolTip="Tạo phiếu lần trình tiếp theo với các vật tư chưa được duyệt">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Send" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ResubmitLabel}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <Button x:Name="MoreButton" Style="{StaticResource Pdvt.BtnIcon}" Click="MoreButton_Click" ToolTip="Thao tác khác">
                                    <materialDesign:PackIcon Kind="DotsHorizontal" Width="18" Height="18"/>
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Lưu và mở file Excel" Command="{Binding ExportExcelCommand}"
                                                      Visibility="{Binding IsLocked, Converter={StaticResource NotBoolVis}}"/>
                                            <MenuItem Header="Đưa về Nháp (hủy trình)" Command="{Binding UnsubmitCommand}"
                                                      Visibility="{Binding IsLocked, Converter={StaticResource BoolVis}}"/>
                                            <MenuItem Header="Đóng phiếu" Command="{Binding CloseEditorCommand}"/>
                                            <Separator/>
                                            <MenuItem Header="Xóa phiếu" Command="{Binding DeleteRecordCommand}" Foreground="{DynamicResource Blueprint.Danger}"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Fields -->
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Draft: number / Submitted: created date -->
                            <StackPanel Grid.Column="0" Margin="0,0,14,0" Visibility="{Binding IsLocked, Converter={StaticResource NotBoolVis}}">
                                <TextBlock Text="SỐ PHIẾU" Style="{StaticResource Pdvt.Label}"/>
                                <TextBox Style="{StaticResource Pdvt.Field}" Text="{Binding DraftNumber, UpdateSourceTrigger=PropertyChanged}"
                                         Foreground="{DynamicResource Blueprint.Primary}" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="0" Margin="0,0,14,0" Visibility="{Binding IsLocked, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="NGÀY LẬP" Style="{StaticResource Pdvt.Label}"/>
                                <TextBox Style="{StaticResource Pdvt.Field}" IsReadOnly="True" Text="{Binding DraftDate, Mode=OneWay, StringFormat=dd/MM/yyyy}"/>
                            </StackPanel>

                            <!-- Draft: created date / Submitted: submitted date -->
                            <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Pdvt.Label}">
                                            <Setter Property="Text" Value="NGÀY LẬP"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                    <Setter Property="Text" Value="NGÀY TRÌNH"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border Height="34" CornerRadius="8" BorderThickness="1" Padding="10,0"
                                        Background="{DynamicResource Blueprint.SurfaceContainer}" BorderBrush="{DynamicResource Blueprint.Outline}">
                                    <Grid>
                                        <DatePicker SelectedDate="{Binding DraftDate}" FontSize="13" VerticalAlignment="Center"
                                                    Foreground="{DynamicResource Blueprint.OnSurface}" BorderThickness="0" Background="Transparent"
                                                    materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                                                    Visibility="{Binding IsLocked, Converter={StaticResource NotBoolVis}}"/>
                                        <DatePicker SelectedDate="{Binding DraftSubmittedDate}" FontSize="13" VerticalAlignment="Center"
                                                    Foreground="{DynamicResource Blueprint.OnSurface}" BorderThickness="0" Background="Transparent"
                                                    materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                                                    Visibility="{Binding IsLocked, Converter={StaticResource BoolVis}}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,14,0">
                                <TextBlock Text="HẠNG MỤC" Style="{StaticResource Pdvt.Label}"/>
                                <TextBox Style="{StaticResource Pdvt.Field}" Tag="Ví dụ: Hệ thống điện, Cấp thoát nước…"
                                         Text="{Binding DraftCategory, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsLocked}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="NHÀ CUNG CẤP / NHÀ THẦU" Style="{StaticResource Pdvt.Label}"/>
                                <TextBox Style="{StaticResource Pdvt.Field}" Tag="Tên nhà cung cấp…"
                                         Text="{Binding DraftSupplier, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsLocked}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Summary line -->
                        <Border BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,10,0,0">
                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" TextElement.FontSize="12.5">
                                    <TextBlock VerticalAlignment="Center" Margin="0,0,20,0">
                                        <Run Text="{Binding DraftTotal, Mode=OneWay}" FontWeight="ExtraBold" FontSize="14"/><Run Text=" vật tư" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"/>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsLocked, Converter={StaticResource BoolVis}}">
                                        <Ellipse Style="{StaticResource Pdvt.Dot}" Fill="{DynamicResource Status.Completed}"/>
                                        <TextBlock VerticalAlignment="Center" Margin="0,0,20,0">
                                            <Run Text="{Binding DraftApproved, Mode=OneWay}" FontWeight="ExtraBold" FontSize="14"/><Run Text=" đã duyệt" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"/>
                                        </TextBlock>
                                        <Ellipse Style="{StaticResource Pdvt.Dot}" Fill="{DynamicResource Status.Pending}"/>
                                        <TextBlock VerticalAlignment="Center" Margin="0,0,20,0">
                                            <Run Text="{Binding DraftRework, Mode=OneWay}" FontWeight="ExtraBold" FontSize="14"/><Run Text=" yêu cầu sửa" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"/>
                                        </TextBlock>
                                        <Ellipse Style="{StaticResource Pdvt.Dot}" Fill="{DynamicResource Status.Error}"/>
                                        <TextBlock VerticalAlignment="Center" Margin="0,0,20,0">
                                            <Run Text="{Binding DraftRejected, Mode=OneWay}" FontWeight="ExtraBold" FontSize="14"/><Run Text=" không duyệt" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"/>
                                        </TextBlock>
                                        <Ellipse Style="{StaticResource Pdvt.Dot}" Fill="Transparent" Stroke="{DynamicResource Blueprint.OnSurfaceVariant}" StrokeThickness="1"/>
                                        <TextBlock VerticalAlignment="Center">
                                            <Run Text="{Binding DraftPending, Mode=OneWay}" FontWeight="ExtraBold" FontSize="14"/><Run Text=" chưa có kết quả" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                            Visibility="{Binding DiffCount, Converter={StaticResource EqVis}, ConverterParameter=!0}">
                                    <materialDesign:PackIcon Kind="AlertOutline" Width="16" Height="16" Margin="0,0,5,0" VerticalAlignment="Center"
                                                             Foreground="{DynamicResource Blueprint.Warning}"/>
                                    <TextBlock VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource Blueprint.OnWarningContainer}">
                                        <Run Text="{Binding DiffCount, Mode=OneWay}" FontWeight="ExtraBold"/><Run Text=" dòng khác hợp đồng"/>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Materials card -->
                <Border Grid.Row="1" Style="{StaticResource Pdvt.Panel}" Padding="14,12,14,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Toolbar -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False" MinHeight="32">
                            <TextBlock DockPanel.Dock="Left" Text="Vật tư đệ trình" Style="{StaticResource Pdvt.SectionTitle}" FontSize="14" Margin="0,0,14,0"/>

                            <!-- Bulk results (submitted) -->
                            <Border DockPanel.Dock="Left" CornerRadius="8" Padding="10,3,4,3" BorderThickness="1" VerticalAlignment="Center"
                                    Background="{DynamicResource Blueprint.Selection}" BorderBrush="{DynamicResource Blueprint.SelectionStrong}"
                                    Visibility="{Binding ShowBulkBar, Converter={StaticResource BoolVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Blueprint.OnPrimaryContainer}" Margin="0,0,8,0">
                                        <Run Text="Đã chọn "/><Run Text="{Binding CheckedCount, Mode=OneWay}"/>
                                    </TextBlock>
                                    <Button Command="{Binding BulkApproveCommand}" Style="{StaticResource Pdvt.BtnOk}" Content="Duyệt" Margin="0,0,6,0"/>
                                    <Button Command="{Binding BulkReworkCommand}" Style="{StaticResource Pdvt.BtnWarn}" Content="Yêu cầu sửa" Margin="0,0,6,0"/>
                                    <Button Command="{Binding BulkRejectCommand}" Style="{StaticResource Pdvt.BtnErr}" Content="Không duyệt" Margin="0,0,6,0"/>
                                    <Button Command="{Binding BulkClearCommand}" Style="{StaticResource Pdvt.BtnSm}" Content="Xóa kết quả" Background="Transparent"/>
                                </StackPanel>
                            </Border>
                            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Style="{StaticResource Pdvt.Muted}"
                                       Text="Tích chọn dòng để ghi kết quả hàng loạt, hoặc bấm vào ô Kết quả của từng dòng."
                                       Visibility="{Binding ShowBulkHint, Converter={StaticResource BoolVis}}"/>

                            <!-- Right side -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <ToggleButton Style="{StaticResource Pdvt.Chip}" Margin="0,0,6,0" IsChecked="{Binding ShowOnlyDiff}"
                                              Visibility="{Binding DiffCount, Converter={StaticResource EqVis}, ConverterParameter=!0}">
                                    <TextBlock><Run Text="Chỉ dòng khác HĐ "/><Run Text="{Binding DiffCount, Mode=OneWay}" FontWeight="Bold"/></TextBlock>
                                </ToggleButton>
                                <ToggleButton Style="{StaticResource Pdvt.Chip}" Margin="0,0,6,0" IsChecked="{Binding ShowOnlyPending}"
                                              Visibility="{Binding IsLocked, Converter={StaticResource BoolVis}}">
                                    <TextBlock><Run Text="Chưa có kết quả "/><Run Text="{Binding DraftPending, Mode=OneWay}" FontWeight="Bold"/></TextBlock>
                                </ToggleButton>
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsLocked, Converter={StaticResource NotBoolVis}}">
                                    <Button Command="{Binding PickFromBoqCommand}" Style="{StaticResource Pdvt.BtnSmPrimary}" Margin="6,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="PlaylistPlus" Width="16" Height="16" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Chọn từ BoQ"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding AddExtraCommand}" Style="{StaticResource Pdvt.BtnSm}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Plus" Width="15" Height="15" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Vật tư phát sinh"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>

                        <!-- Materials table -->
                        <DataGrid Grid.Row="1" x:Name="MaterialsGrid" ItemsSource="{Binding DraftMaterials}"
                                  Style="{StaticResource Pdvt.Grid}" RowStyle="{StaticResource Pdvt.MaterialRow}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="38" MinWidth="38" Visibility="{Binding Data.IsLocked, Source={StaticResource Vm}, Converter={StaticResource BoolVis}}">
                                    <DataGridTemplateColumn.Header>
                                        <CheckBox Style="{StaticResource Pdvt.CheckBox}" IsThreeState="False" Margin="0" VerticalAlignment="Center"
                                                  IsChecked="{Binding Data.AllChecked, Source={StaticResource Vm}, Mode=TwoWay}" ToolTip="Chọn tất cả dòng đang hiển thị"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox Style="{StaticResource Pdvt.CheckBox}" IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="STT" Width="50" MinWidth="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Stt}" Margin="0,2,0,0" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Vật tư · thông số kỹ thuật" Width="2.3*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBox Style="{StaticResource Pdvt.CellBox}" FontWeight="Bold" Tag="Tên vật tư…" Margin="-5,-3,0,0"
                                                         Text="{Binding NoiDung, UpdateSourceTrigger=PropertyChanged}"
                                                         IsReadOnly="{Binding Data.IsLocked, Source={StaticResource Vm}}"/>
                                                <DockPanel Margin="-5,0,0,0">
                                                    <Border DockPanel.Dock="Right" Style="{StaticResource Pdvt.DiffTag}" BorderBrush="{DynamicResource Blueprint.Outline}"
                                                            TextElement.Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" TextElement.FontWeight="Bold"
                                                            Visibility="{Binding IsExtra, Converter={StaticResource BoolVis}}">
                                                        <TextBlock Text="Phát sinh"/>
                                                    </Border>
                                                    <TextBox Style="{StaticResource Pdvt.CellBox}" FontSize="11.5" Tag="Thông số kỹ thuật…"
                                                             Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"
                                                             Text="{Binding ThongSoKyThuat, UpdateSourceTrigger=PropertyChanged}"
                                                             IsReadOnly="{Binding Data.IsLocked, Source={StaticResource Vm}}"/>
                                                </DockPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="1.35*">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock><Run Text="Nhãn hiệu "/><Run Text="HĐ → Đệ trình" FontWeight="Normal"/></TextBlock>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,2">
                                                    <Border x:Name="Tag" DockPanel.Dock="Right" Style="{StaticResource Pdvt.DiffTag}" Margin="6,0,0,0" Visibility="Collapsed">
                                                        <TextBlock Text="KHÁC HĐ"/>
                                                    </Border>
                                                    <TextBlock x:Name="Hd" Text="{Binding NhanHieuTheoHd}" FontSize="11.5" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"/>
                                                </DockPanel>
                                                <Border x:Name="Hl" CornerRadius="4" Margin="-5,0,0,0" Background="Transparent">
                                                    <Grid>
                                                        <ComboBox Style="{StaticResource Pdvt.CellCombo}" ItemsSource="{Binding NhanHieuOptions}"
                                                                  Text="{Binding NhanHieuPheDuyet, UpdateSourceTrigger=PropertyChanged}"
                                                                  Visibility="{Binding Data.IsLocked, Source={StaticResource Vm}, Converter={StaticResource NotBoolVis}}"/>
                                                        <TextBlock Text="{Binding NhanHieuPheDuyet}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="5,2"
                                                                   Visibility="{Binding Data.IsLocked, Source={StaticResource Vm}, Converter={StaticResource BoolVis}}"/>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsBrandDiff}" Value="True">
                                                    <Setter TargetName="Hl" Property="Background" Value="{DynamicResource Blueprint.WarningContainer}"/>
                                                    <Setter TargetName="Tag" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsExtra}" Value="True">
                                                    <Setter TargetName="Hd" Property="Text" Value="—"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="1*">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock><Run Text="Xuất xứ "/><Run Text="HĐ → Đệ trình" FontWeight="Normal"/></TextBlock>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock x:Name="Hd" Text="{Binding XuatXuTheoHd}" FontSize="11.5" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" Margin="0,0,0,2"/>
                                                <Border x:Name="Hl" CornerRadius="4" Margin="-5,0,0,0" Background="Transparent">
                                                    <TextBox Style="{StaticResource Pdvt.CellBox}" FontWeight="SemiBold" Tag="Xuất xứ…"
                                                             Text="{Binding XuatXuDeTrinh, UpdateSourceTrigger=PropertyChanged}"
                                                             IsReadOnly="{Binding Data.IsLocked, Source={StaticResource Vm}}"/>
                                                </Border>
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsOriginDiff}" Value="True">
                                                    <Setter TargetName="Hl" Property="Background" Value="{DynamicResource Blueprint.WarningContainer}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding XuatXuTheoHd}" Value="">
                                                    <Setter TargetName="Hd" Property="Text" Value="—"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="ĐVT" Width="66" MinWidth="66">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Style="{StaticResource Pdvt.CellBox}" Margin="-5,-3,0,0" TextWrapping="NoWrap" Text="{Binding DonViTinh, UpdateSourceTrigger=PropertyChanged}"
                                                     IsReadOnly="{Binding Data.IsLocked, Source={StaticResource Vm}}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="110" MinWidth="110">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="Khối lượng" HorizontalAlignment="Right"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Style="{StaticResource Pdvt.CellBox}" Margin="0,-3,-5,0" TextAlignment="Right" TextWrapping="NoWrap"
                                                     Text="{Binding KhoiLuong, StringFormat=N2, ConverterCulture=vi-VN, UpdateSourceTrigger=LostFocus}"
                                                     IsReadOnly="{Binding Data.IsLocked, Source={StaticResource Vm}}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Kết quả" Width="132" MinWidth="132" Visibility="{Binding Data.IsLocked, Source={StaticResource Vm}, Converter={StaticResource BoolVis}}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox Style="{StaticResource Pdvt.StatusCombo}"
                                                      ItemsSource="{Binding Data.ApprovalOptions, Source={StaticResource Vm}}"
                                                      SelectedValuePath="Value" DisplayMemberPath="DisplayText"
                                                      SelectedValue="{Binding Status, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="1.25*" Visibility="{Binding Data.IsLocked, Source={StaticResource Vm}, Converter={StaticResource BoolVis}}">
                                    <DataGridTemplateColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Ghi chú TVGS"/>
                                            <materialDesign:PackIcon Kind="PencilOutline" Width="13" Height="13" Margin="5,0,0,0" VerticalAlignment="Center"
                                                                     Foreground="{DynamicResource Blueprint.Primary}"/>
                                        </StackPanel>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox x:Name="Note" Style="{StaticResource Pdvt.CellBox}" Margin="-5,-3,0,0" Tag="Nhập ý kiến TVGS…"
                                                     Text="{Binding ReviewNote, UpdateSourceTrigger=PropertyChanged}"/>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="YeuCauSua">
                                                    <Setter TargetName="Note" Property="Foreground" Value="{DynamicResource Blueprint.OnWarningContainer}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="KhongDuyet">
                                                    <Setter TargetName="Note" Property="Foreground" Value="{DynamicResource Blueprint.Error}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="1*" Visibility="{Binding Data.IsLocked, Source={StaticResource Vm}, Converter={StaticResource NotBoolVis}}">
                                    <DataGridTemplateColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Ghi chú"/>
                                            <materialDesign:PackIcon Kind="PencilOutline" Width="13" Height="13" Margin="5,0,0,0" VerticalAlignment="Center"
                                                                     Foreground="{DynamicResource Blueprint.Primary}"/>
                                        </StackPanel>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Style="{StaticResource Pdvt.CellBox}" Margin="-5,-3,0,0" Tag="Ghi chú trong phiếu…"
                                                     Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="44" MinWidth="44" Visibility="{Binding Data.IsLocked, Source={StaticResource Vm}, Converter={StaticResource NotBoolVis}}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding Data.RemoveMaterialCommand, Source={StaticResource Vm}}" CommandParameter="{Binding}"
                                                    Style="{StaticResource DangerIconButtonStyle}" Width="28" Height="28" Margin="0,-3,0,0"
                                                    Background="Transparent" ToolTip="Xóa dòng này">
                                                <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Empty materials -->
                        <Border Grid.Row="1" Margin="1,42,1,1" Background="{DynamicResource Blueprint.SurfaceContainer}"
                                Visibility="{Binding DraftMaterials.Count, Converter={StaticResource EqVis}, ConverterParameter=0}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="PackageVariantClosedPlus" Width="40" Height="40" HorizontalAlignment="Center"
                                                         Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"/>
                                <TextBlock Text="Phiếu chưa có vật tư" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Margin="0,8,0,4"/>
                                <TextBlock Text="Chọn vật tư từ BoQ hợp đồng, hoặc thêm vật tư phát sinh ngoài BoQ." Style="{StaticResource Pdvt.Muted}" HorizontalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                                    <Button Command="{Binding PickFromBoqCommand}" Style="{StaticResource Pdvt.BtnPrimary}" Content="Chọn từ BoQ" Margin="0,0,8,0"/>
                                    <Button Command="{Binding AddExtraCommand}" Style="{StaticResource Pdvt.Btn}" Content="Vật tư phát sinh"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- No sheet open -->
            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding HasDraft, Converter={StaticResource NotBoolVis}}">
                <materialDesign:PackIcon Kind="ClipboardCheckOutline" Width="52" Height="52" HorizontalAlignment="Center"
                                         Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"/>
                <TextBlock Text="Chưa mở phiếu nào" FontSize="16" FontWeight="ExtraBold" HorizontalAlignment="Center" Margin="0,10,0,4"/>
                <TextBlock Text="Chọn một phiếu ở danh sách bên trái, hoặc tạo phiếu mới từ BoQ hợp đồng." Style="{StaticResource Pdvt.Muted}" FontSize="13" HorizontalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <Button Command="{Binding NewCommand}" Style="{StaticResource Pdvt.BtnPrimary}" Content="Phiếu mới" Margin="0,0,8,0"/>
                    <Button Command="{Binding ShowSummaryCommand}" Style="{StaticResource Pdvt.Btn}" Content="Xem tổng hợp BoQ"/>
                </StackPanel>
            </StackPanel>

            <!-- BoQ drawer (screen B) -->
            <Grid Grid.Column="0" Grid.ColumnSpan="2" Visibility="{Binding IsBoqDrawerOpen, Converter={StaticResource BoolVis}}">
                <Border Background="{DynamicResource Blueprint.OnSurface}" Opacity="0.14">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding CloseDrawerCommand}"/>
                    </Border.InputBindings>
                </Border>
                <Border Width="660" HorizontalAlignment="Right" Background="{DynamicResource Blueprint.SurfaceContainer}"
                        BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="1,0,0,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.18"/>
                    </Border.Effect>
                    <DockPanel>
                        <!-- Drawer header -->
                        <Border DockPanel.Dock="Top" Padding="18,14,18,12" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Command="{Binding CloseDrawerCommand}" Style="{StaticResource Pdvt.BtnIcon}" Width="30" Height="30"
                                            Background="Transparent" ToolTip="Đóng (Esc)">
                                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16"/>
                                    </Button>
                                    <TextBlock Text="Chọn vật tư từ BoQ" Style="{StaticResource Pdvt.SectionTitle}" FontSize="16"/>
                                    <TextBlock Style="{StaticResource Pdvt.Muted}" FontSize="12.5" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <Run Text="→ thêm vào"/> <Run Text="{Binding DraftNumber, Mode=OneWay}" FontWeight="Bold"/>
                                    </TextBlock>
                                </DockPanel>
                                <DockPanel Margin="0,12,0,0">
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Pdvt.SegmentHost}" Margin="10,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Pdvt.Segment}" GroupName="DrawerFilter"
                                                         IsChecked="{Binding BoqFilter, Converter={StaticResource IsEqual}, ConverterParameter=unassigned}">
                                                <TextBlock><Run Text="Chưa lập "/><Run Text="{Binding KpiUnassigned, Mode=OneWay}"/></TextBlock>
                                            </RadioButton>
                                            <RadioButton Style="{StaticResource Pdvt.Segment}" GroupName="DrawerFilter" Content="Tất cả" Margin="2,0"
                                                         IsChecked="{Binding BoqFilter, Converter={StaticResource IsEqual}, ConverterParameter=all}"/>
                                            <RadioButton Style="{StaticResource Pdvt.Segment}" GroupName="DrawerFilter" Content="Đã lập"
                                                         IsChecked="{Binding BoqFilter, Converter={StaticResource IsEqual}, ConverterParameter=assigned}"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBox Style="{StaticResource Pdvt.Search}" Tag="Tìm tên, thông số, nhãn hiệu…"
                                             Text="{Binding BoqSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- Drawer footer -->
                        <Border DockPanel.Dock="Bottom" Padding="18,12" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="0,1,0,0"
                                Background="{DynamicResource Blueprint.SurfaceBright}">
                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock FontWeight="Bold">
                                        <Run Text="Đã chọn"/> <Run Text="{Binding SelectedBoqCount, Mode=OneWay}" Foreground="{DynamicResource Blueprint.Primary}"/> <Run Text="vật tư"/>
                                    </TextBlock>
                                    <TextBlock Text="Thông số, nhãn hiệu, xuất xứ lấy theo hợp đồng" Style="{StaticResource Pdvt.Muted}" FontSize="11.5"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Command="{Binding ClearBoqSelectionActionCommand}" Style="{StaticResource Pdvt.Btn}" Content="Bỏ chọn" Margin="0,0,8,0"/>
                                    <Button Command="{Binding AddSelectedBoqCommand}" Style="{StaticResource Pdvt.BtnPrimary}">
                                        <TextBlock>
                                            <Run Text="Thêm"/> <Run Text="{Binding SelectedBoqCount, Mode=OneWay}"/> <Run Text="vào"/> <Run Text="{Binding DraftNumber, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Drawer list -->
                        <Grid>
                            <DataGrid ItemsSource="{Binding DrawerBoqItems}" Style="{StaticResource Pdvt.Grid}" RowStyle="{StaticResource Pdvt.BoqRow}"
                                      HeadersVisibility="None" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="40" MinWidth="40" CellTemplate="{StaticResource Pdvt.BoqCheckCell}"/>
                                    <DataGridTemplateColumn Width="64" MinWidth="64">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding SttBoq}" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" TextWrapping="Wrap"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding NoiDung}" TextWrapping="Wrap"/>
                                                    <WrapPanel x:Name="Meta" Margin="0,2,0,0">
                                                        <TextBlock x:Name="Spec" Text="{Binding SpecLine}" Style="{StaticResource Pdvt.Muted}" FontSize="11.5" FontWeight="Normal" Margin="0,0,6,0"/>
                                                        <Button x:Name="Link" Style="{StaticResource Pdvt.Link}" FontSize="11" Content="{Binding PdvtNumbers}"
                                                                Command="{Binding Data.OpenRecordByIdCommand, Source={StaticResource Vm}}" CommandParameter="{Binding LatestRecordId}"
                                                                ToolTip="Mở phiếu đã lập"
                                                                Visibility="{Binding PdvtNumbers, Converter={StaticResource EqVis}, ConverterParameter=!}"/>
                                                    </WrapPanel>
                                                </StackPanel>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsHeading}" Value="True">
                                                        <Setter TargetName="Meta" Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsInDraft}" Value="True">
                                                        <Setter TargetName="Spec" Property="Text" Value="Đã có trong phiếu này"/>
                                                        <Setter TargetName="Link" Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="56" MinWidth="56">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DonViTinh}" TextWrapping="Wrap"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="84" MinWidth="84">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock x:Name="Kl" Text="{Binding KhoiLuong, StringFormat=N2, ConverterCulture=vi-VN}" TextAlignment="Right"/>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsHeading}" Value="True">
                                                        <Setter TargetName="Kl" Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding DrawerBoqItems.Count, Converter={StaticResource EqVis}, ConverterParameter=0}">
                                <materialDesign:PackIcon Kind="TableSearch" Width="40" Height="40" HorizontalAlignment="Center"
                                                         Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"/>
                                <TextBlock Text="Không có vật tư phù hợp" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,4"/>
                                <TextBlock Text="Đổi bộ lọc, hoặc nạp BoQ Excel nếu hợp đồng chưa có BoQ." Style="{StaticResource Pdvt.Muted}" HorizontalAlignment="Center"/>
                                <Button Command="{Binding ImportBoqCommand}" Style="{StaticResource Pdvt.Btn}" Content="Nạp BoQ Excel" HorizontalAlignment="Center" Margin="0,12,0,0"
                                        Visibility="{Binding HasBoq, Converter={StaticResource NotBoolVis}}"/>
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ================================================================= -->
        <!-- VIEW C: BOQ SUMMARY                                               -->
        <!-- ================================================================= -->
        <Grid Grid.Row="1" Visibility="{Binding IsSummaryView, Converter={StaticResource BoolVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="20,16,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- KPI tiles -->
                <UniformGrid Grid.Row="0" Rows="1" Columns="5" Margin="0,0,-12,0">
                    <RadioButton Style="{StaticResource Pdvt.Kpi}" GroupName="SummaryFilter" Tag="{DynamicResource Blueprint.OnSurfaceVariant}"
                                 IsChecked="{Binding SummaryFilter, Converter={StaticResource IsEqual}, ConverterParameter=unassigned}">
                        <StackPanel>
                            <TextBlock Text="{Binding KpiUnassigned}" FontSize="22" FontWeight="ExtraBold"/>
                            <TextBlock Text="Chưa lập phiếu" Style="{StaticResource Pdvt.Muted}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Pdvt.Kpi}" GroupName="SummaryFilter" Tag="{DynamicResource Status.InProgress}"
                                 IsChecked="{Binding SummaryFilter, Converter={StaticResource IsEqual}, ConverterParameter=pending}">
                        <StackPanel>
                            <TextBlock Text="{Binding KpiPending}" FontSize="22" FontWeight="ExtraBold"/>
                            <TextBlock Text="Đang lập / chờ kết quả" Style="{StaticResource Pdvt.Muted}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Pdvt.Kpi}" GroupName="SummaryFilter" Tag="{DynamicResource Status.Pending}"
                                 IsChecked="{Binding SummaryFilter, Converter={StaticResource IsEqual}, ConverterParameter=rework}">
                        <StackPanel>
                            <TextBlock Text="{Binding KpiRework}" FontSize="22" FontWeight="ExtraBold" Foreground="{DynamicResource Status.Pending}"/>
                            <TextBlock Text="Cần trình lại (sửa / không duyệt)" Style="{StaticResource Pdvt.Muted}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Pdvt.Kpi}" GroupName="SummaryFilter" Tag="{DynamicResource Status.Completed}"
                                 IsChecked="{Binding SummaryFilter, Converter={StaticResource IsEqual}, ConverterParameter=approved}">
                        <StackPanel>
                            <TextBlock Text="{Binding KpiApproved}" FontSize="22" FontWeight="ExtraBold" Foreground="{DynamicResource Status.Completed}"/>
                            <TextBlock Style="{StaticResource Pdvt.Muted}"><Run Text="Đã duyệt · "/><Run Text="{Binding ApprovedPercent, Mode=OneWay}"/><Run Text="%"/></TextBlock>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Pdvt.Kpi}" GroupName="SummaryFilter" Tag="{DynamicResource Blueprint.OnSurface}"
                                 IsChecked="{Binding SummaryFilter, Converter={StaticResource IsEqual}, ConverterParameter=all}">
                        <StackPanel>
                            <TextBlock Text="{Binding KpiTotal}" FontSize="22" FontWeight="ExtraBold"/>
                            <TextBlock Text="Tổng vật tư BoQ" Style="{StaticResource Pdvt.Muted}"/>
                        </StackPanel>
                    </RadioButton>
                </UniformGrid>

                <!-- Overall progress -->
                <Border Grid.Row="1" Height="10" CornerRadius="5" Margin="0,12,0,12" Background="{DynamicResource Blueprint.SurfaceContainerHigh}" ClipToBounds="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding KpiApproved, Converter={StaticResource Star}}"/>
                            <ColumnDefinition Width="{Binding KpiPending, Converter={StaticResource Star}}"/>
                            <ColumnDefinition Width="{Binding KpiRework, Converter={StaticResource Star}}"/>
                            <ColumnDefinition Width="{Binding KpiUnassigned, Converter={StaticResource Star}}"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource Status.Completed}" CornerRadius="5,0,0,5"/>
                        <Border Grid.Column="1" Background="{DynamicResource Status.InProgress}"/>
                        <Border Grid.Column="2" Background="{DynamicResource Status.Pending}"/>
                    </Grid>
                </Border>

                <!-- Table card -->
                <Border Grid.Row="2" Style="{StaticResource Pdvt.Panel}" Padding="14,12,14,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                            <TextBox DockPanel.Dock="Left" Width="270" Style="{StaticResource Pdvt.Search}" Tag="Tìm vật tư, nhãn hiệu, số phiếu…"
                                     Text="{Binding SummarySearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                            <Border DockPanel.Dock="Left" Style="{StaticResource Pdvt.SegmentHost}" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Pdvt.Segment}" GroupName="SummarySeg" Content="Tất cả"
                                                 IsChecked="{Binding SummaryFilter, Converter={StaticResource IsEqual}, ConverterParameter=all}"/>
                                    <RadioButton Style="{StaticResource Pdvt.Segment}" GroupName="SummarySeg" Content="Chưa lập" Margin="2,0,0,0"
                                                 IsChecked="{Binding SummaryFilter, Converter={StaticResource IsEqual}, ConverterParameter=unassigned}"/>
                                    <RadioButton Style="{StaticResource Pdvt.Segment}" GroupName="SummarySeg" Content="Chờ KQ" Margin="2,0,0,0"
                                                 IsChecked="{Binding SummaryFilter, Converter={StaticResource IsEqual}, ConverterParameter=pending}"/>
                                    <RadioButton Style="{StaticResource Pdvt.Segment}" GroupName="SummarySeg" Content="Cần trình lại" Margin="2,0,0,0"
                                                 IsChecked="{Binding SummaryFilter, Converter={StaticResource IsEqual}, ConverterParameter=rework}"/>
                                    <RadioButton Style="{StaticResource Pdvt.Segment}" GroupName="SummarySeg" Content="Đã duyệt" Margin="2,0,0,0"
                                                 IsChecked="{Binding SummaryFilter, Converter={StaticResource IsEqual}, ConverterParameter=approved}"/>
                                </StackPanel>
                            </Border>
                            <ComboBox DockPanel.Dock="Left" Width="230" Height="34" Padding="10,0" FontSize="12.5" VerticalContentAlignment="Center" ItemsSource="{Binding SummaryCategories}" SelectedItem="{Binding SummaryCategory}"
                                      Style="{StaticResource ModernComboBox}" VerticalAlignment="Center" ToolTip="Lọc theo hạng mục (đầu mục cấp 1 của BoQ)"/>
                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Pdvt.Chip}" Margin="0" VerticalAlignment="Center"
                                          IsChecked="{Binding CollapseHeadings}" ToolTip="Chỉ hiện các đầu mục kèm tiến độ">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ArrowCollapseVertical" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Thu gọn đầu mục"/>
                                </StackPanel>
                            </ToggleButton>
                        </DockPanel>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding SummaryItems}" SelectedItem="{Binding SelectedSummaryItem, Mode=TwoWay}"
                                  Style="{StaticResource Pdvt.Grid}" RowStyle="{StaticResource Pdvt.BoqRow}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="38" MinWidth="38" CellTemplate="{StaticResource Pdvt.BoqCheckCell}"/>
                                <DataGridTemplateColumn Header="STT" Width="74" MinWidth="74">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SttBoq}" TextWrapping="Wrap" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Vật tư · thông số theo HĐ" Width="2.4*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding NoiDung}" TextWrapping="Wrap"/>
                                                <TextBlock x:Name="Spec" Text="{Binding ThongSoKyThuat}" Style="{StaticResource Pdvt.Muted}" FontSize="11.5" FontWeight="Normal" Margin="0,2,0,0"/>
                                                <!-- Heading progress -->
                                                <StackPanel x:Name="Progress" Orientation="Horizontal" Margin="0,4,0,0" Visibility="Collapsed">
                                                    <Border Width="90" Height="6" CornerRadius="3" VerticalAlignment="Center" ClipToBounds="True"
                                                            Background="{DynamicResource Blueprint.Outline}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="{Binding ChildApproved, Converter={StaticResource Star}}"/>
                                                                <ColumnDefinition Width="{Binding ChildPending, Converter={StaticResource Star}}"/>
                                                                <ColumnDefinition Width="{Binding ChildRework, Converter={StaticResource Star}}"/>
                                                                <ColumnDefinition Width="{Binding ChildUnassigned, Converter={StaticResource Star}}"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Background="{DynamicResource Status.Completed}"/>
                                                            <Border Grid.Column="1" Background="{DynamicResource Status.InProgress}"/>
                                                            <Border Grid.Column="2" Background="{DynamicResource Status.Pending}"/>
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock FontSize="11.5" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource Blueprint.OnSurfaceVariant}">
                                                        <Run Text="{Binding ChildApproved, Mode=OneWay}"/><Run Text="/"/><Run Text="{Binding ChildTotal, Mode=OneWay}"/><Run Text=" đã duyệt"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsHeading}" Value="True">
                                                    <Setter TargetName="Spec" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="Progress" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ThongSoKyThuat}" Value="">
                                                    <Setter TargetName="Spec" Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Nhãn hiệu · xuất xứ HĐ" Width="1.2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding BrandOriginDisplay}" TextWrapping="Wrap" FontWeight="Normal"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Được duyệt" Width="1.2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel x:Name="Approved">
                                                <TextBlock Text="{Binding ApprovedBrand}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding ApprovedOrigin}" Style="{StaticResource Pdvt.Muted}" FontSize="11.5" FontWeight="Normal"/>
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding ApprovedBrand}" Value="">
                                                    <Setter TargetName="Approved" Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Trạng thái" Width="124" MinWidth="124">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Pill" Style="{StaticResource Pdvt.Pill}" Tag="{Binding StatusKind}" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding StatusLabel}" FontWeight="Bold"/>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsHeading}" Value="True">
                                                    <Setter TargetName="Pill" Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Phiếu · lần" Width="150" MinWidth="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource Pdvt.Link}" Content="{Binding LatestReference}"
                                                    Command="{Binding Data.OpenRecordByIdCommand, Source={StaticResource Vm}}" CommandParameter="{Binding LatestRecordId}"
                                                    ToolTip="Mở phiếu"
                                                    Visibility="{Binding LatestReference, Converter={StaticResource EqVis}, ConverterParameter=!}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Ngày duyệt" Width="104" MinWidth="104">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ApprovedDate, StringFormat=dd/MM/yyyy}" FontWeight="Normal"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding SummaryItems.Count, Converter={StaticResource EqVis}, ConverterParameter=0}">
                            <materialDesign:PackIcon Kind="FileExcelOutline" Width="44" Height="44" HorizontalAlignment="Center"
                                                     Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"/>
                            <TextBlock FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Margin="0,8,0,4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Không có vật tư phù hợp bộ lọc"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasBoq}" Value="False">
                                                <Setter Property="Text" Value="Hợp đồng chưa có BoQ"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Nạp file BoQ Excel của hợp đồng để theo dõi phê duyệt từng vật tư." Style="{StaticResource Pdvt.Muted}" HorizontalAlignment="Center"
                                       Visibility="{Binding HasBoq, Converter={StaticResource NotBoolVis}}"/>
                            <Button Command="{Binding ImportBoqCommand}" Style="{StaticResource Pdvt.BtnPrimary}" Content="Nạp BoQ Excel" HorizontalAlignment="Center" Margin="0,12,0,0"
                                    Visibility="{Binding HasBoq, Converter={StaticResource NotBoolVis}}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Detail panel -->
            <Border Grid.Column="1" Background="{DynamicResource Blueprint.SurfaceBright}" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="1,0,0,0">
                <Grid Margin="18,16">
                    <!-- Nothing / heading selected -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSummaryItem}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedSummaryItem.IsHeading}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <materialDesign:PackIcon Kind="TimelineTextOutline" Width="40" Height="40" HorizontalAlignment="Center"
                                                 Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"/>
                        <TextBlock Text="Chọn một vật tư" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,4"/>
                        <TextBlock Text="để xem chi tiết và lịch sử các lần trình duyệt." Style="{StaticResource Pdvt.Muted}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <DockPanel DataContext="{Binding SelectedSummaryItem}">
                        <DockPanel.Style>
                            <Style TargetType="DockPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsHeading}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Style>

                        <!-- Actions -->
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                            <Button Style="{StaticResource Pdvt.Btn}" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                    Command="{Binding Data.OpenRecordByIdCommand, Source={StaticResource Vm}}" CommandParameter="{Binding LatestRecordId}"
                                    Visibility="{Binding LatestRecordId, Converter={StaticResource EqVis}, ConverterParameter=!}">
                                <TextBlock><Run Text="Mở"/> <Run Text="{Binding LatestReference, Mode=OneWay}"/></TextBlock>
                            </Button>
                            <Button Style="{StaticResource Pdvt.BtnPrimary}" HorizontalAlignment="Stretch"
                                    Command="{Binding Data.ResubmitItemCommand, Source={StaticResource Vm}}" CommandParameter="{Binding}"
                                    Visibility="{Binding Progress, Converter={StaticResource EqVis}, ConverterParameter=CanTrinhLai}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Send" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Trình lại (tạo lần mới)"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Pdvt.BtnPrimary}" HorizontalAlignment="Stretch"
                                    Command="{Binding Data.CreateFromItemCommand, Source={StaticResource Vm}}" CommandParameter="{Binding}"
                                    Visibility="{Binding Progress, Converter={StaticResource EqVis}, ConverterParameter=ChuaLap}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Lập phiếu cho vật tư này"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="CHI TIẾT VẬT TƯ" Style="{StaticResource Pdvt.Label}"/>
                                <TextBlock Text="{Binding NoiDung}" FontFamily="{DynamicResource Blueprint.Font.Header}" FontSize="15" FontWeight="ExtraBold"
                                           TextWrapping="Wrap" Margin="0,2,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Margin" Value="0,0,0,8"/>
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                            <Setter Property="FontSize" Value="12.5"/>
                                        </Style>
                                    </Grid.Resources>
                                    <TextBlock Grid.Row="0" Text="STT BoQ" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SttBoq}"/>
                                    <TextBlock Grid.Row="1" Text="Thông số HĐ" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ThongSoKyThuat}"/>
                                    <TextBlock Grid.Row="2" Text="Nhãn hiệu HĐ" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BrandOriginDisplay}"/>
                                    <TextBlock Grid.Row="3" Text="ĐVT · KL" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1">
                                        <Run Text="{Binding DonViTinh, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding KhoiLuong, Mode=OneWay, StringFormat=N2, ConverterCulture=vi-VN}"/>
                                    </TextBlock>
                                    <TextBlock Grid.Row="4" Text="Được duyệt" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"
                                               Visibility="{Binding ApprovedBrand, Converter={StaticResource EqVis}, ConverterParameter=!}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" FontWeight="SemiBold"
                                               Visibility="{Binding ApprovedBrand, Converter={StaticResource EqVis}, ConverterParameter=!}">
                                        <Run Text="{Binding ApprovedBrand, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding ApprovedOrigin, Mode=OneWay}" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"/>
                                    </TextBlock>
                                    <TextBlock Grid.Row="5" Text="Trạng thái" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"/>
                                    <Border Grid.Row="5" Grid.Column="1" Style="{StaticResource Pdvt.Pill}" Tag="{Binding StatusKind}" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding StatusLabel}" Margin="0"/>
                                    </Border>
                                </Grid>

                                <TextBlock Text="LỊCH SỬ TRÌNH DUYỆT" Style="{StaticResource Pdvt.Label}" Margin="0,14,0,10"/>
                                <TextBlock Text="Vật tư chưa nằm trong phiếu PDVT nào." Style="{StaticResource Pdvt.Muted}"
                                           Visibility="{Binding History.Count, Converter={StaticResource EqVis}, ConverterParameter=0}"/>
                                <ItemsControl ItemsSource="{Binding History}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Width="2" HorizontalAlignment="Left" Margin="5,4,0,0" Fill="{DynamicResource Blueprint.Outline}"/>
                                                <Ellipse x:Name="Dot" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,3,0,0"
                                                         Fill="{DynamicResource Blueprint.OnSurfaceVariant}" Stroke="{DynamicResource Blueprint.SurfaceBright}" StrokeThickness="2"/>
                                                <StackPanel Grid.Column="1" Margin="0,0,0,16">
                                                    <Button Style="{StaticResource Pdvt.Link}" Content="{Binding Reference}" FontSize="12.5"
                                                            Command="{Binding Data.OpenRecordByIdCommand, Source={StaticResource Vm}}" CommandParameter="{Binding RecordId}"/>
                                                    <TextBlock Style="{StaticResource Pdvt.Muted}" Margin="0,4,0,4">
                                                        <Run Text="{Binding Submitted, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Brand, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <Border Style="{StaticResource Pdvt.Pill}" Tag="{Binding StatusKind}">
                                                        <TextBlock Text="{Binding StatusLabel}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Note}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"
                                                               Foreground="{DynamicResource Blueprint.OnWarningContainer}"
                                                               Visibility="{Binding Note, Converter={StaticResource EqVis}, ConverterParameter=!}"/>
                                                </StackPanel>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding StatusKind}" Value="ok">
                                                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Status.Completed}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusKind}" Value="fix">
                                                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Status.Pending}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusKind}" Value="no">
                                                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Status.Error}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusKind}" Value="sub">
                                                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Status.InProgress}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================================================================= -->
        <!-- SNACKBAR                                                          -->
        <!-- ================================================================= -->
        <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" MaxWidth="620"
                CornerRadius="8" Padding="14,10,8,10" Panel.ZIndex="10"
                Visibility="{Binding IsToastVisible, Converter={StaticResource BoolVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Margin" Value="0,0,0,22"/>
                    <Setter Property="Background" Value="{DynamicResource Blueprint.OnSurface}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Blueprint.Surface}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsToastError}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Blueprint.Danger}"/>
                            <Setter Property="TextElement.Foreground" Value="White"/>
                        </DataTrigger>
                        <!-- Keep clear of the drawer footer buttons. -->
                        <DataTrigger Binding="{Binding IsBoqDrawerOpen}" Value="True">
                            <Setter Property="Margin" Value="0,0,0,88"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.22"/>
            </Border.Effect>
            <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding DismissToastCommand}" Cursor="Hand" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="Đóng"
                        Foreground="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=DockPanel}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" Padding="4">
                                <materialDesign:PackIcon Kind="Close" Width="14" Height="14" Opacity="0.8" Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button DockPanel.Dock="Right" Command="{Binding UndoCommand}" Cursor="Hand" Margin="14,0,0,0" VerticalAlignment="Center"
                        Visibility="{Binding CanUndo, Converter={StaticResource BoolVis}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <TextBlock Text="Hoàn tác" FontWeight="Bold" Foreground="#93C5FD"/>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <TextBlock Text="{Binding StatusMessage}" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
