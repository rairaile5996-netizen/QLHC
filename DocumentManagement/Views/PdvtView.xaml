<UserControl x:Class="DocumentManagement.Views.PdvtView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:DocumentManagement.Converters"
             Background="{DynamicResource Blueprint.Surface}"
             FontFamily="{DynamicResource Blueprint.Font.Body}"
             Foreground="{DynamicResource Blueprint.OnSurface}">

    <UserControl.InputBindings>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}"/>
    </UserControl.InputBindings>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <converters:TabIndexConverter x:Key="TabIndexConverter"/>
        <converters:TabVisibilityConverter x:Key="IndexToVisibilityConverter"/>

        <!-- Segmented Tab Button Style -->
        <Style x:Key="PdvtSegmentedTabButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurfaceVariant}"/>
            <Setter Property="FontFamily" Value="{DynamicResource Blueprint.Font.Header}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="PillBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource Blueprint.SurfaceBright}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurface}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource Blueprint.Primary}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cell Text Styles -->
        <Style x:Key="PdvtCellTextStyle" TargetType="TextBlock">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurface}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="PdvtCellEditingStyle" TargetType="TextBox">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="{DynamicResource Blueprint.SurfaceBright}"/>
            <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurface}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Blueprint.Primary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Unified DataGrid Column Header Style (Matches VTDV / CVXD) -->
        <Style x:Key="PdvtBaseColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource Blueprint.SurfaceContainerHigh}"/>
            <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurfaceVariant}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Blueprint.Outline}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- DataGrid Row Style (Subtle Slate Selection, No Clashing Royal Blue) -->
        <Style x:Key="PdvtDataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurface}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Blueprint.Outline}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Blueprint.SurfaceBright}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurface}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Blueprint.Selection}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurface}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsHeading}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Blueprint.SurfaceContainerHigh}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Blueprint.Primary}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid Cell Style -->
        <Style x:Key="PdvtDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurface}"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Blueprint.Outline}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Blueprint.Selection}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurface}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Blueprint.Selection}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurface}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Heading-aware CheckBox Style (hides checkbox on BoQ section headings) -->
        <Style x:Key="PdvtBoqCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource MaterialDesignCheckBox}">
            <Setter Property="Foreground" Value="{DynamicResource Blueprint.Primary}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHeading}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Seamless Dark-aware Cell ComboBox Style (Eliminates Windows default #FFFFFF background) -->
        <Style x:Key="PdvtCellComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurface}"/>
            <Setter Property="Background" Value="{DynamicResource Blueprint.SurfaceContainerHigh}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Blueprint.Outline}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"/>
                            <ContentPresenter x:Name="ContentSite"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              IsHitTestVisible="False"
                                              Margin="10,4,28,4"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextElement.Foreground="{DynamicResource Blueprint.OnSurface}"/>
                            <TextBox x:Name="PART_EditableTextBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource Blueprint.OnSurface}"
                                     CaretBrush="{DynamicResource Blueprint.Primary}"
                                     FontWeight="{TemplateBinding FontWeight}"
                                     FontSize="{TemplateBinding FontSize}"
                                     Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="Hidden"
                                     Margin="10,4,28,4"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"/>
                            <ToggleButton x:Name="ToggleButton"
                                          Width="28"
                                          HorizontalAlignment="Right"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Fill="{DynamicResource Blueprint.OnSurfaceVariant}"
                                                  Width="8"
                                                  Height="4"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="{DynamicResource Blueprint.SurfaceContainer}"
                                        BorderBrush="{DynamicResource Blueprint.Outline}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="280" Padding="0" CanContentScroll="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource Blueprint.Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurface}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource Blueprint.Selection}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource Blueprint.Primary}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnPrimary}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Record ListBoxItem Style (Matches VTDV Left Sidebar) -->
        <Style x:Key="PdvtRecordListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurface}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="CardBorder"
                                Background="{DynamicResource Blueprint.Surface}"
                                BorderBrush="{DynamicResource Blueprint.Outline}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,10">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource Blueprint.SurfaceBright}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource Blueprint.SurfaceBright}"/>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource Blueprint.Primary}"/>
                                <Setter TargetName="CardBorder" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- =================================================================== -->
        <!-- TOP HEADER BAR (Matches Nghiệm thu vật tư đầu vào - VTDV)           -->
        <!-- =================================================================== -->
        <Border Grid.Row="0" Background="{DynamicResource Blueprint.Surface}" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="0,0,0,1" Padding="28,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Title + Summary Badges -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ClipboardCheckOutline" Foreground="{DynamicResource Blueprint.Primary}" Width="22" Height="22" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock Text="PHÊ DUYỆT VẬT TƯ (PDVT)" FontFamily="{DynamicResource Blueprint.Font.Header}" FontSize="15" FontWeight="ExtraBold" Foreground="{DynamicResource Blueprint.OnSurface}" VerticalAlignment="Center"/>

                    <!-- Compact Status Pills -->
                    <Border Background="{DynamicResource Blueprint.SurfaceContainerHigh}" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="20,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="11" VerticalAlignment="Center">
                            <Run Text="BoQ: " Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"/>
                            <Run Text="{Binding MaterialBoqCount, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource Blueprint.OnSurface}"/>
                        </TextBlock>
                    </Border>
                    <Border Background="{DynamicResource Blueprint.SurfaceContainerHigh}" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="11" VerticalAlignment="Center">
                            <Run Text="Đã lập: " Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"/>
                            <Run Text="{Binding AssignedBoqCount, Mode=OneWay}" FontWeight="Bold" Foreground="#34D399"/>
                        </TextBlock>
                    </Border>
                    <Border Background="{DynamicResource Blueprint.SurfaceContainerHigh}" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="11" VerticalAlignment="Center">
                            <Run Text="Chưa lập: " Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"/>
                            <Run Text="{Binding UnassignedBoqCount, Mode=OneWay}" FontWeight="Bold" Foreground="#FBBF24"/>
                        </TextBlock>
                    </Border>
                </StackPanel>

                <!-- Center: Segmented View Switcher -->
                <Border Grid.Column="1" HorizontalAlignment="Center" Background="{DynamicResource Blueprint.SurfaceContainer}" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="1" CornerRadius="10" Padding="4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource PdvtSegmentedTabButtonStyle}"
                                     IsChecked="{Binding SelectedPdvtTabIndex, Converter={StaticResource TabIndexConverter}, ConverterParameter=0}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TableLarge" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="1. Danh mục BoQ Hợp đồng" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource PdvtSegmentedTabButtonStyle}"
                                     IsChecked="{Binding SelectedPdvtTabIndex, Converter={StaticResource TabIndexConverter}, ConverterParameter=1}"
                                     Margin="4,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileDocumentEditOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock VerticalAlignment="Center">
                                    <Run Text="2. Lập &amp; Quản lý Phiếu PDVT ("/>
                                    <Run Text="{Binding Records.Count, Mode=OneWay}"/>
                                    <Run Text=")"/>
                                </TextBlock>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <!-- Right: Global Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ImportBoqCommand}" Style="{StaticResource SurfaceButtonStyle}" Height="38" Padding="16,0" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileImport" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource Blueprint.SuccessOutline}"/>
                            <TextBlock Text="Nạp BoQ Excel" FontFamily="{DynamicResource Blueprint.Font.Header}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NewCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="38" Padding="18,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Tạo phiếu PDVT mới" FontFamily="{DynamicResource Blueprint.Font.Header}" FontSize="12" FontWeight="ExtraBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- =================================================================== -->
        <!-- VIEW 0: DANH MỤC BOQ HỢP ĐỒNG (FULL SCREEN)                         -->
        <!-- =================================================================== -->
        <Grid Grid.Row="1" Visibility="{Binding SelectedPdvtTabIndex, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=0}" Margin="24,20,24,12">
            <Border Background="{DynamicResource Blueprint.SurfaceBright}" CornerRadius="12" Padding="20" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Action Bar above BoQ Table -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ClipboardListOutline" Foreground="{DynamicResource Blueprint.Primary}" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="DANH MỤC VẬT TƯ THEO BOQ HỢP ĐỒNG" FontFamily="{DynamicResource Blueprint.Font.Header}" FontSize="14" FontWeight="Black" Foreground="{DynamicResource Blueprint.OnSurface}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Tích chọn các dòng vật tư cần đệ trình rồi bấm nút bên phải để đưa trực tiếp vào phiếu PDVT (thông số kỹ thuật &amp; xuất xứ tự động lấy theo hợp đồng)." FontSize="12" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" Margin="30,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{DynamicResource Blueprint.Surface}" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="1" CornerRadius="8" Padding="10,6" Width="210" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="Magnify" Width="16" Height="16" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding BoqSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Tìm vật tư, nhãn hiệu..."
                                             materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                                             BorderThickness="0" Background="Transparent"
                                             Foreground="{DynamicResource Blueprint.OnSurface}" FontSize="12"/>
                                </Grid>
                            </Border>

                            <CheckBox IsChecked="{Binding OnlyUnassignedBoq, Mode=TwoWay}"
                                      Style="{StaticResource MaterialDesignCheckBox}"
                                      Foreground="{DynamicResource Blueprint.Primary}"
                                      Content="Chỉ hiện chưa lập"
                                      FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0"/>

                            <Button Command="{Binding SelectAllUnassignedBoqCommand}" Style="{StaticResource SurfaceButtonStyle}" Height="38" Padding="14,0" Margin="0,0,10,0">
                                <TextBlock Text="Chọn hết chưa lập" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Button>

                            <Border Background="{DynamicResource Blueprint.Surface}" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock VerticalAlignment="Center" FontSize="12">
                                    <Run Text="Đã chọn: " Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"/>
                                    <Run Text="{Binding SelectedBoqCount, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource Blueprint.Primary}"/>
                                </TextBlock>
                            </Border>

                            <Button Command="{Binding NewFromSelectedCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="38" Padding="18,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FilePlusOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Tạo phiếu PDVT mới từ dòng chọn" VerticalAlignment="Center" FontWeight="ExtraBold" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Full-width BoQ DataGrid -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredBoqItems}" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" ColumnHeaderHeight="40" MinRowHeight="40"
                              Background="{DynamicResource Blueprint.Surface}" Foreground="{DynamicResource Blueprint.OnSurface}"
                              BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="1"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource Blueprint.Outline}"
                              ColumnHeaderStyle="{StaticResource PdvtBaseColumnHeader}"
                              RowStyle="{StaticResource PdvtDataGridRowStyle}"
                              CellStyle="{StaticResource PdvtDataGridCellStyle}"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Chọn" Width="54">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Style="{StaticResource PdvtBoqCheckBoxStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="STT" Binding="{Binding SttBoq}" Width="60" IsReadOnly="True" ElementStyle="{StaticResource PdvtCellTextStyle}"/>
                            <DataGridTextColumn Header="PDVT đã lập" Binding="{Binding PdvtNumbers}" Width="115" IsReadOnly="True" ElementStyle="{StaticResource PdvtCellTextStyle}"/>
                            <DataGridTextColumn Header="Phê duyệt số / Trạng thái" Binding="{Binding ApprovalSummary}" Width="155" IsReadOnly="True" ElementStyle="{StaticResource PdvtCellTextStyle}"/>
                            <DataGridTextColumn Header="Nội dung công việc / vật tư" Binding="{Binding NoiDung}" Width="2.3*" IsReadOnly="True" ElementStyle="{StaticResource PdvtCellTextStyle}"/>
                            <DataGridTextColumn Header="Thông số kỹ thuật theo HĐ" Binding="{Binding ThongSoKyThuat}" Width="1.8*" IsReadOnly="True" ElementStyle="{StaticResource PdvtCellTextStyle}"/>
                            <DataGridTextColumn Header="Nhãn hiệu / Xuất xứ theo HĐ" Binding="{Binding NhanHieuXuatXu}" Width="1.5*" IsReadOnly="True" ElementStyle="{StaticResource PdvtCellTextStyle}"/>
                            <DataGridTextColumn Header="ĐVT" Binding="{Binding DonViTinh}" Width="65" IsReadOnly="True" ElementStyle="{StaticResource PdvtCellTextStyle}"/>
                            <DataGridTextColumn Header="Khối lượng" Binding="{Binding KhoiLuong}" Width="85" IsReadOnly="True" ElementStyle="{StaticResource PdvtCellTextStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty BoQ State -->
                    <Border Grid.Row="1" Background="{DynamicResource Blueprint.Surface}" IsHitTestVisible="False"
                            BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="1" CornerRadius="8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BoqItems.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="FileExcelOutline" Width="48" Height="48" HorizontalAlignment="Center" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" Margin="0,0,0,12"/>
                            <TextBlock Text="Chưa có dữ liệu BoQ cho hợp đồng này" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" Foreground="{DynamicResource Blueprint.OnSurface}"/>
                            <TextBlock Text="Bấm nút 'Nạp BoQ Excel' ở góc phải phía trên để đọc danh mục vật tư từ file hợp đồng, hoặc chuyển sang tab '2. Lập &amp; Quản lý Phiếu PDVT'." FontSize="12" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- =================================================================== -->
        <!-- VIEW 1: LẬP & QUẢN LÝ PHIẾU PDVT (INLINE MASTER-DETAIL LIKE VTDV)   -->
        <!-- =================================================================== -->
        <Grid Grid.Row="1" Visibility="{Binding SelectedPdvtTabIndex, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=1}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR: DANH SÁCH PHIẾU PDVT -->
            <Border Grid.Column="0" Background="{DynamicResource Blueprint.SurfaceContainer}" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="0,0,1,0">
                <Grid Margin="14,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="DANH SÁCH PHIẾU PDVT" FontWeight="Bold" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" VerticalAlignment="Center" FontSize="11"/>
                        <Button Command="{Binding NewCommand}" Style="{StaticResource SurfaceButtonStyle}" HorizontalAlignment="Right" Padding="10,0" Height="28" ToolTip="Tạo phiếu PDVT mới">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" Foreground="{DynamicResource Blueprint.Primary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Phiếu mới" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Search Box -->
                    <Border Grid.Row="1" Background="{DynamicResource Blueprint.Surface}" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Magnify" Width="16" Height="16" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Tìm số phiếu, vật tư..."
                                     materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                                     BorderThickness="0" Background="Transparent"
                                     Foreground="{DynamicResource Blueprint.OnSurface}" FontSize="12"/>
                        </Grid>
                    </Border>

                    <!-- Records List -->
                    <ListBox Grid.Row="2" ItemsSource="{Binding Records}" SelectedItem="{Binding SelectedRecord, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource PdvtRecordListBoxItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Number}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Blueprint.OnSurface}"/>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" Margin="0,4,0,0">
                                            <Run Text="{Binding Date, StringFormat=dd/MM/yyyy}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding Materials.Count, Mode=OneWay}"/>
                                            <Run Text=" vật tư"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding HạngMục}" FontSize="11" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource Blueprint.SurfaceContainerHigh}" CornerRadius="4" Padding="6,2" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding StatusLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Blueprint.Primary}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- RIGHT WORKSPACE: INLINE PDVT EDITOR (NO POPUP MODAL) -->
            <Grid Grid.Column="1" Margin="20,18,20,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TOP CARD: THÔNG TIN PHIẾU PHÊ DUYỆT VẬT TƯ (Matches VTDV Card) -->
                <Border Grid.Row="0" Background="{DynamicResource Blueprint.SurfaceBright}" CornerRadius="12" Padding="20,16" Margin="0,0,0,14" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="1">
                    <StackPanel>
                        <!-- Card Title + Action Buttons -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="FileDocumentOutline" Foreground="{DynamicResource Blueprint.Primary}" Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="THÔNG TIN PHIẾU PHÊ DUYỆT VẬT TƯ" FontFamily="{DynamicResource Blueprint.Font.Header}" FontSize="15" FontWeight="Black" Foreground="{DynamicResource Blueprint.OnSurface}" VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource Blueprint.Surface}" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="1" CornerRadius="6" Padding="10,3" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DraftNumber}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Blueprint.Primary}"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding DeleteRecordCommand}" CommandParameter="{Binding SelectedRecord}"
                                        Visibility="{Binding IsEditingExisting, Converter={StaticResource BoolVis}}"
                                        Style="{StaticResource SurfaceButtonStyle}" Height="36" Padding="12,0" Margin="0,0,8,0"
                                        ToolTip="Xóa phiếu PDVT này">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="DeleteOutline" Width="17" Height="17" Foreground="{DynamicResource Blueprint.Danger}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Xóa phiếu" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Blueprint.Danger}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding OpenExcelCommand}" CommandParameter="{Binding SelectedRecord}"
                                        Visibility="{Binding IsEditingExisting, Converter={StaticResource BoolVis}}"
                                        Style="{StaticResource SurfaceButtonStyle}" Height="36" Padding="14,0" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileExcelOutline" Width="17" Height="17" Foreground="{DynamicResource Blueprint.SuccessOutline}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Mở Excel" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding SaveNewVersionCommand}"
                                        Visibility="{Binding IsEditingExisting, Converter={StaticResource BoolVis}}"
                                        Style="{StaticResource SurfaceButtonStyle}" Height="36" Padding="14,0" Margin="0,0,8,0"
                                        ToolTip="Lưu thành phiên bản tiếp theo (_v2, _v3) để giữ lịch sử trình duyệt">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ContentDuplicate" Width="16" Height="16" Foreground="{DynamicResource Blueprint.Primary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Lưu bản v2" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="36" Padding="18,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ContentSave" Width="17" Height="17" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Lưu &amp; Xuất Excel" FontFamily="{DynamicResource Blueprint.Font.Header}" FontSize="12" FontWeight="ExtraBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- 4 Uniform Input Boxes (Exact VTDV Input Styling) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="SỐ PHIẾU PDVT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" Margin="0,0,0,6"/>
                                <Border Background="{DynamicResource Blueprint.Surface}" Padding="12,6" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Blueprint.Outline}">
                                    <TextBox Text="{Binding DraftNumber, UpdateSourceTrigger=PropertyChanged}" Foreground="{DynamicResource Blueprint.Primary}" FontSize="13" FontWeight="Bold"
                                             materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0" Background="Transparent"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <TextBlock Text="NGÀY LẬP PHIẾU" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" Margin="0,0,0,6"/>
                                <Border Background="{DynamicResource Blueprint.Surface}" Padding="12,4" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Blueprint.Outline}">
                                    <DatePicker SelectedDate="{Binding DraftDate}" Foreground="{DynamicResource Blueprint.OnSurface}" FontSize="13"
                                                materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0" Background="Transparent" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,16,0">
                                <TextBlock Text="HẠNG MỤC CÔNG TRÌNH" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" Margin="0,0,0,6"/>
                                <Border Background="{DynamicResource Blueprint.Surface}" Padding="12,6" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Blueprint.Outline}">
                                    <TextBox Text="{Binding DraftCategory, UpdateSourceTrigger=PropertyChanged}" Foreground="{DynamicResource Blueprint.OnSurface}" FontSize="13"
                                             materialDesign:HintAssist.Hint="Ví dụ: Hệ thống điện, Cấp thoát nước..."
                                             materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0" Background="Transparent"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="NHÀ CUNG CẤP / NHÀ THẦU" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" Margin="0,0,0,6"/>
                                <Border Background="{DynamicResource Blueprint.Surface}" Padding="12,6" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Blueprint.Outline}">
                                    <TextBox Text="{Binding DraftSupplier, UpdateSourceTrigger=PropertyChanged}" Foreground="{DynamicResource Blueprint.OnSurface}" FontSize="13"
                                             materialDesign:HintAssist.Hint="Tên nhà cung cấp hoặc nhà thầu..."
                                             materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0" Background="Transparent"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- BOTTOM CARD: DANH SÁCH VẬT TƯ ĐỆ TRÌNH CHI TIẾT -->
                <Border Grid.Row="1" Background="{DynamicResource Blueprint.SurfaceBright}" CornerRadius="12" Padding="20,16" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Table Toolbar -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="TableLarge" Foreground="{DynamicResource Blueprint.Primary}" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="DANH SÁCH VẬT TƯ ĐỆ TRÌNH PHÊ DUYỆT" FontFamily="{DynamicResource Blueprint.Font.Header}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Blueprint.OnSurface}" VerticalAlignment="Center"/>
                                <TextBlock Text="· Thông số kỹ thuật &amp; xuất xứ tự động lấy theo hợp đồng, bấm đúp vào ô để sửa trực tiếp" FontSize="12" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding ToggleBoqPickerCommand}" Style="{StaticResource SurfaceButtonStyle}" Height="32" Padding="12,0" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="PlaylistPlus" Width="16" Height="16" Foreground="{DynamicResource Blueprint.Primary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Chọn thêm từ BoQ (ngay tại đây)" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding AddExtraCommand}" Style="{StaticResource SurfaceButtonStyle}" Height="32" Padding="12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Foreground="{DynamicResource Blueprint.Primary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Thêm vật tư phát sinh" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Inline BoQ Drawer inside the PDVT Editor (No Tab Jumping Needed) -->
                        <Border Grid.Row="1" Visibility="{Binding IsBoqPickerExpanded, Converter={StaticResource BoolVis}}"
                                Background="{DynamicResource Blueprint.Surface}" BorderBrush="{DynamicResource Blueprint.Primary}" BorderThickness="1.5"
                                CornerRadius="8" Padding="14,10" Margin="0,0,0,12" MaxHeight="280">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Quick Search BoQ -->
                                    <Border Grid.Column="0" Background="{DynamicResource Blueprint.SurfaceContainer}" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,12,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Kind="Magnify" Width="15" Height="15" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox Grid.Column="1" Text="{Binding BoqSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                     materialDesign:HintAssist.Hint="Tìm tên vật tư, nhãn hiệu..."
                                                     materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                                                     BorderThickness="0" Background="Transparent"
                                                     Foreground="{DynamicResource Blueprint.OnSurface}" FontSize="11"/>
                                        </Grid>
                                    </Border>

                                    <!-- Filter Unassigned + Select All Unassigned -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox IsChecked="{Binding OnlyUnassignedBoq, Mode=TwoWay}"
                                                  Style="{StaticResource MaterialDesignCheckBox}"
                                                  Foreground="{DynamicResource Blueprint.Primary}"
                                                  Content="Chỉ hiện vật tư chưa lập phiếu"
                                                  FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <Button Command="{Binding SelectAllUnassignedBoqCommand}" Style="{StaticResource SurfaceButtonStyle}" Height="28" Padding="10,0" Content="Chọn hết vật tư chưa lập" FontSize="11" Margin="0,0,8,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock VerticalAlignment="Center" FontSize="12" Margin="0,0,12,0">
                                            <Run Text="Đã tích: " Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"/>
                                            <Run Text="{Binding SelectedBoqCount, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource Blueprint.Primary}"/>
                                        </TextBlock>
                                        <Button Command="{Binding AddSelectedBoqCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="30" Padding="14,0" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Check" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Đưa dòng đã chọn vào phiếu" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding ToggleBoqPickerCommand}" Style="{StaticResource SurfaceButtonStyle}" Height="30" Padding="10,0" Content="Thu gọn" FontSize="11"/>
                                    </StackPanel>
                                </Grid>

                                <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredBoqItems}" AutoGenerateColumns="False" CanUserAddRows="False"
                                          HeadersVisibility="Column" ColumnHeaderHeight="34" MinRowHeight="34"
                                          Background="{DynamicResource Blueprint.SurfaceContainer}" Foreground="{DynamicResource Blueprint.OnSurface}"
                                          BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="1"
                                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource Blueprint.Outline}"
                                          ColumnHeaderStyle="{StaticResource PdvtBaseColumnHeader}"
                                          RowStyle="{StaticResource PdvtDataGridRowStyle}"
                                          CellStyle="{StaticResource PdvtDataGridCellStyle}"
                                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Chọn" Width="46">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Style="{StaticResource PdvtBoqCheckBoxStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="STT" Binding="{Binding SttBoq}" Width="52" IsReadOnly="True" ElementStyle="{StaticResource PdvtCellTextStyle}"/>
                                        <DataGridTextColumn Header="PDVT đã lập" Binding="{Binding PdvtNumbers}" Width="105" IsReadOnly="True" ElementStyle="{StaticResource PdvtCellTextStyle}"/>
                                        <DataGridTextColumn Header="Phê duyệt số / Trạng thái" Binding="{Binding ApprovalSummary}" Width="140" IsReadOnly="True" ElementStyle="{StaticResource PdvtCellTextStyle}"/>
                                        <DataGridTextColumn Header="Nội dung công việc / vật tư" Binding="{Binding NoiDung}" Width="2.2*" IsReadOnly="True" ElementStyle="{StaticResource PdvtCellTextStyle}"/>
                                        <DataGridTextColumn Header="Thông số KT" Binding="{Binding ThongSoKyThuat}" Width="1.4*" IsReadOnly="True" ElementStyle="{StaticResource PdvtCellTextStyle}"/>
                                        <DataGridTextColumn Header="Nhãn hiệu / Xuất xứ" Binding="{Binding NhanHieuXuatXu}" Width="1.4*" IsReadOnly="True" ElementStyle="{StaticResource PdvtCellTextStyle}"/>
                                        <DataGridTemplateColumn Header="Thao tác" Width="115">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.QuickAddBoqRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SurfaceButtonStyle}"
                                                            Height="26" Padding="8,0" Margin="4,2"
                                                            ToolTip="Nếu bấm ở dòng Đầu mục (I.1, I.2) sẽ lấy toàn bộ vật tư thuộc mục đó; nếu bấm ở dòng vật tư sẽ đưa ngay vật tư đó vào phiếu">
                                                        <TextBlock FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Blueprint.Primary}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="+ Đưa vào"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsHeading}" Value="True">
                                                                            <Setter Property="Text" Value="+ Lấy cả mục"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- Full-Width Proportional DataGrid (Fits 100% Width Without Horizontal Scroll) -->
                        <DataGrid Grid.Row="2" ItemsSource="{Binding DraftMaterials}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" HeadersVisibility="Column" MinRowHeight="42" ColumnHeaderHeight="40"
                                  Background="{DynamicResource Blueprint.Surface}" Foreground="{DynamicResource Blueprint.OnSurface}"
                                  BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="1"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource Blueprint.Outline}"
                                  ColumnHeaderStyle="{StaticResource PdvtBaseColumnHeader}"
                                  RowStyle="{StaticResource PdvtDataGridRowStyle}"
                                  CellStyle="{StaticResource PdvtDataGridCellStyle}"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STT" Binding="{Binding Stt}" Width="46" IsReadOnly="True" ElementStyle="{StaticResource PdvtCellTextStyle}"/>

                                <DataGridTextColumn Header="Nội dung vật tư / Công việc"
                                                    Binding="{Binding NoiDung, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="2.2*"
                                                    ElementStyle="{StaticResource PdvtCellTextStyle}"
                                                    EditingElementStyle="{StaticResource PdvtCellEditingStyle}"/>

                                <DataGridTextColumn Header="Thông số kỹ thuật (mặc định theo HĐ)"
                                                    Binding="{Binding ThongSoKyThuat, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="2*"
                                                    ElementStyle="{StaticResource PdvtCellTextStyle}"
                                                    EditingElementStyle="{StaticResource PdvtCellEditingStyle}"/>

                                <DataGridTextColumn Header="Nhãn hiệu theo HĐ"
                                                    Binding="{Binding NhanHieuTheoHd, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="1.2*"
                                                    ElementStyle="{StaticResource PdvtCellTextStyle}"
                                                    EditingElementStyle="{StaticResource PdvtCellEditingStyle}"/>

                                <DataGridTemplateColumn Header="Nhãn hiệu đệ trình" Width="1.4*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox IsEditable="True"
                                                      ItemsSource="{Binding NhanHieuOptions}"
                                                      Text="{Binding NhanHieuPheDuyet, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource PdvtCellComboBoxStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Xuất xứ đệ trình"
                                                    Binding="{Binding XuatXuDeTrinh, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="1.1*"
                                                    ElementStyle="{StaticResource PdvtCellTextStyle}"
                                                    EditingElementStyle="{StaticResource PdvtCellEditingStyle}"/>

                                <DataGridTextColumn Header="Ghi chú"
                                                    Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="1*"
                                                    ElementStyle="{StaticResource PdvtCellTextStyle}"
                                                    EditingElementStyle="{StaticResource PdvtCellEditingStyle}"/>

                                <DataGridTemplateColumn Header="Trạng thái" Width="135">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.ApprovalOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedValue="{Binding Status, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      SelectedValuePath="Value"
                                                      DisplayMemberPath="DisplayText"
                                                      Style="{StaticResource PdvtCellComboBoxStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="" Width="48">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.RemoveMaterialCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource DangerIconButtonStyle}"
                                                    Width="30" Height="30" Padding="0" ToolTip="Xóa dòng vật tư này">
                                                <materialDesign:PackIcon Kind="DeleteOutline" Width="17" Height="17"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Empty Materials Placeholder -->
                        <Border Grid.Row="2" Background="{DynamicResource Blueprint.Surface}" IsHitTestVisible="False"
                                BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DraftMaterials.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="PackageVariantPlus" Width="42" Height="42" HorizontalAlignment="Center" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" Margin="0,0,0,10"/>
                                <TextBlock Text="Chưa có vật tư nào trong phiếu này" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Foreground="{DynamicResource Blueprint.OnSurface}"/>
                                <TextBlock Text="Bấm 'Chọn thêm từ BoQ' để lấy từ hợp đồng hoặc bấm 'Thêm vật tư phát sinh'." FontSize="12" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Footer Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource Blueprint.SurfaceContainer}" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="0,1,0,0" Padding="24,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding EditorMessage}" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Foreground="{DynamicResource Blueprint.Primary}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
