                                <ComboBox ItemsSource="{Binding Documents}" SelectedItem="{Binding PendingSelectedDocument}" DisplayMemberPath="ContractNumber" IsEditable="True" IsTextSearchEnabled="True" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Blueprint.OnSurface}" FontSize="13" FontWeight="Bold" VerticalContentAlignment="Center" ToolTip="Chọn hợp đồng trong danh sách, sau đó bấm Áp dụng"/>
                            </Border>
                            <Button Grid.Column="2" Command="{Binding ApplyPendingSelectedDocumentCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="34" Padding="14,0" Margin="10,0,0,0" ToolTip="Áp dụng hợp đồng đã chọn cho dữ liệu đang làm việc">
