                Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="CheckCircleOutline" Width="18" Height="18" Foreground="{DynamicResource Blueprint.OnSuccessContainer}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding ToastMessage}" Foreground="{DynamicResource Blueprint.OnSuccessContainer}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
