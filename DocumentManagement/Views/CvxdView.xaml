<UserControl x:Class="DocumentManagement.Views.CvxdView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:DocumentManagement.Converters"
        xmlns:views="clr-namespace:DocumentManagement.Views"
        mc:Ignorable="d"
        Background="{DynamicResource Blueprint.Surface}"
        TextElement.Foreground="{DynamicResource Blueprint.OnSurface}"
        FontFamily="{DynamicResource Blueprint.Font.Body}"
        PreviewKeyDown="Root_PreviewKeyDown">

    <UserControl.InputBindings>
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Ctrl" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveShortcutCommand}"/>
    </UserControl.InputBindings>

    <UserControl.Resources>
        <converters:TabIndexConverter x:Key="TabIndexConverter" />
        <converters:TabVisibilityConverter x:Key="IndexToVisibilityConverter"/>
        <converters:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <converters:BooleanToOpacityConverter x:Key="BooleanToOpacityConverter"/>
        <converters:CvxdNoResultsVisibilityConverter x:Key="CvxdNoResultsVisibilityConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBooleanConverter"/>

        <Style x:Key="OtherTemplateTabStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurfaceVariant}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="TabSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource Blueprint.SurfaceContainerHigh}"/>
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource Blueprint.Primary}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurface}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource Blueprint.SurfaceContainer}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurfaceVariant}"/>
            <Setter Property="Background" Value="{DynamicResource Blueprint.SurfaceContainer}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Blueprint.Outline}"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontFamily" Value="{DynamicResource Blueprint.Font.Header}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,1,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Blueprint.SurfaceBright}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource Blueprint.Primary}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Blueprint.Primary}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Blueprint.SurfaceBright}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurface}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cell Styles -->
        <Style x:Key="CvxdCellTextBlockStyle" TargetType="TextBlock">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurface}"/>
        </Style>

        <Style x:Key="CvxdCellTextBlockWrapStyle" TargetType="TextBlock" BasedOn="{StaticResource CvxdCellTextBlockStyle}">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="CvxdCellEditingStyle" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Background" Value="{DynamicResource Blueprint.SurfaceBright}"/>
            <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurface}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Blueprint.Primary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="materialDesign:TextFieldAssist.DecorationVisibility" Value="Collapsed"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CvxdCellEditingWrapStyle" TargetType="TextBox">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="False"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="{DynamicResource Blueprint.SurfaceBright}"/>
            <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurface}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Blueprint.Primary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
        </Style>

        <Style x:Key="SidebarCompactToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Thu gọn / mở rộng thanh bên"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Grid>
                                <materialDesign:PackIcon x:Name="ExpandedIcon"
                                                         Kind="ChevronLeft"
                                                         Width="18"
                                                         Height="18"
                                                         Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>
                                <materialDesign:PackIcon x:Name="CompactIcon"
                                                         Kind="ChevronRight"
                                                         Width="18"
                                                         Height="18"
                                                         Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleSurface" Property="Background" Value="{DynamicResource Blueprint.SurfaceBright}"/>
                                <Setter TargetName="ToggleSurface" Property="BorderBrush" Value="{DynamicResource Blueprint.Outline}"/>
                                <Setter TargetName="ExpandedIcon" Property="Foreground" Value="{DynamicResource Blueprint.OnSurface}"/>
                                <Setter TargetName="CompactIcon" Property="Foreground" Value="{DynamicResource Blueprint.OnSurface}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ExpandedIcon" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="CompactIcon" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarMenuButtonStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="54"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="4,0,0,0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurfaceVariant}"/>
            <Setter Property="FontFamily" Value="{DynamicResource Blueprint.Font.Body}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0,8,8,0">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Blueprint.SurfaceBright}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurface}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Blueprint.Primary}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Blueprint.SurfaceContainer}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=SidebarCompactToggle}" Value="True">
                    <Setter Property="Width" Value="60"/>
                    <Setter Property="Height" Value="54"/>
                    <Setter Property="Margin" Value="0,2"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="BorderThickness" Value="3,0,0,0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarToolButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Height" Value="54"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurfaceVariant}"/>
            <Setter Property="FontFamily" Value="{DynamicResource Blueprint.Font.Body}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=SidebarCompactToggle}" Value="True">
                    <Setter Property="Width" Value="60"/>
                    <Setter Property="Height" Value="48"/>
                    <Setter Property="Margin" Value="0,4"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarCompactTextStyle" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=SidebarCompactToggle}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarCompactSeparatorStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Background" Value="{DynamicResource Blueprint.Outline}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,18,0,19"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=SidebarCompactToggle}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarCompactTopSpacerStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Height" Value="20"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=SidebarCompactToggle}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CvxdToolbarIconButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarIconButtonStyle}"/>
        <Style x:Key="CvxdSmallButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallButtonStyle}"/>
        <Style x:Key="CvxdSmallIconButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallIconButtonStyle}"/>
        <Style x:Key="CvxdGridIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DangerIconButtonStyle}"/>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource Blueprint.SurfaceContainerHigh}"/>
            <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurfaceVariant}"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Blueprint.Outline}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Blueprint.Outline}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Blueprint.SurfaceBright}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurface}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Blueprint.Selection}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurface}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Blueprint.Outline}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Blueprint.SelectionStrong}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurface}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Blueprint.Primary}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Blueprint.Selection}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurface}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Blueprint.Focus}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ConfigGridCellTextStyle" TargetType="TextBlock">
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurface}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>

        <Style x:Key="ConfigGridPathTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ConfigGridCellTextStyle}">
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurfaceVariant}"/>
        </Style>

        <Style x:Key="ConfigGridWrapTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ConfigGridCellTextStyle}">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>
        <Style x:Key="ConfigGridValueEditorStyle" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurface}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Blueprint.OnSurface}"/>
        </Style>

        <Style x:Key="ConfigDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Blueprint.Outline}"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Blueprint.Selection}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurface}"/>
                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Blueprint.Selection}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurface}"/>
                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid SizeChanged="Root_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn">
                <ColumnDefinition.Style>
                    <Style TargetType="ColumnDefinition">
                        <Setter Property="Width" Value="260"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=SidebarCompactToggle}" Value="True">
                                <Setter Property="Width" Value="124"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ColumnDefinition.Style>
            </ColumnDefinition>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="{DynamicResource Blueprint.SurfaceContainer}" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="0,0,1,0">
            <Grid Margin="0,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=SidebarCompactToggle}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>

                    <Style x:Key="SidebarNavIconStyle" TargetType="materialDesign:PackIcon">
                        <Setter Property="Width" Value="22"/>
                        <Setter Property="Height" Value="22"/>
                        <Setter Property="Margin" Value="0,0,12,0"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=SidebarCompactToggle}" Value="True">
                                <Setter Property="Width" Value="20"/>
                                <Setter Property="Height" Value="20"/>
                                <Setter Property="Margin" Value="0"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Resources>

                <ToggleButton x:Name="SidebarCompactToggle" Grid.Row="0" Style="{StaticResource SidebarCompactToggleStyle}"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Width="32"
                              Height="32"
                              Margin="0,4,14,44"
                              Background="Transparent"
                              BorderBrush="Transparent"
                              BorderThickness="1"
                              ToolTip="Thu gọn / mở rộng thanh bên">
                </ToggleButton>

                <StackPanel Grid.Row="0" Margin="20,0,56,44" Orientation="Horizontal">
                    <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource Blueprint.Primary}" Margin="0,0,14,0">
                        <materialDesign:PackIcon Kind="ClipboardCheck" Foreground="{DynamicResource Blueprint.OnPrimary}" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="CÔNG CỤ HSCL " FontFamily="{DynamicResource Blueprint.Font.Header}" FontSize="15" FontWeight="ExtraBold" Foreground="{DynamicResource Blueprint.OnSurface}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="24,0,24,0">
                    <Border Style="{StaticResource SidebarCompactTopSpacerStyle}"/>
                    <TextBlock Text="HỒ SƠ CHẤT LƯỢNG" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" Margin="0,0,0,8"/>
                    <RadioButton Style="{StaticResource SidebarMenuButtonStyle}" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource TabIndexConverter}, ConverterParameter=0}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileDocumentEditOutline" Style="{StaticResource SidebarNavIconStyle}"/>
                            <TextBlock Text="Danh sách CVXD" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource SidebarMenuButtonStyle}" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource TabIndexConverter}, ConverterParameter=1}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ArchiveOutline" Style="{StaticResource SidebarNavIconStyle}"/>
                            <TextBlock Text="Danh sách VTĐV" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource SidebarMenuButtonStyle}" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource TabIndexConverter}, ConverterParameter=7}" AutomationProperties.Name="Phê duyệt vật tư PDVT">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ClipboardCheckOutline" Style="{StaticResource SidebarNavIconStyle}"/>
                            <TextBlock Text="Phê duyệt vật tư (PDVT)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource SidebarMenuButtonStyle}" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource TabIndexConverter}, ConverterParameter=6}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileDocumentMultipleOutline" Style="{StaticResource SidebarNavIconStyle}"/>
                            <TextBlock Text="Hồ sơ khác" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <Border Style="{StaticResource SidebarCompactSeparatorStyle}"/>
                    <TextBlock Text="HỒ SƠ PHÁP LÝ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" Margin="0,18,0,8"/>
                    <RadioButton Style="{StaticResource SidebarMenuButtonStyle}" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource TabIndexConverter}, ConverterParameter=5}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileDocumentEditOutline" Style="{StaticResource SidebarNavIconStyle}"/>
                            <TextBlock Text="Tạo HSPL" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <Border Style="{StaticResource SidebarCompactSeparatorStyle}"/>
                    <TextBlock Text="THIẾT LẬP DỰ ÁN" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" Margin="0,18,0,8"/>
                    <RadioButton Style="{StaticResource SidebarMenuButtonStyle}" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource TabIndexConverter}, ConverterParameter=2}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="InformationOutline" Style="{StaticResource SidebarNavIconStyle}"/>
                            <TextBlock Text="Thông tin dự án" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <Border Style="{StaticResource SidebarCompactSeparatorStyle}"/>
                    <TextBlock Text="THIẾT LẬP HỆ THỐNG" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" Margin="0,18,0,8"/>
                    <RadioButton Style="{StaticResource SidebarMenuButtonStyle}" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource TabIndexConverter}, ConverterParameter=3}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PlaylistCheck" Style="{StaticResource SidebarNavIconStyle}"/>
                            <TextBlock Text="Cấu hình Template" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource SidebarMenuButtonStyle}" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource TabIndexConverter}, ConverterParameter=4}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="SettingsOutline" Style="{StaticResource SidebarNavIconStyle}"/>
                            <TextBlock Text="Cấu hình Tiêu chuẩn" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="24,0,24,32">
                    <TextBlock Text="CÔNG CỤ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" Margin="0,0,0,16"/>
                    <Button Style="{StaticResource SidebarToolButtonStyle}" Command="{Binding SaveGlobalConfigCommand}" IsEnabled="{Binding IsAdmin}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CloudSyncOutline" Style="{StaticResource SidebarNavIconStyle}"/>
                            <TextBlock Text="Lưu hệ thống" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <ScrollViewer x:Name="MainContentScrollViewer" Grid.Column="1"
                      SizeChanged="MainContentScrollViewer_SizeChanged"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      CanContentScroll="False"
                      Background="{DynamicResource Blueprint.Surface}">
        <Grid Background="{DynamicResource Blueprint.Surface}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="CvxdContractHeader" Grid.Row="0" Background="{DynamicResource Blueprint.Surface}" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="0,0,0,1" Padding="32,16" SizeChanged="MainContentScrollViewer_SizeChanged">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                        <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
