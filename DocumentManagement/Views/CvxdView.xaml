                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" FontSize="13" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" Margin="0,6,0,0" TextWrapping="Wrap">
                            <Run Text="Đang làm việc: "/>
                            <Run Text="{Binding SelectedDocument.ContractNumber, Mode=OneWay, TargetNullValue='Chưa chọn hợp đồng', FallbackValue='Chưa chọn hợp đồng'}" FontWeight="SemiBold" Foreground="{DynamicResource Blueprint.OnSurface}"/>
                        </TextBlock>
                    <Button x:Name="CvxdOpenExportedFilesButton" Grid.Column="1" Click="OpenExportedFiles_Click" Style="{StaticResource SecondaryButtonStyle}" Height="34" Padding="12,0" Margin="16,0,0,0" VerticalAlignment="Center" ToolTip="Xem và mở lại hồ sơ của hợp đồng đang làm việc">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderOpenOutline" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Hồ sơ đã tạo" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <!-- VIEW 0: CVXD DATA GRID -->
                <Grid x:Name="CvxdTabViewport" Visibility="{Binding SelectedTabIndex, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=0}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="32,16,32,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                          </Grid.RowDefinitions>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <StackPanel x:Name="CvxdEditActions" Grid.Row="0" Grid.Column="0" Orientation="Horizontal" AutomationProperties.Name="Chỉnh sửa bảng" Margin="0,0,18,12">
                            <Button Style="{StaticResource PrimaryButtonStyle}" Click="FindReplaceCvxd_Click" IsEnabled="{Binding IsAdmin}" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FindReplace" Width="16" Height="16" Margin="0,0,5,0"/>
                                    <TextBlock Text="Tìm &amp; thay" FontFamily="{DynamicResource Blueprint.Font.Header}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddRowCommand}" IsEnabled="{Binding IsAdmin}" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Margin="0,0,8,0"/>
                                    <TextBlock Text="Thêm dòng" FontFamily="{DynamicResource Blueprint.Font.Header}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource DangerButtonStyle}" Command="{Binding DeleteRowCommand}" CommandParameter="{Binding SelectedCvxdItem}" IsEnabled="{Binding IsAdmin}" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Delete" Margin="0,0,8,0"/>
                                    <TextBlock Text="Xóa dòng" FontFamily="{DynamicResource Blueprint.Font.Header}"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding AddCvxdCustomColumnCommand}" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding IsAdmin}" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="TableColumnPlusAfter" Margin="0,0,8,0"/>
                                    <TextBlock Text="Thêm cột" FontFamily="{DynamicResource Blueprint.Font.Header}"/>
                                </StackPanel>
                            </Button>

                                    <Button Command="{Binding UndoCommand}" ToolTip="Hoàn tác (Ctrl+Z)" Style="{StaticResource CvxdToolbarIconButtonStyle}" AutomationProperties.Name="Hoàn tác (Ctrl+Z)">
                                        <materialDesign:PackIcon Kind="Undo" Width="20" Height="20"/>
                                    </Button>
                                    <Button Command="{Binding RedoCommand}" ToolTip="Làm lại (Ctrl+Y)" Style="{StaticResource CvxdToolbarIconButtonStyle}" Margin="4,0,0,0" AutomationProperties.Name="Làm lại (Ctrl+Y)">
                                        <materialDesign:PackIcon Kind="Redo" Width="20" Height="20"/>
                                    </Button>
                          </StackPanel>
                          <Border x:Name="CvxdDataActions" Grid.Row="0" Grid.Column="1" Margin="0,0,18,12">
                           <StackPanel Orientation="Horizontal" AutomationProperties.Name="Dữ liệu">
                            <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SaveDataCommand}" IsEnabled="{Binding IsAdmin}" ToolTip="Lưu dữ liệu (Ctrl+S)" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentSave" Margin="0,0,8,0"/>
                                    <TextBlock Text="Lưu dữ liệu" FontFamily="{DynamicResource Blueprint.Font.Header}"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ImportCvxdExcelCommand}" IsEnabled="{Binding IsAdmin}" ToolTip="Nhập dữ liệu từ file Excel vào bảng CVXD">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileImport" Margin="0,0,8,0"/>
                                    <TextBlock Text="Nhập từ Excel" FontFamily="{DynamicResource Blueprint.Font.Header}"/>
                                </StackPanel>
                            </Button>
                           </StackPanel>
                          </Border>
                          <Border x:Name="CvxdExportActions" Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                           <StackPanel Orientation="Horizontal" AutomationProperties.Name="Xuất hồ sơ">
                            <Button Style="{StaticResource SuccessButtonStyle}" Command="{Binding ExportExcelCommand}" IsEnabled="{Binding IsAdmin}" ToolTip="Xuất toàn bộ dữ liệu trong bảng CVXD ra file Excel" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileExcelBox" Margin="0,0,8,0"/>
                                    <TextBlock Text="Xuất ra Excel" FontFamily="{DynamicResource Blueprint.Font.Header}"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ExportWordCommand}" IsEnabled="{Binding IsAdmin}" ToolTip="Tạo hồ sơ Word từ các dòng đã tick trong cột Xuất Word">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileWordBox" Margin="0,0,8,0"/>
                                    <TextBlock Text="Tạo hồ sơ Word" FontFamily="{DynamicResource Blueprint.Font.Header}"/>
                                </StackPanel>
                            </Button>
                           </StackPanel>
                          </Border>
                        </Grid>

                        <Border Grid.Row="1" HorizontalAlignment="Left" Background="{DynamicResource Blueprint.SurfaceContainer}" CornerRadius="4" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="1" Width="300" MaxWidth="420" Padding="12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="Magnify" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Tìm kiếm..." BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Blueprint.OnSurface}" VerticalContentAlignment="Center" Margin="0,4"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" Margin="32,12,32,24" Padding="0,0,12,12" Background="{DynamicResource Blueprint.Surface}" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource Blueprint.Outline}" ClipToBounds="True">
                      <Grid>
                        <DataGrid x:Name="DataGridCvxd" ItemsSource="{Binding CvxdItems}"
                                  SelectedItem="{Binding SelectedCvxdItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False"
                                  FrozenColumnCount="4" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource Blueprint.Outline}"
                                  Background="Transparent" BorderThickness="0" RowHeight="NaN" MinRowHeight="50"
                                  ColumnHeaderHeight="52" Foreground="{DynamicResource Blueprint.OnSurface}"
                                  PreparingCellForEdit="DataGrid_PreparingCellForEdit"
                                  CellEditEnding="DataGrid_CellEditEnding"
                                  SelectedCellsChanged="DataGrid_SelectedCellsChanged"
                                  IsReadOnly="{Binding IsReadOnly}"
                                  SelectionUnit="CellOrRowHeader"
                                  SelectionMode="Extended"
                                  ClipboardCopyMode="ExcludeHeader"
                                  HorizontalScrollBarVisibility="Visible"
                                  VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.CanContentScroll="False"
                                  PreviewKeyDown="DataGrid_PreviewKeyDown">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{DynamicResource Blueprint.SurfaceContainer}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurfaceVariant}"/>
                                    <Setter Property="FontWeight" Value="ExtraBold"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Padding" Value="16,0"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource Blueprint.Outline}"/>
                                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="DataGridColumnHeader_PreviewMouseLeftButtonDown"/>
                                </Style>

                                <Style TargetType="DataGridRowHeader">
                                    <Setter Property="Width" Value="18"/>
                                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="DataGridRowHeader_PreviewMouseLeftButtonDown"/>
                                </Style>

                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="12,0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurface}"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="DataGridCell_PreviewMouseLeftButtonDown"/>
                                    <EventSetter Event="PreviewMouseMove" Handler="DataGridCell_PreviewMouseMove"/>
                                    <EventSetter Event="PreviewMouseLeftButtonUp" Handler="DataGridCell_PreviewMouseLeftButtonUp"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderThickness="0"
                                                        SnapsToDevicePixels="True">
                                                    <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Blueprint.SelectionStrong}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnSurface}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>

                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource Blueprint.Outline}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Blueprint.SurfaceContainer}"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Blueprint.Selection}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasWarning}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Blueprint.WarningContainer}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Blueprint.ErrorContainer}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Resources>
                             <DataGrid.Columns>
                                <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="95">
                                    <DataGridCheckBoxColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="Tick dòng trong cột này để xuất Word; checkbox đầu cột chọn hoặc bỏ chọn tất cả. Bôi chọn ô/dòng chỉ dùng để chỉnh sửa hoặc sao chép, không thay đổi các dòng đã tick.">
                                                <CheckBox IsChecked="{Binding DataContext.AllSelected, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          Style="{StaticResource MaterialDesignCheckBox}"
                                                          Foreground="{DynamicResource Blueprint.OnSurface}"
                                                          VerticalAlignment="Center" Margin="0,0,6,0"
                                                          AutomationProperties.Name="Chọn hoặc bỏ chọn tất cả dòng để xuất Word"/>
                                                <TextBlock Text="Xuất&#10;Word" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridCheckBoxColumn.HeaderTemplate>
                                </DataGridCheckBoxColumn>

                                <DataGridTextColumn Header="STT" Binding="{Binding Stt, Mode=OneWay}" Width="70" IsReadOnly="True">
                                    <DataGridTextColumn.CellStyle>
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="DataGridCell">
                                                      <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Stt, Mode=OneWay}" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <materialDesign:PackIcon Width="14" Height="14" Margin="5,0,0,0" VerticalAlignment="Center" ToolTipService.InitialShowDelay="150">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Setter Property="Kind" Value="AlertOutline"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource Blueprint.Warning}"/>
                                                            <Setter Property="AutomationProperties.Name" Value="Dòng có cảnh báo"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasWarning}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Setter Property="Kind" Value="AlertCircleOutline"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource Blueprint.Error}"/>
                                                                    <Setter Property="AutomationProperties.Name" Value="Dòng thiếu dữ liệu bắt buộc"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                    <materialDesign:PackIcon.ToolTip>
                                                        <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" MaxWidth="360">
                                                            <StackPanel>
                                                                <TextBlock Text="Thiếu dữ liệu bắt buộc" FontWeight="SemiBold" Margin="0,0,0,6" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                <TextBlock Text="Kiểm tra Loại NT, Nội dung nghiệm thu, Ngày NT, giờ bắt đầu/kết thúc, Số Checklist và TCNT. Nếu Số Checklist khác 0, cần có Loại BB và Tên NT." TextWrapping="Wrap" Margin="0,0,0,6" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                <TextBlock Text="Cảnh báo thời gian" FontWeight="SemiBold" Margin="0,0,0,4" Visibility="{Binding HasWarning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                <TextBlock Text="{Binding WarningMessage}" TextWrapping="Wrap" Visibility="{Binding HasWarning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                            </StackPanel>
                                                        </ToolTip>
                                                    </materialDesign:PackIcon.ToolTip>
                                                </materialDesign:PackIcon>
                                            </StackPanel>
                                                      </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGridTextColumn.CellStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Header="Loại NT" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding LoaiNt}" Padding="12,8" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.AvailableNtTypes, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      SelectedItem="{Binding LoaiNt, UpdateSourceTrigger=PropertyChanged}"
                                                      DropDownOpened="CvxdComboBox_DropDownOpened"
                                                      DropDownClosed="CvxdComboBox_DropDownClosed"
                                                      Style="{StaticResource MaterialDesignComboBox}"
                                                      />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Nội dung Nghiệm thu" Binding="{Binding NoiDung}" Width="280" MinWidth="220"
                                                    ElementStyle="{StaticResource CvxdCellTextBlockWrapStyle}"
                                                    EditingElementStyle="{StaticResource CvxdCellEditingWrapStyle}"/>

                                <DataGridTextColumn Header="Ngày NT" Binding="{Binding NgayNt}" Width="110"
                                                    ElementStyle="{StaticResource CvxdCellTextBlockStyle}"
                                                    EditingElementStyle="{StaticResource CvxdCellEditingStyle}"/>

                                <DataGridTextColumn Header="Bắt đầu" Binding="{Binding BatDau}" Width="90"
                                                    ElementStyle="{StaticResource CvxdCellTextBlockStyle}"
                                                    EditingElementStyle="{StaticResource CvxdCellEditingStyle}"/>

                                <DataGridTextColumn Header="Kết thúc" Binding="{Binding KetThuc}" Width="90"
                                                    ElementStyle="{StaticResource CvxdCellTextBlockStyle}"
                                                    EditingElementStyle="{StaticResource CvxdCellEditingStyle}"/>

                                <DataGridTextColumn Header="Số Checklist" Binding="{Binding SoChecklist}" Width="100"
                                                    IsReadOnly="{Binding IsSoChecklistReadOnly}"
                                                    ElementStyle="{StaticResource CvxdCellTextBlockStyle}"
                                                    EditingElementStyle="{StaticResource CvxdCellEditingStyle}"/>

                                <DataGridTextColumn Header="Số PDVT" Binding="{Binding SoPdvt}" Width="120"
                                                    ElementStyle="{StaticResource CvxdCellTextBlockStyle}"
                                                    EditingElementStyle="{StaticResource CvxdCellEditingStyle}"/>

                                <DataGridTemplateColumn Header="Loại BB" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding LoaiBb}" Padding="12,8" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.AvailableChecklists, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      SelectedValue="{Binding LoaiBb, UpdateSourceTrigger=PropertyChanged}"
                                                      DropDownOpened="CvxdComboBox_DropDownOpened"
                                                      DropDownClosed="CvxdComboBox_DropDownClosed"
                                                      SelectedValuePath="Name"
                                                      TextSearch.TextPath="Name"
                                                      IsTextSearchEnabled="True"
                                                      IsEditable="True"
                                                      StaysOpenOnEdit="True"
                                                      Style="{StaticResource MaterialDesignComboBox}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Tên NT" Binding="{Binding TenNt}" Width="180"
                                                    ElementStyle="{StaticResource CvxdCellTextBlockWrapStyle}"
                                                    EditingElementStyle="{StaticResource CvxdCellEditingWrapStyle}"/>

                                <DataGridTemplateColumn Header="TCNT" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Tcnt}" Padding="12,8" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.GlobalConfig.GlobalStandards, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      SelectedValue="{Binding Tcnt, UpdateSourceTrigger=PropertyChanged}"
                                                      DropDownOpened="CvxdComboBox_DropDownOpened"
                                                      DropDownClosed="CvxdComboBox_DropDownClosed"
                                                      SelectedValuePath="Key"
                                                      DisplayMemberPath="Key"
                                                      Style="{StaticResource MaterialDesignComboBox}"
                                                      />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Margin="0,52,0,20" Background="{DynamicResource Blueprint.Surface}" IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CvxdItems.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" MaxWidth="400">
                                <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Blueprint.OnSurface}" TextAlignment="Center" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Chưa có dữ liệu nghiệm thu"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedDocument}" Value="{x:Null}">
                                                    <Setter Property="Text" Value="Chọn hợp đồng để bắt đầu"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock FontSize="12" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Dùng Thêm dòng hoặc Nhập từ Excel trên thanh công cụ để nhập dữ liệu."/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedDocument}" Value="{x:Null}">
                                                    <Setter Property="Text" Value="Chọn hợp đồng ở phía trên, rồi bấm Áp dụng."/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Margin="0,52,0,20" Background="{DynamicResource Blueprint.Surface}" IsHitTestVisible="False">
                            <Border.Visibility>
                                <MultiBinding Converter="{StaticResource CvxdNoResultsVisibilityConverter}" Mode="OneWay">
                                    <Binding Path="CvxdItems"/>
                                    <Binding Path="CvxdItems.Count"/>
                                    <Binding Path="SearchText"/>
                                </MultiBinding>
