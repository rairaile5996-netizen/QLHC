<UserControl x:Class="DocumentManagement.Views.DocumentDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:DocumentManagement.Converters"
             xmlns:views="clr-namespace:DocumentManagement.Views"
             xmlns:utilities="clr-namespace:DocumentManagement.Utilities"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000"
             FontFamily="Inter, Segoe UI"
             SizeChanged="DocumentDetailView_SizeChanged">

    <UserControl.Resources>
        <Style x:Key="DetailNavigationTabStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabSurface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,2">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource Blueprint.SurfaceContainerHigh}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource Blueprint.PrimaryContainer}"/><Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource Blueprint.Primary}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource Blueprint.Selection}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="TabSurface" Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="DetailPanel" Background="Transparent" AllowDrop="True" Drop="DetailPanel_Drop">
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <Trigger Property="Visibility" Value="Visible">
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25"/>
                                    <ThicknessAnimation Storyboard.TargetProperty="Margin" From="20,0,0,0" To="0" Duration="0:0:0.25">
                                        <ThicknessAnimation.EasingFunction>
                                            <QuadraticEase EasingMode="EaseOut"/>
                                        </ThicknessAnimation.EasingFunction>
                                    </ThicknessAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Margin="24,12,24,0" BorderBrush="{Binding BorderColor}" BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" 
                          PanningMode="HorizontalOnly">
                <StackPanel Orientation="Horizontal">
                    <!-- Tab 0: Tổng Hợp -->
                    <Button Style="{StaticResource DetailNavigationTabStyle}" Command="{Binding SetDetailTabCommand}" CommandParameter="0" AutomationProperties.Name="Tổng hợp" BorderBrush="{Binding DetailTabIndex, Converter={StaticResource TabBorderConverter}, ConverterParameter=0}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ChartBox" Width="16" Height="16" Foreground="{Binding DetailTabIndex, Converter={StaticResource TabForegroundConverter}, ConverterParameter=0}" VerticalAlignment="Center"/>
                            <TextBlock Text="Tổng hợp" FontFamily="{DynamicResource Blueprint.Font.Header}" FontSize="12" FontWeight="Medium" Foreground="{Binding DetailTabIndex, Converter={StaticResource TabForegroundConverter}, ConverterParameter=0}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <!-- Tab 1: HĐ + Phụ Lục -->
                    <Button Style="{StaticResource DetailNavigationTabStyle}" Command="{Binding SetDetailTabCommand}" CommandParameter="1" AutomationProperties.Name="Hợp đồng và phụ lục" BorderBrush="{Binding DetailTabIndex, Converter={StaticResource TabBorderConverter}, ConverterParameter=1}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileDocumentOutline" Width="16" Height="16" Foreground="{Binding DetailTabIndex, Converter={StaticResource TabForegroundConverter}, ConverterParameter=1}" VerticalAlignment="Center"/>
                            <TextBlock Text="HĐ / Phụ lục" FontFamily="{DynamicResource Blueprint.Font.Header}" FontSize="12" FontWeight="Medium" Foreground="{Binding DetailTabIndex, Converter={StaticResource TabForegroundConverter}, ConverterParameter=1}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <!-- Tab 2: Tạm ứng & thanh quyết toán -->
                    <Button Style="{StaticResource DetailNavigationTabStyle}" Command="{Binding SetDetailTabCommand}" ToolTip="Tạm ứng, thanh toán và quyết toán" CommandParameter="2" AutomationProperties.Name="Tạm ứng, thanh toán và quyết toán" BorderBrush="{Binding DetailTabIndex, Converter={StaticResource TabBorderConverter}, ConverterParameter=2}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CashMultiple" Width="16" Height="16" Foreground="{Binding DetailTabIndex, Converter={StaticResource TabForegroundConverter}, ConverterParameter=2}" VerticalAlignment="Center"/>
                            <TextBlock Text="Tạm ứng / Thanh toán" FontFamily="{DynamicResource Blueprint.Font.Header}" FontSize="12" FontWeight="Medium" Foreground="{Binding DetailTabIndex, Converter={StaticResource TabForegroundConverter}, ConverterParameter=2}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Tab 3: Thành phần hồ sơ -->
                    <Button Style="{StaticResource DetailNavigationTabStyle}" Command="{Binding SetDetailTabCommand}" CommandParameter="3" AutomationProperties.Name="Thành phần hồ sơ" BorderBrush="{Binding DetailTabIndex, Converter={StaticResource TabBorderConverter}, ConverterParameter=3}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ClipboardCheckOutline" Width="16" Height="16" Foreground="{Binding DetailTabIndex, Converter={StaticResource TabForegroundConverter}, ConverterParameter=3}" VerticalAlignment="Center"/>
                            <TextBlock Text="Thành phần hồ sơ" FontFamily="{DynamicResource Blueprint.Font.Header}" FontSize="12" FontWeight="Medium" Foreground="{Binding DetailTabIndex, Converter={StaticResource TabForegroundConverter}, ConverterParameter=3}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Tab 4: Hồ sơ & Tài liệu -->
                    <Button Style="{StaticResource DetailNavigationTabStyle}" Command="{Binding SetDetailTabCommand}" CommandParameter="4" AutomationProperties.Name="Tài liệu" BorderBrush="{Binding DetailTabIndex, Converter={StaticResource TabBorderConverter}, ConverterParameter=4}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderOpen" Width="16" Height="16" Foreground="{Binding DetailTabIndex, Converter={StaticResource TabForegroundConverter}, ConverterParameter=4}" VerticalAlignment="Center"/>
                            <TextBlock Text="Tài liệu" FontFamily="{DynamicResource Blueprint.Font.Header}" FontSize="12" FontWeight="Medium" Foreground="{Binding DetailTabIndex, Converter={StaticResource TabForegroundConverter}, ConverterParameter=4}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource DetailNavigationTabStyle}" Command="{Binding SetDetailTabCommand}" CommandParameter="5" AutomationProperties.Name="Thư bảo lãnh" BorderBrush="{Binding DetailTabIndex, Converter={StaticResource TabBorderConverter}, ConverterParameter=5}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ShieldOutline" Width="16" Height="16" Foreground="{Binding DetailTabIndex, Converter={StaticResource TabForegroundConverter}, ConverterParameter=5}" VerticalAlignment="Center"/>
                            <TextBlock Text="Thư bảo lãnh" FontFamily="{DynamicResource Blueprint.Font.Header}" FontSize="12" FontWeight="Medium" Foreground="{Binding DetailTabIndex, Converter={StaticResource TabForegroundConverter}, ConverterParameter=5}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
          
        </Border>
        
        <!-- PLACEHOLDERS FOR TABS -->
        <!-- Tab 3: Thành phần hồ sơ -->
        <Grid Grid.Row="1" Margin="24,16,24,24" Visibility="{Binding DetailTabIndex, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=3}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid x:Name="ChecklistHeader" Grid.Row="0" Margin="0,0,0,14">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid x:Name="ChecklistHeading">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="8" Background="#2563EB" Margin="0,0,12,0">
                        <materialDesign:PackIcon Kind="ClipboardCheckOutline" Width="22" Height="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Thành phần hồ sơ ban đầu" FontSize="16" FontWeight="Bold" Foreground="{Binding TextPrimaryColor}"/>
                        <TextBlock FontSize="12" Foreground="{Binding TextSecondaryColor}" TextWrapping="Wrap">
                            <Run Text="Đã đủ: "/><Run Text="{Binding InitialChecklistProgressText, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  |  Còn thiếu: "/><Run Text="{Binding InitialChecklistMissingText, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
                <Button x:Name="ChecklistSaveButton" Grid.Column="1" AutomationProperties.Name="Lưu thành phần hồ sơ" Command="{Binding SaveInitialDocumentChecklistCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="14,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentSave" Width="17" Height="17" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        <TextBlock Text="Lưu thành phần hồ sơ" Margin="8,0,0,0" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Grid>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding InitialDocumentChecklist}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeight="48"
                      Background="{Binding BackgroundColor}"
                      Foreground="{Binding TextPrimaryColor}"
                      BorderBrush="{Binding BorderColor}"
                      BorderThickness="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Hồ sơ" Binding="{Binding Name}" Width="220" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="Trạng thái" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.InitialChecklistStatuses, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedItem="{Binding Status, UpdateSourceTrigger=PropertyChanged}"
                                          Background="{Binding DataContext.CardBackgroundColor, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          Foreground="{Binding DataContext.TextPrimaryColor, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          BorderBrush="{Binding DataContext.BorderColor, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          Padding="8,4"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Ghi chú" Binding="{Binding Note}" Width="*" MinWidth="260"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Tab 4: Hồ sơ & Tài liệu -->
        <Grid Grid.Row="1" Margin="24,16,24,24" Visibility="{Binding DetailTabIndex, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=4}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="Folder" Width="18" Height="18" Foreground="{Binding TextSecondaryColor}"/>
                                <TextBlock Text="{Binding SelectedDocument.FolderPath, TargetNullValue=Chưa liên kết thư mục}" Foreground="{Binding TextSecondaryColor}" FontSize="11" Margin="8,0,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Border Grid.Row="1"
                                    Visibility="{Binding SelectedDocument.IsFolderMissing, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Background="{DynamicResource Blueprint.WarningContainer}"
                                    BorderBrush="{DynamicResource Blueprint.Warning}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,10"
                                    Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FolderAlert" Width="16" Height="16" Foreground="{DynamicResource Blueprint.Warning}" VerticalAlignment="Center"/>
                                    <TextBlock Foreground="{DynamicResource Blueprint.OnWarningContainer}" FontSize="12" Margin="8,0,0,0" TextWrapping="Wrap">
                                        Thư mục hồ sơ hiện không truy cập được. Dữ liệu vẫn còn trong hệ thống; kiểm tra lại ổ đĩa hoặc đường dẫn gốc trước khi thao tác file.
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12" MaxHeight="200">
                                <ItemsControl ItemsSource="{Binding FolderTabs}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="100" Margin="0,0,12,12" Cursor="Hand" CornerRadius="8" Padding="12" BorderThickness="2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{Binding DataContext.CardBackgroundColor, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource Blueprint.Warning}"/>
                                                                <Setter Property="Background" Value="{DynamicResource Blueprint.WarningContainer}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.SelectFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                            <StackPanel HorizontalAlignment="Center">
                                                <materialDesign:PackIcon Kind="Folder" Width="36" Height="36" Foreground="{DynamicResource Blueprint.Warning}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding DisplayName}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{Binding DataContext.TextPrimaryColor, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnWarningContainer}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding FileCount, StringFormat='{}{0} tệp'}" FontSize="10" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{Binding DataContext.TextSecondaryColor, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Blueprint.OnWarningContainer}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </ScrollViewer>
                            <Border Grid.Row="3" Background="{Binding BackgroundColor}" CornerRadius="12" Padding="16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" 
                                                    Command="{Binding GoBackFolderCommand}" Cursor="Hand"
                                                    Visibility="{Binding CanGoBack, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    ToolTip="Quay lại" Margin="0,0,4,0" AutomationProperties.Name="Quay lại">
                                                <materialDesign:PackIcon Kind="ArrowLeft" Width="18" Height="18" Foreground="{DynamicResource Blueprint.Primary}"/>
                                            </Button>
                                            <materialDesign:PackIcon Kind="Folder" Width="20" Height="20" Foreground="{DynamicResource Blueprint.Warning}"/>
                                            <TextBlock Text="{Binding CurrentFolderDisplayPath}" Foreground="{Binding TextPrimaryColor}" FontFamily="{DynamicResource Blueprint.Font.Header}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                            <Button Padding="12,6" Background="Transparent" Foreground="{DynamicResource Blueprint.Warning}" Command="{Binding CreateNewFolderCommand}" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="FolderPlus" Width="16" Height="16"/>
                                                    <TextBlock Text="Tạo thư mục" FontFamily="{DynamicResource Blueprint.Font.Header}" FontSize="12" Margin="6,0,0,0"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Padding="12,6" Background="Transparent" Foreground="{DynamicResource Blueprint.SuccessOutline}" Command="{Binding AddFolderToFolderCommand}" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="FolderUpload" Width="16" Height="16"/>
                                                    <TextBlock Text="Thêm thư mục" FontFamily="{DynamicResource Blueprint.Font.Header}" FontSize="12" Margin="6,0,0,0"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Padding="12,6" Background="Transparent" Foreground="{DynamicResource Blueprint.Primary}" Command="{Binding AddFileToFolderCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="FileUpload" Width="16" Height="16"/>
                                                    <TextBlock Text="Thêm tệp" FontSize="12" Margin="6,0,0,0"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <Border Grid.Row="1" Background="{Binding CardBackgroundColor}" CornerRadius="8" BorderBrush="{Binding BorderColor}" BorderThickness="2" AllowDrop="True" Drop="DropZone_Drop" DragOver="DropZone_DragOver" MinHeight="150">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding CurrentFolderFiles.Count, Converter={StaticResource EmptyToVisibilityConverter}}">
                                                <materialDesign:PackIcon Kind="CloudUpload" Width="40" Height="40" Foreground="{Binding TextSecondaryColor}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Kéo thả file vào đây" Foreground="{Binding TextSecondaryColor}" FontSize="14" Margin="0,12,0,0"/>
                                            </StackPanel>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding CurrentFolderFiles.Count, Converter={StaticResource NotEmptyToVisibilityConverter}}" Padding="8">
                                                <ItemsControl ItemsSource="{Binding CurrentFolderFiles}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border x:Name="FileItemBorder" Background="{Binding DataContext.BackgroundColor, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CornerRadius="8" Margin="0,0,0,8" Padding="12,10" BorderBrush="Transparent" BorderThickness="1" Cursor="Hand">
                                                                <Border.ContextMenu>
                                                                    <ContextMenu Background="{Binding DataContext.ContextMenuBackground, Source={x:Reference DetailPanel}}"
                                                                                 Foreground="{Binding DataContext.TextPrimaryColor, Source={x:Reference DetailPanel}}"
                                                                                 BorderBrush="{Binding DataContext.ContextMenuBorder, Source={x:Reference DetailPanel}}">
                                                                        <MenuItem Header="Mở file" Command="{Binding DataContext.OpenFileFromDetailCommand, Source={x:Reference Name=DetailPanel}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                                            <MenuItem.Icon>
                                                                                <materialDesign:PackIcon Kind="OpenInNew" Foreground="{DynamicResource Blueprint.Primary}"/>
                                                                            </MenuItem.Icon>
                                                                        </MenuItem>
                                                                        <MenuItem Header="Mở thư mục chứa" Command="{Binding DataContext.OpenContainingFolderCommand, Source={x:Reference Name=DetailPanel}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                                            <MenuItem.Icon>
                                                                                <materialDesign:PackIcon Kind="FolderOpen" Foreground="{DynamicResource Blueprint.Warning}"/>
                                                                            </MenuItem.Icon>
                                                                        </MenuItem>
                                                                        <Separator/>
                                                                        <MenuItem Header="📄 Tạo CV thanh toán" 
                                                                                  Command="{Binding DataContext.GeneratePaymentRequestFromFileCommand, Source={x:Reference Name=DetailPanel}}" 
                                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                  Visibility="{Binding PlacementTarget.DataContext.FileExtension, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource ExcelFileToVisibilityConverter}}">
                                                                            <MenuItem.Icon>
                                                                                <materialDesign:PackIcon Kind="FileDocument" Foreground="{DynamicResource Blueprint.SuccessOutline}"/>
                                                                            </MenuItem.Icon>
                                                                        </MenuItem>
                                                                        <Separator Visibility="{Binding PlacementTarget.DataContext.FileExtension, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource ExcelFileToVisibilityConverter}}"/>
                                                                        <MenuItem Header="Đổi tên" Command="{Binding DataContext.RenameFileOrFolderCommand, Source={x:Reference Name=DetailPanel}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                                            <MenuItem.Icon>
                                                                                <materialDesign:PackIcon Kind="Pencil" Foreground="{DynamicResource Blueprint.Warning}"/>
                                                                            </MenuItem.Icon>
                                                                        </MenuItem>
                                                                        <MenuItem Header="Xóa" Command="{Binding DataContext.DeleteFileFromFolderCommand, Source={x:Reference Name=DetailPanel}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                                            <MenuItem.Icon>
                                                                                <materialDesign:PackIcon Kind="Delete" Foreground="{DynamicResource Blueprint.Error}"/>
                                                                            </MenuItem.Icon>
                                                                        </MenuItem>
                                                                    </ContextMenu>
                                                                </Border.ContextMenu>
                                                                <Border.InputBindings>
                                                                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding DataContext.OpenFileFromDetailCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                                </Border.InputBindings>
                                                                <Border.Triggers>
                                                                    <EventTrigger RoutedEvent="MouseEnter">
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#3B82F6" Duration="0:0:0.15"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </EventTrigger>
                                                                    <EventTrigger RoutedEvent="MouseLeave">
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="Transparent" Duration="0:0:0.15"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </EventTrigger>
                                                                </Border.Triggers>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border CornerRadius="6" Padding="10,8" MinWidth="50" VerticalAlignment="Center" Background="{Binding FileExtension, Converter={StaticResource FileTypeBgColorConverter}}">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                                                        <Setter Property="Background" Value="{DynamicResource Blueprint.WarningContainer}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <Grid HorizontalAlignment="Center">
                                                                            <materialDesign:PackIcon Kind="{Binding FileExtension, Converter={StaticResource FileTypeIconConverter}}" Width="20" Height="20" Foreground="{Binding FileExtension, Converter={StaticResource FileTypeColorConverter}}">
                                                                                <materialDesign:PackIcon.Style>
                                                                                    <Style TargetType="materialDesign:PackIcon">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </materialDesign:PackIcon.Style>
                                                                            </materialDesign:PackIcon>
                                                                            <materialDesign:PackIcon Kind="Folder" Width="20" Height="20" Foreground="{DynamicResource Blueprint.Warning}">
                                                                                <materialDesign:PackIcon.Style>
                                                                                    <Style TargetType="materialDesign:PackIcon">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        <Style.Triggers>
