                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="ContentSave" Width="14" Height="14" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Lưu quyết toán &amp; bảo hành" FontSize="12" FontWeight="Medium" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <!-- AI Warning Banner -->
                                            <Border x:Name="SettlementAIWarning" Visibility="{Binding IsSettlementAIWarningVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Background="{DynamicResource Blueprint.WarningContainer}" CornerRadius="6" Padding="10,8" Margin="0,0,0,16">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="AlertCircle" Width="16" Height="16" Foreground="{DynamicResource Blueprint.Warning}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Dữ liệu đọc bởi AI có thể sai sót, vui lòng kiểm tra lại." Foreground="{DynamicResource Blueprint.OnWarningContainer}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="200"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Row 1: Giá trị quyết toán -->
                                                <Border Grid.Row="0" Grid.Column="0" Background="#10B981" CornerRadius="16" Width="32" Height="32" VerticalAlignment="Center" Margin="0,8">
                                                    <materialDesign:PackIcon Kind="CheckCircle" Width="16" Height="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Giá trị quyết toán" FontSize="13" Foreground="{Binding TextPrimaryColor}" VerticalAlignment="Center" Margin="12,8"/>
                                                <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding SettlementValueText, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="NumberValidationTextBox" Background="{Binding CardBackgroundColor}" BorderBrush="{Binding BorderColor}" Foreground="{Binding TextPrimaryColor}" BorderThickness="1" Padding="12,8" FontSize="13" VerticalAlignment="Center" Margin="0,8"/>
                                                <Border Grid.Row="0" Grid.ColumnSpan="3" BorderBrush="{Binding BorderColor}" BorderThickness="0,0,0,1" VerticalAlignment="Bottom"/>

                                                <!-- Row 2: Giá trị còn lại thanh toán -->
                                                <Border Grid.Row="1" Grid.Column="0" Background="#EF4444" CornerRadius="16" Width="32" Height="32" VerticalAlignment="Center" Margin="0,8">
                                                    <materialDesign:PackIcon Kind="CashMinus" Width="16" Height="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Giá trị còn lại thanh toán" FontSize="13" Foreground="{Binding TextPrimaryColor}" VerticalAlignment="Center" Margin="12,8"/>
                                                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding RemainingPaymentText, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="NumberValidationTextBox" Background="{Binding CardBackgroundColor}" BorderBrush="{Binding BorderColor}" Foreground="{Binding TextPrimaryColor}" BorderThickness="1" Padding="12,8" FontSize="13" VerticalAlignment="Center" Margin="0,8"/>
                                                <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="{Binding BorderColor}" BorderThickness="0,0,0,1" VerticalAlignment="Bottom"/>

                                                <!-- Row 3: Giá trị bảo hành -->
                                                <Border Grid.Row="2" Grid.Column="0" Background="#F59E0B" CornerRadius="16" Width="32" Height="32" VerticalAlignment="Center" Margin="0,8">
                                                    <materialDesign:PackIcon Kind="ShieldCheck" Width="16" Height="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Giá trị giữ lại bảo hành" FontSize="13" Foreground="{Binding TextPrimaryColor}" VerticalAlignment="Center" Margin="12,8"/>
                                                <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding WarrantyValueText, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="NumberValidationTextBox" Background="{Binding CardBackgroundColor}" BorderBrush="{Binding BorderColor}" Foreground="{Binding TextPrimaryColor}" BorderThickness="1" Padding="12,8" FontSize="13" VerticalAlignment="Center" Margin="0,8"/>
                                                <Border Grid.Row="2" Grid.ColumnSpan="3" BorderBrush="{Binding BorderColor}" BorderThickness="0,0,0,1" VerticalAlignment="Bottom"/>

                                                <!-- Row 4: Ngày hết hạn bảo hành -->
                                                <Border Grid.Row="3" Grid.Column="0" Background="#8B5CF6" CornerRadius="16" Width="32" Height="32" VerticalAlignment="Center" Margin="0,8">
                                                    <materialDesign:PackIcon Kind="CalendarClock" Width="16" Height="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Grid.Row="3" Grid.Column="1" Text="Ngày hết hạn bảo hành" FontSize="13" Foreground="{Binding TextPrimaryColor}" VerticalAlignment="Center" Margin="12,8"/>
                                                <DatePicker Grid.Row="3" Grid.Column="2" SelectedDate="{Binding WarrantyExpiryDate, UpdateSourceTrigger=PropertyChanged}" Background="{Binding CardBackgroundColor}" BorderBrush="{Binding BorderColor}" Foreground="{Binding TextPrimaryColor}" BorderThickness="1" Padding="8,4" FontSize="13" VerticalAlignment="Center" Margin="0,8"/>
                                                <Border Grid.Row="3" Grid.ColumnSpan="3" BorderBrush="{Binding BorderColor}" BorderThickness="0,0,0,1" VerticalAlignment="Bottom"/>

                                                <!-- Row 5: Checkbox xuất chứng thư bảo lãnh -->
                                                <Border Grid.Row="4" Grid.Column="0" Background="#6366F1" CornerRadius="16" Width="32" Height="32" VerticalAlignment="Center" Margin="0,8">
                                                    <materialDesign:PackIcon Kind="FileDocument" Width="16" Height="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <CheckBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Content="Xuất chứng thư bảo lãnh bảo hành" IsChecked="{Binding HasWarrantyBond}" Foreground="{Binding TextPrimaryColor}" VerticalAlignment="Center" Margin="12,8" FontSize="13"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>



        <!-- Tab 0: Tổng Hợp -->
        <Grid Grid.Row="1" Margin="24,16,24,24" Visibility="{Binding DetailTabIndex, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=0}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 1. KPI Metric Cards Top Row -->
                            <UniformGrid x:Name="SummaryMetricsGrid" Grid.Row="0" Rows="1" Columns="4" Margin="0,0,0,20">
                                <!-- Card 1: Tổng GT hợp đồng -->
                                <Border Margin="0,0,12,0" Padding="16,12" Background="{Binding CardBackgroundColor}" CornerRadius="12" BorderBrush="{Binding BorderColor}" BorderThickness="1">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Top" HorizontalAlignment="Left">
                                            <materialDesign:PackIcon Kind="Cash" Width="18" Height="18" Foreground="{DynamicResource Blueprint.Primary}"/>
                                            <TextBlock Text="Tổng Giá Trị (HĐ+PL)" FontSize="12" Foreground="{Binding TextSecondaryColor}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,20,0,0">
                                            <Run Text="{Binding GrandTotalValue, StringFormat='{}{0:N0}'}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Blueprint.Primary}"/>
                                            <Run Text=" VND" FontSize="11" Foreground="{Binding TextSecondaryColor}" FontWeight="SemiBold"/>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <!-- Card 2: Đã Tạm Ứng -->
                                <Border Margin="6,0,6,0" Padding="16,12" Background="{Binding CardBackgroundColor}" CornerRadius="12" BorderBrush="{Binding BorderColor}" BorderThickness="1">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Top" HorizontalAlignment="Left">
                                            <materialDesign:PackIcon Kind="CurrencyUsd" Width="18" Height="18" Foreground="{DynamicResource Blueprint.Warning}"/>
                                            <TextBlock Text="Tổng Tạm Ứng" FontSize="12" Foreground="{Binding TextSecondaryColor}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,20,0,0">
                                            <Run Text="{Binding TotalPlannedAdvance, StringFormat='{}{0:N0}'}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Blueprint.Warning}"/>
                                            <Run Text=" VND" FontSize="11" Foreground="{Binding TextSecondaryColor}" FontWeight="SemiBold"/>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <!-- Card 3: Đã Thanh Toán -->
                                <Border Margin="6,0,6,0" Padding="16,12" Background="{Binding CardBackgroundColor}" CornerRadius="12" BorderBrush="{Binding BorderColor}" BorderThickness="1">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Top" HorizontalAlignment="Left">
                                            <materialDesign:PackIcon Kind="Check" Width="18" Height="18" Foreground="{DynamicResource Blueprint.SuccessOutline}"/>
                                            <TextBlock Text="Đã Thanh Toán" FontSize="12" Foreground="{Binding TextSecondaryColor}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,20,0,0">
                                            <Run Text="{Binding TotalPayment, StringFormat='{}{0:N0}'}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Blueprint.SuccessOutline}"/>
                                            <Run Text=" VND" FontSize="11" Foreground="{Binding TextSecondaryColor}" FontWeight="SemiBold"/>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <!-- Card 4: Quyết toán -->
                                <Border Margin="12,0,0,0" Padding="16,12" Background="{Binding CardBackgroundColor}" CornerRadius="12" BorderBrush="{Binding BorderColor}" BorderThickness="1">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Top" HorizontalAlignment="Left">
                                            <materialDesign:PackIcon Kind="CheckCircle" Width="18" Height="18" Foreground="{DynamicResource Blueprint.OnInfoContainer}"/>
                                            <TextBlock Text="Giá Trị Quyết Toán" FontSize="12" Foreground="{Binding TextSecondaryColor}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,20,0,0">
                                            <Run Text="{Binding SelectedDocument.SettlementValue, StringFormat='{}{0:N0}'}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Blueprint.OnInfoContainer}"/>
                                            <Run Text=" VND" FontSize="11" Foreground="{Binding TextSecondaryColor}" FontWeight="SemiBold"/>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </UniformGrid>

                            <!-- 2. Main Dashboard Layout -->
                            <Grid x:Name="SummaryDashboardLayout" Grid.Row="1">
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition x:Name="SummaryNotesColumn" Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Cột trái: Detailed Information -->
                                <ScrollViewer x:Name="SummaryDetailsScroller" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,12,0">
                                    <Grid x:Name="SummaryCardsLayout" MaxWidth="1600" HorizontalAlignment="Stretch" Margin="16,0,16,0">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.85*" MinWidth="300"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- LEFT COLUMN -->
                                        <StackPanel x:Name="SummaryProjectCards" Grid.Column="0" Margin="0,0,8,0">
                                            <!-- Card: Thông tin Dự án -->
                                        <Border Background="{Binding BackgroundColor}" CornerRadius="12" Padding="20" Margin="0,0,0,16" BorderBrush="{Binding BorderColor}" BorderThickness="1">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" MinWidth="140"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Số hợp đồng -->
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Số hợp đồng:" FontFamily="{DynamicResource Blueprint.Font.Header}" FontSize="12" Foreground="{Binding TextSecondaryColor}" VerticalAlignment="Top" Margin="0,10"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedDocument.ContractNumber}" FontSize="13" Foreground="{DynamicResource Blueprint.Primary}" FontWeight="Bold" TextWrapping="Wrap" Margin="8,10"/>

                                                    <!-- Ngày ký -->
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Ngày ký:" FontFamily="{DynamicResource Blueprint.Font.Header}" FontSize="12" Foreground="{Binding TextSecondaryColor}" VerticalAlignment="Top" Margin="0,10"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedDocument.SignDate, StringFormat='dd/MM/yyyy'}" FontSize="13" Foreground="{Binding TextPrimaryColor}" FontWeight="Medium" Margin="8,10"/>

                                                    <!-- Dự án -->
                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Tên Dự án:" FontFamily="{DynamicResource Blueprint.Font.Header}" FontSize="12" Foreground="{Binding TextSecondaryColor}" VerticalAlignment="Top" Margin="0,10"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedDocument.ProjectName}" FontSize="13" Foreground="{Binding TextPrimaryColor}" FontWeight="Medium" TextWrapping="Wrap" Margin="8,10"/>

                                                    <!-- Công trình -->
                                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Công trình:" FontFamily="{DynamicResource Blueprint.Font.Header}" FontSize="12" Foreground="{Binding TextSecondaryColor}" VerticalAlignment="Top" Margin="0,12"/>
                                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedDocument.ConstructionName}" FontFamily="{DynamicResource Blueprint.Font.Header}" FontSize="14" Foreground="{Binding TextPrimaryColor}" FontWeight="ExtraBold" TextWrapping="Wrap" Margin="8,12"/>

                                                    <!-- Hạng mục -->
                                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Hạng mục:" FontFamily="{DynamicResource Blueprint.Font.Header}" FontSize="12" Foreground="{Binding TextSecondaryColor}" VerticalAlignment="Top" Margin="0,10"/>
                                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedDocument.ItemName}" FontSize="13" Foreground="{Binding TextPrimaryColor}" TextWrapping="Wrap" Margin="8,10"/>

                                                    <!-- Địa điểm -->
                                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Địa điểm:" FontFamily="{DynamicResource Blueprint.Font.Header}" FontSize="12" Foreground="{Binding TextSecondaryColor}" VerticalAlignment="Top" Margin="0,10"/>
                                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedDocument.Location}" FontSize="13" Foreground="{Binding TextPrimaryColor}" TextWrapping="Wrap" Margin="8,10"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Card: Thông tin Các Bên (Investor, Employer, Contractor) -->
                                        <Border Background="{Binding BackgroundColor}" CornerRadius="12" Padding="20" Margin="0,0,0,16" BorderBrush="{Binding BorderColor}" BorderThickness="1">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                                    <materialDesign:PackIcon Kind="Handshake" Width="20" Height="20" Foreground="{DynamicResource Blueprint.Primary}"/>
                                                    <TextBlock Text="THÔNG TIN CÁC BÊN" FontFamily="{DynamicResource Blueprint.Font.Header}" FontSize="14" FontWeight="Bold" Foreground="{Binding TextPrimaryColor}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Chủ đầu tư - Full Width -->
                                                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
                                                        <TextBlock Text="CHỦ ĐẦU TƯ" HorizontalAlignment="Center" FontSize="10" Foreground="{Binding TextSecondaryColor}" FontWeight="Bold" Margin="0,0,0,4"/>
                                                        <Border Background="{DynamicResource Blueprint.SurfaceContainerHigh}" BorderBrush="{DynamicResource Blueprint.Primary}" BorderThickness="1" CornerRadius="4" Padding="8,6">
                                                            <TextBlock Text="{Binding SelectedDocument.InvestorName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Blueprint.Primary}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- Bên Giao Thầu - Left -->
                                                    <StackPanel Grid.Row="1" Grid.Column="0">
                                                        <TextBlock Text="BÊN GIAO THẦU" HorizontalAlignment="Center" FontSize="10" Foreground="{Binding TextSecondaryColor}" FontWeight="Bold" Margin="0,0,0,4"/>
                                                        <Border Background="{DynamicResource Blueprint.PrimaryContainer}" BorderBrush="{DynamicResource Blueprint.Primary}" BorderThickness="1" CornerRadius="4" Padding="8,6" MinHeight="48" VerticalAlignment="Stretch">
                                                            <TextBlock Text="{Binding SelectedDocument.EmployerName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Blueprint.OnPrimaryContainer}" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- Bên Nhận Thầu - Right -->
                                                    <StackPanel Grid.Row="1" Grid.Column="2">
                                                        <TextBlock Text="BÊN NHẬN THẦU" HorizontalAlignment="Center" FontSize="10" Foreground="{Binding TextSecondaryColor}" FontWeight="Bold" Margin="0,0,0,4"/>
                                                        <Border Background="{DynamicResource Blueprint.SuccessContainer}" BorderBrush="{DynamicResource Blueprint.SuccessOutline}" BorderThickness="1" CornerRadius="4" Padding="8,6" MinHeight="48" VerticalAlignment="Stretch">
                                                            <TextBlock Text="{Binding SelectedDocument.ContractorName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Blueprint.OnSuccessContainer}" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>


                                        </StackPanel>

                                        <!-- RIGHT COLUMN - FINANCIAL DATA -->
                                        <StackPanel x:Name="SummaryFinanceCards" Grid.Column="1" Margin="8,0,0,0">
                                            <!-- Card: Chi tiết Tài chính (HĐ & Phụ lục) -->
                                        <Border Background="{Binding BackgroundColor}" CornerRadius="12" Padding="20" Margin="0,0,0,16" BorderBrush="{Binding BorderColor}" BorderThickness="1">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                                    <materialDesign:PackIcon Kind="ClipboardText" Width="20" Height="20" Foreground="{DynamicResource Blueprint.Primary}"/>
                                                    <TextBlock Text="Hợp đồng &amp; phụ lục" FontSize="14" FontWeight="Bold" Foreground="{Binding TextPrimaryColor}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <!-- Original Contract Value -->
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="FileDocument" Width="14" Height="14" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <TextBlock Text="Giá trị Hợp đồng gốc" FontSize="13" Foreground="{Binding TextSecondaryColor}"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding SelectedDocument.ContractValue, StringFormat='{}{0:N0} đ'}" FontSize="14" Foreground="{Binding TextPrimaryColor}" FontWeight="SemiBold"/>
                                                </Grid>

                                                <!-- Individual Appendices List -->
                                                <ItemsControl ItemsSource="{Binding Appendices}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                                                                    <materialDesign:PackIcon Kind="Label" Width="12" Height="12" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                    <TextBlock Foreground="{Binding DataContext.TextSecondaryColor, RelativeSource={RelativeSource AncestorType=ItemsControl}}" FontSize="12">
                                                                        <Run Text="Phụ lục "/>
                                                                        <Run Text="{Binding AppendixNumber, Converter={StaticResource CleanAppendixNumberConverter}}" FontWeight="SemiBold"/>
                                                                        <Run Text=" ("/><Run Text="{Binding SignDate, StringFormat='dd/MM/yyyy'}"/><Run Text=")"/>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1" Text="{Binding Value, StringFormat='{}{0:N0} đ'}" FontSize="13" Foreground="{Binding DataContext.TextPrimaryColor, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Total Section -->
                                                <Border BorderBrush="{Binding BorderColor}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,12,0,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Tổng giá trị" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Blueprint.Primary}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding GrandTotalValue, StringFormat='{}{0:N0} đ'}" FontSize="16" FontWeight="Black" Foreground="{DynamicResource Blueprint.Primary}"/>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- Row: Tạm ứng & Thanh toán Side-by-Side -->
                                        <Grid x:Name="AdvancePaymentCards" Margin="0,0,0,16">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Card: Chi tiết Tạm ứng (Thông minh) -->
                                            <Border x:Name="AdvanceReconciliationCard" Grid.Column="0" Background="{Binding BackgroundColor}" CornerRadius="12" Padding="16" Margin="0,0,8,0" BorderBrush="{Binding BorderColor}" BorderThickness="1">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                        <materialDesign:PackIcon Kind="CreditCardClock" Width="18" Height="18" Foreground="{DynamicResource Blueprint.Warning}"/>
                                                        <TextBlock Text="Đối soát tạm ứng" FontSize="13" FontWeight="Bold" Foreground="{Binding TextPrimaryColor}" Margin="8,0,0,0"/>
                                                    </StackPanel>
                                                    
                                                    <ItemsControl ItemsSource="{Binding AdvanceSummaries}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{Binding DataContext.CardBackgroundColor, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                                                        CornerRadius="8" Padding="10" Margin="0,0,0,10" 
                                                                        BorderBrush="{Binding DataContext.BorderColor, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                                                        BorderThickness="1">
                                                                    <StackPanel>
                                                                        <!-- Entity Header (Contract/Appendix) -->
                                                                        <Grid Margin="0,0,0,8">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Grid.Column="0" Text="{Binding EntityName}" FontWeight="Bold" Foreground="{Binding DataContext.TextPrimaryColor, RelativeSource={RelativeSource AncestorType=ItemsControl}}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                                            <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontSize="11" Foreground="{Binding DataContext.TextSecondaryColor, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Margin="8,0,0,0">
                                                                                <Run Text="{Binding PlannedValue, StringFormat='{}{0:N0} đ'}" FontWeight="SemiBold"/>
                                                                            </TextBlock>
                                                                        </Grid>

                                                                        <!-- Sub Items (Actual Payments) -->
                                                                        <ItemsControl ItemsSource="{Binding SubItems}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Grid Margin="12,0,0,4">
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="*"/>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <TextBlock FontSize="11" Foreground="{Binding DataContext.TextPrimaryColor, RelativeSource={RelativeSource AncestorType=UserControl}}" TextTrimming="CharacterEllipsis">
                                                                                            <Run Text="{Binding Name}"/><Run Text=" ("/><Run Text="{Binding Date}"/><Run Text=")"/>
                                                                                        </TextBlock>
                                                                                        <TextBlock Grid.Column="1" Text="{Binding Value, StringFormat='{}{0:N0}'}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Blueprint.SuccessOutline}" HorizontalAlignment="Right" Margin="8,0,0,0"/>
                                                                                    </Grid>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>

                                                                        <!-- Remaining / Completed Status -->
                                                                        <Border BorderBrush="{Binding DataContext.BorderColor, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                                                                BorderThickness="0,1,0,0" Margin="0,6,0,0" Padding="0,6,0,0">
                                                                            <Grid>
                                                                                <!-- Completed State -->
                                                                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsCompleted, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                    <materialDesign:PackIcon Kind="CheckCircle" Width="14" Height="14" Foreground="{DynamicResource Blueprint.SuccessOutline}" VerticalAlignment="Center"/>
                                                                                    <TextBlock Text="Hoàn thành" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Blueprint.SuccessOutline}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                                                </StackPanel>

                                                                                <!-- Remaining State -->
                                                                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsCompleted, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                                                    <materialDesign:PackIcon Kind="AlertCircle" Width="14" Height="14" Foreground="{DynamicResource Blueprint.Warning}" VerticalAlignment="Center"
                                                                                                            Visibility="{Binding PlannedValue, Converter={StaticResource GreaterThan0ToVisibilityConverter}}"/>
                                                                                    <TextBlock FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"
                                                                                               Visibility="{Binding PlannedValue, Converter={StaticResource GreaterThan0ToVisibilityConverter}}">
                                                                                        <Run Text="Tạm ứng còn lại: " Foreground="{Binding DataContext.TextSecondaryColor, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                                                        <Run Text="{Binding RemainingValue, Mode=OneWay, StringFormat='{}{0:N0} đ'}" FontWeight="Bold" Foreground="{DynamicResource Blueprint.Error}"/>
                                                                                    </TextBlock>
                                                                                    <!-- Case where no plan is set -->
                                                                                    <TextBlock Text="Chưa có giá trị dự kiến" FontSize="11" FontStyle="Italic" Foreground="{Binding DataContext.TextSecondaryColor, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                               Visibility="{Binding PlannedValue, Converter={StaticResource LessOrEqual0ToVisibilityConverter}}"/>
                                                                                </StackPanel>
                                                                            </Grid>
                                                                        </Border>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>

                                            <!-- Card: Chi tiết Thanh toán -->
                                            <Border x:Name="PaymentCard" Grid.Column="1" Background="{Binding BackgroundColor}" CornerRadius="12" Padding="16" Margin="8,0,0,0" BorderBrush="{Binding BorderColor}" BorderThickness="1">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                        <materialDesign:PackIcon Kind="CheckCircle" Width="18" Height="18" Foreground="{DynamicResource Blueprint.SuccessOutline}"/>
                                                        <TextBlock Text="Thanh toán" FontSize="13" FontWeight="Bold" Foreground="{Binding TextPrimaryColor}" Margin="8,0,0,0"/>
                                                    </StackPanel>

                                                    <ItemsControl ItemsSource="{Binding Payments}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Margin="0,0,12,0" Text="{Binding Description}" FontSize="12" Foreground="{Binding DataContext.TextSecondaryColor, RelativeSource={RelativeSource AncestorType=ItemsControl}}" TextTrimming="CharacterEllipsis"  HorizontalAlignment="Left"/><TextBlock Grid.Column="1" Text="{Binding Value, StringFormat='{}{0:N0}'}" FontSize="12" Foreground="{Binding DataContext.TextPrimaryColor, RelativeSource={RelativeSource AncestorType=ItemsControl}}" HorizontalAlignment="Right" FontWeight="Medium"/></Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <Border BorderBrush="{Binding BorderColor}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,8,0,0">
                                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Margin="0,0,12,0" Text="Tổng thanh toán" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Blueprint.SuccessOutline}"/><TextBlock Grid.Column="1" Text="{Binding TotalPayment, StringFormat='{}{0:N0}'}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Blueprint.SuccessOutline}" HorizontalAlignment="Right"/></Grid>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Card: Quyết toán & Bảo hành -->
                                        <Border Background="{Binding BackgroundColor}" CornerRadius="12" Padding="20" Margin="0,0,0,16" BorderBrush="{Binding BorderColor}" BorderThickness="1">
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                                <StackPanel Grid.Row="0" Grid.RowSpan="2">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,190,12">
                                                        <materialDesign:PackIcon Kind="CheckCircle" Width="18" Height="18" Foreground="{DynamicResource Blueprint.OnInfoContainer}"/>
                                                        <TextBlock Text="Quyết toán &amp; bảo hành" FontSize="13" FontWeight="Bold" Foreground="{Binding TextPrimaryColor}" Margin="8,0,0,0"/>
                                                    </StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" MinWidth="160"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        
                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Giá trị Quyết toán:" FontSize="13" Foreground="{Binding TextSecondaryColor}"/>
                                                        <TextBlock HorizontalAlignment="Right" Grid.Row="0" Grid.Column="1" Text="{Binding SelectedDocument.SettlementValue, StringFormat='{}{0:N0} đ'}" FontSize="14" Foreground="{DynamicResource Blueprint.OnInfoContainer}" FontWeight="Bold" Margin="8,0,0,4"/>
                                                        
                                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Giá trị còn lại thanh toán:" FontSize="13" Foreground="{Binding TextSecondaryColor}"/>
                                                        <TextBlock HorizontalAlignment="Right" Grid.Row="1" Grid.Column="1" Text="{Binding SelectedDocument.RemainingPaymentValue, StringFormat='{}{0:N0} đ'}" FontSize="14" Foreground="{DynamicResource Blueprint.Error}" FontWeight="Bold" Margin="8,0,0,4"/>

                                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Giá trị bảo hành (KTBH):" FontSize="13" Foreground="{Binding TextSecondaryColor}"/>
                                                        <TextBlock HorizontalAlignment="Right" Grid.Row="2" Grid.Column="1" Text="{Binding SelectedDocument.WarrantyValue, StringFormat='{}{0:N0} đ'}" FontSize="14" Foreground="{Binding TextPrimaryColor}" FontWeight="SemiBold" Margin="8,0,0,4"/>
                                                        
                                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Hạn bảo hành:" FontSize="13" Foreground="{Binding TextSecondaryColor}"/>
                                                        <TextBlock HorizontalAlignment="Right" Grid.Row="3" Grid.Column="1" Text="{Binding SelectedDocument.WarrantyExpiryDate, StringFormat='dd/MM/yyyy'}" FontSize="14" Foreground="{Binding TextPrimaryColor}" Margin="8,0,0,0"/>
                                                    </Grid>
                                                </StackPanel>
                                                
                                                <!-- Warranty Bond Section Only -->
                                                <StackPanel Grid.Row="0" VerticalAlignment="Top" Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <StackPanel Orientation="Horizontal" Visibility="{Binding SelectedDocument.HasWarrantyBond, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <materialDesign:PackIcon Kind="Certificate" Width="18" Height="18" Foreground="{DynamicResource Blueprint.Warning}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Có chứng thư bảo lãnh" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Blueprint.Warning}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                    </Grid>
                                </ScrollViewer>

                                <!-- Cột phải: Ghi chú (Collapsible Desktop style) -->
                                <Grid x:Name="SummaryNotesPanel" Grid.Column="1" Margin="12,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Ribbon Handle (Always visible) -->
                                    <Border x:Name="SummaryNotesRibbon" Grid.Column="0" Background="{Binding NoteBorderColor}" Width="48" CornerRadius="12,0,0,12" VerticalAlignment="Stretch" Margin="8,0,0,0">
                                        <Grid>
                                            <StackPanel x:Name="SummaryNotesRibbonControls" VerticalAlignment="Top" Margin="0,24,0,0">
                                                <!-- Toggle Button with better visibility -->
                                                <Button Command="{Binding ToggleNotesCommand}" 
                                                        Background="{Binding NoteTextColor}" 
                                                        Foreground="{Binding NoteBackgroundColor}"
                                                        Width="36" Height="36" 
                                                        Padding="0" 
                                                        Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                                        HorizontalAlignment="Center" Cursor="Hand">
                                                    <materialDesign:PackIcon Width="24" Height="24">
                                                        <materialDesign:PackIcon.Style>
                                                            <Style TargetType="materialDesign:PackIcon">
                                                                <Setter Property="Kind" Value="ChevronLeft"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsNotesExpanded}" Value="True">
                                                                        <Setter Property="Kind" Value="ChevronRight"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </materialDesign:PackIcon.Style>
                                                    </materialDesign:PackIcon>
                                                </Button>

                                                <!-- Vertical Label -->
                                                <TextBlock x:Name="SummaryNotesCollapsedLabel" Text="GHI CHÚ" 
                                                           Margin="0,40,0,0"
                                                           FontSize="14" FontWeight="Black" 
                                                           Foreground="{Binding NoteTextColor}"
                                                           HorizontalAlignment="Center"
                                                           Visibility="{Binding IsNotesExpanded, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                    <TextBlock.LayoutTransform>
                                                        <RotateTransform Angle="-90"/>
                                                    </TextBlock.LayoutTransform>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Notes Content Panel -->
                                    <Border x:Name="SummaryNotesContent" Grid.Column="1" Background="{Binding NoteBackgroundColor}" CornerRadius="0,16,16,0" Padding="20" 
                                            BorderBrush="{Binding NoteBorderColor}" BorderThickness="0,1,1,1"
                                            Visibility="{Binding IsNotesExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Width="280">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            
                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                                                <materialDesign:PackIcon Kind="NoteEdit" Width="24" Height="24" Foreground="{Binding NoteTextColor}"/>
                                                <TextBlock Text="Ghi Chú Hợp Đồng" FontSize="16" FontWeight="Bold" Foreground="{Binding NoteTextColor}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            
                                            <TextBox x:Name="SummaryNotesEditor" Grid.Row="1" Text="{Binding SummaryNotes, UpdateSourceTrigger=PropertyChanged}" 
                                                     Style="{x:Null}"
                                                     Background="Transparent" BorderThickness="0" 
                                                     Foreground="{Binding NoteTextColor}" CaretBrush="{Binding NoteTextColor}" FontSize="15" 
                                                     TextWrapping="Wrap" AcceptsReturn="True" MinHeight="120"
                                                     VerticalScrollBarVisibility="Auto"
                                                     HorizontalScrollBarVisibility="Disabled"
                                                     VerticalAlignment="Stretch"/>
                                            
                                            <Button Grid.Row="2" Command="{Binding SaveSummaryNotesCommand}" 
                                                    Background="{Binding NoteTextColor}" BorderThickness="0" 
                                                    Foreground="{Binding NoteBackgroundColor}"
                                                    Height="40" Margin="0,20,0,0" materialDesign:ButtonAssist.CornerRadius="20">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="ContentSave" Width="18" Height="18"/>
                                                    <TextBlock Text="Lưu ghi chú" Margin="8,0,0,0" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>

    </Grid>
</UserControl>
