<Window x:Class="DocumentManagement.Views.ModuleSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:utilities="clr-namespace:DocumentManagement.Utilities"
        xmlns:views="clr-namespace:DocumentManagement.Views"
        xmlns:updates="clr-namespace:DocumentManagement.Views.Updates"
        Title="Chọn phân hệ"
        Height="720"
        Width="1000"
        WindowState="Maximized"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False"
        Background="{DynamicResource Blueprint.Surface}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinWidth="760"
        MinHeight="520"
        ShowInTaskbar="True"
        ShowActivated="True"
        Topmost="False"
        SizeChanged="ModuleSelectionWindow_SizeChanged"
        PreviewMouseDown="ModuleSelectionWindow_PreviewMouseDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Converters.xaml"/>
                <ResourceDictionary Source="../Styles/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ModuleCardStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="460"/>
                <Setter Property="Padding" Value="24"/>
                <Setter Property="Background" Value="{DynamicResource Blueprint.SurfaceBright}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Blueprint.Outline}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CardSurface" CornerRadius="16" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CardSurface" Property="Background" Value="{DynamicResource Blueprint.SurfaceContainerHigh}"/><Setter TargetName="CardSurface" Property="BorderBrush" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CardSurface" Property="BorderBrush" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/><Setter TargetName="CardSurface" Property="BorderThickness" Value="2"/></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="CardSurface" Property="Background" Value="{DynamicResource Blueprint.Selection}"/></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="CardSurface" Property="Opacity" Value="0.6"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="0"
            Background="{DynamicResource Blueprint.SurfaceContainer}"
            BorderBrush="{DynamicResource Blueprint.Outline}"
            BorderThickness="1">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- TOP NAV BAR                                       -->
            <!-- ================================================= -->

            <Border Grid.Row="0"
                    Padding="32,14"
                    BorderBrush="{DynamicResource Blueprint.Outline}"
                    BorderThickness="0,0,0,1">

                <Grid>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <materialDesign:PackIcon
                            Kind="Layers"
                            Foreground="{DynamicResource Blueprint.Primary}"
                            Width="28"
                            Height="28"
                            Margin="0,0,12,0"/>

                        <TextBlock
                            Text="Quản lý hồ sơ"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="{DynamicResource Blueprint.OnSurface}"
                            VerticalAlignment="Center"/>

                    </StackPanel>


                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">

                        <Grid Margin="0,0,8,0">

                            <Button x:Name="GuaranteeNotificationButton"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"
                                    Width="40"
                                    Height="40"
                                    Padding="0"
                                    ToolTip="Thông báo bảo lãnh" AutomationProperties.Name="Thông báo bảo lãnh" Command="{Binding ToggleGuaranteeNotificationsCommand}">

                                <materialDesign:PackIcon
                                    Kind="BellOutline"
                                    Width="22"
                                    Height="22"/>

                            </Button>


                            <Border Width="18"
                                    Height="18"
                                    CornerRadius="9"
                                    Background="{DynamicResource Blueprint.Error}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="20,-2,0,0"
                                    Visibility="{Binding HasGuaranteeAlerts, Converter={StaticResource BooleanToVisibilityConverter}}">

                                <TextBlock
                                    Text="{Binding GuaranteeAlertCount}"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                            </Border>

                        </Grid>





                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"
                                Width="40"
                                Height="40"
                                Padding="0"
                                Margin="0,0,8,0"
                                Command="{Binding LockAppCommand}"
                                ToolTip="Khóa ứng dụng" AutomationProperties.Name="Khóa ứng dụng">

                            <materialDesign:PackIcon
                                Kind="LockOutline"
                                Width="22"
                                Height="22"/>

                        </Button>


                        <Separator
                            Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"
                            Background="{DynamicResource Blueprint.Outline}"
                            Margin="8,8,16,8"/>


                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"
                                Width="40"
                                Height="40"
                                Padding="0"
                                ToolTip="Thoát ứng dụng" AutomationProperties.Name="Thoát ứng dụng" Command="{Binding ExitAppCommand}">

                            <materialDesign:PackIcon
                                Kind="Power"
                                Width="22"
                                Height="22"/>

                        </Button>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- GUARANTEE POPUP                                   -->
            <!-- ================================================= -->

            <Popup x:Name="GuaranteeNotificationHost"
                   IsOpen="{Binding IsGuaranteeNotificationOpen, Mode=TwoWay}"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=GuaranteeNotificationButton}"
                   HorizontalOffset="-318"
                   VerticalOffset="18"
                   AllowsTransparency="True"
                   PopupAnimation="Fade"
                   StaysOpen="False">

                <views:GuaranteeNotificationPanel DataContext="{Binding}"/>

            </Popup>


            <!-- ================================================= -->
            <!-- USER GREETING SECTION                             -->
            <!-- ================================================= -->

            <StackPanel Grid.Row="1"
                        Margin="32,14,32,0">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <Grid Grid.Column="0"
                          Margin="0,0,24,0"
                          Width="56"
                          Height="56">

                        <Ellipse Fill="{DynamicResource Blueprint.SurfaceBright}">

                            <Ellipse.ToolTip>
                                <TextBlock Text="{Binding CurrentUser.FullName}"/>
                            </Ellipse.ToolTip>

                        </Ellipse>


                        <TextBlock
                            Text="{Binding UserInitial}"
                            FontSize="24"
                            FontWeight="Bold"
                            Foreground="{DynamicResource Blueprint.OnSurface}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding CurrentUser.AvatarPath, Converter={StaticResource NullToVisibilityConverter}}"/>


                        <Ellipse
                            Visibility="{Binding CurrentUser.AvatarPath, Converter={StaticResource NotNullToVisibilityConverter}}">

                            <Ellipse.Fill>

                                <ImageBrush
                                    ImageSource="{Binding CurrentUser.AvatarPath, Converter={StaticResource SafeImageSourceConverter}}"
                                    Stretch="UniformToFill"/>

                            </Ellipse.Fill>

                        </Ellipse>


                        <Border Width="16"
                                Height="16"
                                CornerRadius="8"
                                Background="{DynamicResource Status.Completed}"
                                BorderBrush="{DynamicResource Blueprint.SurfaceContainer}"
                                BorderThickness="2"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Right"
                                Margin="0,0,4,4"/>

                    </Grid>


                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock
                                Text="{Binding UserFullName, StringFormat='Xin chào, {0}'}"
                                FontSize="24"
                                FontWeight="Black"
                                Foreground="{DynamicResource Blueprint.OnSurface}"
                                FontFamily="{DynamicResource Blueprint.Font.Header}"/>

                            <TextBlock
                                Text=" 👋"
                                FontSize="22"
                                VerticalAlignment="Center"/>

                        </StackPanel>


                        <TextBlock
                            Text="Chọn phân hệ để bắt đầu làm việc"
                            FontSize="15"
                            Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"
                            Margin="0,8,0,0"/>

                    </StackPanel>

                </Grid>

            </StackPanel>


            <!-- ================================================= -->
            <!-- MODULE CARDS                                      -->
            <!-- ================================================= -->

            <ScrollViewer Grid.Row="2" Margin="24,8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
            <UniformGrid x:Name="ModuleCardsPanel" Columns="3" VerticalAlignment="Top">
                <Button Margin="8" Style="{StaticResource ModuleCardStyle}" Foreground="{DynamicResource Blueprint.Primary}" Command="{Binding SelectContractManagementCommand}" AutomationProperties.Name="Mở phân hệ Quản lý hợp đồng">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <Border Width="64" Height="64" HorizontalAlignment="Center" CornerRadius="12" Background="{DynamicResource Blueprint.ModuleContractContainer}" Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="FileDocumentMultipleOutline" Width="28" Height="28" Foreground="{DynamicResource Blueprint.Primary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Quản lý hợp đồng" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Blueprint.OnSurface}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,16"/>
                        </StackPanel>
                        <UniformGrid Grid.Row="1" Columns="1" Rows="3">                            <Grid Margin="0,6,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="FileDocumentEditOutline" Width="18" Height="18" Foreground="{DynamicResource Blueprint.Primary}" Margin="0,2,0,0" VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Hợp đồng &amp; phụ lục" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Blueprint.OnSurface}" TextWrapping="Wrap"/>
                                    <TextBlock Text="Theo dõi thông tin, giá trị và các phụ lục điều chỉnh." FontSize="12" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" TextWrapping="Wrap" LineHeight="18" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>                            <Grid Margin="0,6,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="CashMultiple" Width="18" Height="18" Foreground="{DynamicResource Blueprint.Primary}" Margin="0,2,0,0" VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Tạm ứng &amp; thanh toán" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Blueprint.OnSurface}" TextWrapping="Wrap"/>
                                    <TextBlock Text="Quản lý các đợt tạm ứng, thanh toán và đối soát." FontSize="12" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" TextWrapping="Wrap" LineHeight="18" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>                            <Grid Margin="0,6,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="18" Height="18" Foreground="{DynamicResource Blueprint.Primary}" Margin="0,2,0,0" VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Quyết toán &amp; bảo hành" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Blueprint.OnSurface}" TextWrapping="Wrap"/>
                                    <TextBlock Text="Theo dõi giá trị quyết toán, hạn bảo hành và chứng thư." FontSize="12" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" TextWrapping="Wrap" LineHeight="18" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>                        </UniformGrid>
                        <Border Grid.Row="2" Background="{DynamicResource Blueprint.ModuleContractContainer}" CornerRadius="8" Padding="12,10" Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="Mở phân hệ" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <materialDesign:PackIcon Kind="ArrowRight" Width="20" Height="20" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Button><Button Margin="8" Style="{StaticResource ModuleCardStyle}" Foreground="{DynamicResource Blueprint.ModuleAcceptanceAccent}" Command="{Binding SelectAcceptanceDocumentsCommand}" AutomationProperties.Name="Mở phân hệ Hồ sơ công trình">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <Border Width="64" Height="64" HorizontalAlignment="Center" CornerRadius="12" Background="{DynamicResource Blueprint.ModuleAcceptanceContainer}" Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="ClipboardCheckOutline" Width="28" Height="28" Foreground="{DynamicResource Blueprint.ModuleAcceptanceAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Hồ sơ công trình" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Blueprint.OnSurface}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,16"/>
                        </StackPanel>
                        <UniformGrid Grid.Row="1" Columns="1" Rows="3">                            <Grid Margin="0,6,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="FileDocumentOutline" Width="18" Height="18" Foreground="{DynamicResource Blueprint.ModuleAcceptanceAccent}" Margin="0,2,0,0" VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Hồ sơ pháp lý — HSPL" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Blueprint.OnSurface}" TextWrapping="Wrap"/>
                                    <TextBlock Text="Tạo hồ sơ pháp lý theo thông tin dự án và mẫu cấu hình." FontSize="12" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" TextWrapping="Wrap" LineHeight="18" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>                            <Grid Margin="0,6,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="ClipboardCheckOutline" Width="18" Height="18" Foreground="{DynamicResource Blueprint.ModuleAcceptanceAccent}" Margin="0,2,0,0" VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Hồ sơ chất lượng — CVXD, VTĐV" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Blueprint.OnSurface}" TextWrapping="Wrap"/>
                                    <TextBlock Text="Lập danh sách và tạo biên bản nghiệm thu CVXD, VTĐV." FontSize="12" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" TextWrapping="Wrap" LineHeight="18" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>                            <Grid Margin="0,6,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="FileDocumentMultipleOutline" Width="18" Height="18" Foreground="{DynamicResource Blueprint.ModuleAcceptanceAccent}" Margin="0,2,0,0" VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Các hồ sơ chất lượng khác" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Blueprint.OnSurface}" TextWrapping="Wrap"/>
                                    <TextBlock Text="Tạo các hồ sơ chất lượng theo mẫu HSCL cấu hình." FontSize="12" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" TextWrapping="Wrap" LineHeight="18" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>                        </UniformGrid>
                        <Border Grid.Row="2" Background="{DynamicResource Blueprint.ModuleAcceptanceContainer}" CornerRadius="8" Padding="12,10" Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="Mở phân hệ" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <materialDesign:PackIcon Kind="ArrowRight" Width="20" Height="20" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Button>
                <Button Margin="8" Style="{StaticResource ModuleCardStyle}" Foreground="{DynamicResource Blueprint.Primary}" Command="{Binding SelectConstructionDirectivesCommand}" AutomationProperties.Name="Mở phân hệ Quản lý chỉ thị">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel><Border Width="64" Height="64" HorizontalAlignment="Center" CornerRadius="12" Background="{DynamicResource Blueprint.ModuleContractContainer}" Margin="0,0,0,12"><materialDesign:PackIcon Kind="FileDocumentEditOutline" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Quản lý chỉ thị" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Blueprint.OnSurface}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,16"/></StackPanel>
                        <UniformGrid Grid.Row="1" Columns="1" Rows="3">
                            <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><materialDesign:PackIcon Kind="FileUploadOutline" Width="18" Height="18" Foreground="{DynamicResource Blueprint.Primary}" Margin="0,2,0,0" VerticalAlignment="Top"/><StackPanel Grid.Column="1"><TextBlock Text="Nhập và tự sắp xếp" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Blueprint.OnSurface}" TextWrapping="Wrap"/><TextBlock Text="Đọc số, tên từ file và lưu theo năm." FontSize="12" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" TextWrapping="Wrap" LineHeight="18" Margin="0,4,0,0"/></StackPanel></Grid>
                            <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><materialDesign:PackIcon Kind="FormatListBulleted" Width="18" Height="18" Foreground="{DynamicResource Blueprint.Primary}" Margin="0,2,0,0" VerticalAlignment="Top"/><StackPanel Grid.Column="1"><TextBlock Text="Theo dõi tập trung" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Blueprint.OnSurface}" TextWrapping="Wrap"/><TextBlock Text="Dùng chung cho mọi hợp đồng." FontSize="12" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" TextWrapping="Wrap" LineHeight="18" Margin="0,4,0,0"/></StackPanel></Grid>
                            <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" Foreground="{DynamicResource Blueprint.Primary}" Margin="0,2,0,0" VerticalAlignment="Top"/><StackPanel Grid.Column="1"><TextBlock Text="Tra cứu bản scan" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Blueprint.OnSurface}" TextWrapping="Wrap"/><TextBlock Text="Tìm theo số, tên hoặc công trình." FontSize="12" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" TextWrapping="Wrap" LineHeight="18" Margin="0,4,0,0"/></StackPanel></Grid>
                        </UniformGrid>
                        <Border Grid.Row="2" Background="{DynamicResource Blueprint.ModuleContractContainer}" CornerRadius="8" Padding="12,10" Margin="0,16,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="Mở phân hệ" FontSize="14" FontWeight="SemiBold" Margin="0,0,10,0"/><materialDesign:PackIcon Kind="ArrowRight" Width="20" Height="20"/></StackPanel></Border>
                    </Grid>
                </Button>
            </UniformGrid>
            </ScrollViewer>
            <Border Grid.Row="3"
                    Padding="0,0,0,16">

                <StackPanel HorizontalAlignment="Center">
                    <TextBlock
                        Text="{x:Static utilities:AppVersionInfo.VersionLabel}"
                        FontSize="11"
                        Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"
                        HorizontalAlignment="Center"
                        Margin="0,10,0,0"
                        Opacity="0.8"/>

                </StackPanel>

            </Border>


            <!-- ================================================= -->
            <!-- UPDATE HOST                                   -->
            <!-- ================================================= -->

            <updates:UpdateHostView
                x:Name="UpdateHost"
                Grid.Row="0"
                Grid.RowSpan="4"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,24,24"
                Panel.ZIndex="1000"/>

        </Grid>

    </Border>

</Window>
