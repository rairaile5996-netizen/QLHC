<Window x:Class="DocumentManagement.Views.WorkerImportGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Nạp danh sách công nhân" Width="600" Height="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="Button">
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="border" Property="Opacity" Value="0.7"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border CornerRadius="12" Background="{DynamicResource Blueprint.Surface}" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="1">
        <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.3"/></Border.Effect>
        <Grid Margin="28">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Nạp Danh Sách Công Nhân" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Blueprint.OnSurface}"/>
                <Button HorizontalAlignment="Right" Width="32" Height="32" Background="Transparent" BorderThickness="0" Click="Close_Click" Cursor="Hand" ToolTip="Đóng"><materialDesign:PackIcon Kind="Close" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" Width="20" Height="20"/></Button>
            </Grid>
            <Button Grid.Row="1" HorizontalAlignment="Left" Height="48" Background="#3B82F6" BorderThickness="0" Cursor="Hand" Click="DownloadTemplate_Click">
                <StackPanel Orientation="Horizontal" Margin="16,0"><materialDesign:PackIcon Kind="Download" Width="20" Height="20" Foreground="White" VerticalAlignment="Center"/><TextBlock Text="Tải file Excel mẫu" Foreground="White" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel>
            </Button>
            <Border Grid.Row="2" Background="{DynamicResource Blueprint.SurfaceContainer}" CornerRadius="8" Padding="20" Margin="0,20,0,20" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Hướng dẫn Import" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Blueprint.OnSurface}" Margin="0,0,0,12"/>
                    <TextBlock Text="Tạo file Excel với các cột theo thứ tự sau:" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" FontSize="13" Margin="0,0,0,12"/>
                    <Border BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid Grid.Row="0" Background="#3B82F6"><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="STT" Foreground="White" FontSize="11" Padding="6,7" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Họ và tên" Foreground="White" FontSize="11" Padding="6,7" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="Chức vụ / Nghề" Foreground="White" FontSize="11" Padding="6,7" FontWeight="SemiBold"/><TextBlock Grid.Column="3" Text="Ngày sinh" Foreground="White" FontSize="11" Padding="6,7" FontWeight="SemiBold"/></Grid>
                            <Grid Grid.Row="1" Background="{DynamicResource Blueprint.Surface}"><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="1" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" FontSize="11" Padding="6,7"/><TextBlock Grid.Column="1" Text="Nguyễn Văn A" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" FontSize="11" Padding="6,7"/><TextBlock Grid.Column="2" Text="Thợ điện" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" FontSize="11" Padding="6,7"/><TextBlock Grid.Column="3" Text="12/05/1995" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" FontSize="11" Padding="6,7"/></Grid>
                        </Grid>
                    </Border>
                    <TextBlock Text="• Dòng đầu tiên là tiêu đề cột; các dòng phía dưới là công nhân." Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" FontSize="12" Margin="0,0,0,5"/>
                    <TextBlock Text="• Ngày sinh sử dụng định dạng ngày/tháng/năm, ví dụ 12/05/1995." Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" FontSize="12"/>
                </StackPanel>
            </Border>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Đóng" Padding="24,11" Background="{DynamicResource Blueprint.SurfaceContainer}" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="1" Foreground="{DynamicResource Blueprint.OnSurface}" Click="Close_Click" Margin="0,0,12,0"/>
                <Button Padding="20,11" Background="#3B82F6" BorderThickness="0" Foreground="White" Click="ChooseFile_Click"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="MicrosoftExcel" Width="18" Height="18" Foreground="White" Margin="0,0,8,0"/><TextBlock Text="Chọn file Excel để nạp" FontWeight="SemiBold"/></StackPanel></Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
