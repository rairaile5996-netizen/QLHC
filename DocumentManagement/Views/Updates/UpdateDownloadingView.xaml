<UserControl x:Class="DocumentManagement.Views.Updates.UpdateDownloadingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid Margin="24,22,24,20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ICON -->
            <Border Width="52"
                    Height="52"
                    CornerRadius="12"
                    Background="{DynamicResource Blueprint.PrimaryContainer}"
                    BorderBrush="{DynamicResource Blueprint.Primary}"
                    BorderThickness="1"
                    VerticalAlignment="Top">

                <materialDesign:PackIcon
                    Kind="CloudDownloadOutline"
                    Width="26"
                    Height="26"
                    Foreground="{DynamicResource Blueprint.Primary}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>

            </Border>

            <!-- TITLE -->
            <StackPanel Grid.Column="1"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center">

                <TextBlock Text="ĐANG TẢI BẢN CẬP NHẬT"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Blueprint.Primary}"/>

                <TextBlock x:Name="TitleText"
                           FontFamily="{DynamicResource Blueprint.Font.Header}"
                           FontSize="19"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Blueprint.OnSurface}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"/>

            </StackPanel>

        </Grid>

        <!-- PROGRESS BAR -->
        <ProgressBar x:Name="ProgressBar"
                     Grid.Row="1"
                     Height="8"
                     Margin="0,20,0,10"
                     Minimum="0"
                     Maximum="100"
                     Foreground="{DynamicResource Blueprint.Primary}"/>

        <!-- DOWNLOAD DETAILS -->
        <TextBlock x:Name="DetailsText"
                   Grid.Row="2"
                   FontSize="12"
                   LineHeight="18"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"/>

        <!-- ACTION -->
        <Button Grid.Row="3"
                Content="Ẩn tiến trình"
                Click="Hide_Click"
                HorizontalAlignment="Right"
                Style="{StaticResource MaterialDesignFlatButton}"
                Foreground="{DynamicResource Blueprint.OnSurface}"
                Background="{DynamicResource Blueprint.SurfaceContainer}"
                BorderBrush="{DynamicResource Blueprint.Outline}"
                BorderThickness="1"
                Padding="16,7"
                Margin="0,14,0,0"
                materialDesign:ButtonAssist.CornerRadius="8"/>

    </Grid>

</UserControl>