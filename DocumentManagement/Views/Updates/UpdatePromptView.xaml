<UserControl x:Class="DocumentManagement.Views.Updates.UpdatePromptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Margin="28,24,20,18">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="32"/>
            </Grid.ColumnDefinitions>

            <!-- ICON -->
            <Border Width="52"
                    Height="52"
                    CornerRadius="12"
                    Background="{DynamicResource Blueprint.PrimaryContainer}"
                    BorderBrush="{DynamicResource Blueprint.Primary}"
                    BorderThickness="1"
                    VerticalAlignment="Top">

                <materialDesign:PackIcon
                    Kind="CloudDownloadOutline"
                    Width="26"
                    Height="26"
                    Foreground="{DynamicResource Blueprint.Primary}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>

            </Border>

            <!-- HEADER TEXT -->
            <StackPanel Grid.Column="1"
                        Margin="16,0,8,0">

                <TextBlock Text="BẢN CẬP NHẬT MỚI"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Blueprint.Primary}"/>

                <TextBlock Text="Có phiên bản mới"
                           FontFamily="{DynamicResource Blueprint.Font.Header}"
                           FontSize="19"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Blueprint.OnSurface}"
                           Margin="0,5,0,0"/>

                <TextBlock Text="Bạn có thể tiếp tục làm việc trong lúc tải."
                           FontSize="13"
                           Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"
                           Margin="0,3,0,0"
                           TextWrapping="Wrap"/>

            </StackPanel>

            <!-- CLOSE -->
            <Button Grid.Column="2"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Click="Later_Click"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    ToolTip="Đóng"
                    materialDesign:ButtonAssist.CornerRadius="8">

                <materialDesign:PackIcon
                    Kind="Close"
                    Width="18"
                    Height="18"/>

            </Button>

        </Grid>

        <!-- VERSION INFO -->
        <Border Grid.Row="1"
                Margin="28,0,28,16"
                Padding="14,10"
                CornerRadius="8"
                BorderBrush="{DynamicResource Blueprint.Outline}"
                BorderThickness="1">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <!-- CURRENT VERSION -->
                <StackPanel>

                    <TextBlock Text="HIỆN TẠI"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"/>

                    <TextBlock x:Name="CurrentVersionText"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"
                               Margin="0,2,0,0"/>

                </StackPanel>

                <!-- ARROW -->
                <materialDesign:PackIcon
                    Grid.Column="1"
                    Kind="ArrowRight"
                    Foreground="{DynamicResource Blueprint.Primary}"
                    Width="16"
                    Height="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>

                <!-- NEW VERSION -->
                <StackPanel Grid.Column="2">

                    <TextBlock Text="PHIÊN BẢN MỚI"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Blueprint.Primary}"/>

                    <TextBlock x:Name="NewVersionText"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Blueprint.Primary}"
                               Margin="0,2,0,0"/>

                </StackPanel>

                <!-- PACKAGE SIZE -->
                <StackPanel Grid.Column="3"
                            HorizontalAlignment="Right">

                    <TextBlock Text="DUNG LƯỢNG"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"
                               HorizontalAlignment="Right"/>

                    <TextBlock x:Name="PackageSizeText"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Blueprint.OnSurface}"
                               Margin="0,5,0,0"
                               HorizontalAlignment="Right"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- CHANGELOG -->
        <ScrollViewer Grid.Row="2"
                      Margin="28,0,28,12"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel>

                <TextBlock Text="CÓ GÌ MỚI"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"
                           Margin="0,0,0,9"/>

                <StackPanel x:Name="ChangesPanel"/>

            </StackPanel>

        </ScrollViewer>

        <!-- FOOTER -->
        <Border Grid.Row="3"
                Background="{DynamicResource Blueprint.SurfaceContainerHigh}"
                BorderBrush="{DynamicResource Blueprint.Outline}"
                BorderThickness="0,1,0,0"
                CornerRadius="0,0,16,16">

            <Grid Margin="20,10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- SECONDARY -->
                <Button Grid.Column="1"
                        Content="Để sau"
                        Click="Later_Click"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="{DynamicResource Blueprint.OnSurface}"
                        Background="{DynamicResource Blueprint.SurfaceContainer}"
                        BorderBrush="{DynamicResource Blueprint.Outline}"
                        BorderThickness="1"
                        Padding="18,4,18,4"
                        Margin="0,0,10,0"
                        materialDesign:ButtonAssist.CornerRadius="8"/>

                <!-- PRIMARY -->
                <Button Grid.Column="2"
                        Content="Tải bản cập nhật"
                        Click="Download_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="{DynamicResource Blueprint.Primary}"
                        Foreground="{DynamicResource Blueprint.OnPrimary}"
                        Padding="20,4,20,4"
                        materialDesign:ButtonAssist.CornerRadius="8"/>

            </Grid>

        </Border>

    </Grid>

</UserControl>