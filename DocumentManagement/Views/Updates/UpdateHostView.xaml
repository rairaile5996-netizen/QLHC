<UserControl x:Class="DocumentManagement.Views.Updates.UpdateHostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FontFamily="{DynamicResource Blueprint.Font.Body}"
             HorizontalAlignment="Right"
             VerticalAlignment="Bottom"
             Visibility="Collapsed">

    <Border x:Name="UpdateCard"
            Width="390"
            MaxWidth="560"
            Background="{DynamicResource Blueprint.Surface}"
            BorderBrush="{DynamicResource Blueprint.Outline}"
            BorderThickness="1"
            CornerRadius="16"
            ClipToBounds="True">

        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              ShadowDepth="4"
                              Opacity="0.30"
                              Color="#000000"/>
        </Border.Effect>


        <Grid>

            <!-- ================================================= -->
            <!-- FULL UPDATE VIEW                                  -->
            <!-- ================================================= -->

            <ContentControl x:Name="StateHost"/>


            <!-- ================================================= -->
            <!-- COMPACT UPDATE INDICATOR                          -->
            <!-- ================================================= -->

            <Button x:Name="IndicatorButton"
                    Click="IndicatorButton_Click"
                    Width="292"
                    Height="64"
                    Margin="12,10"
                    Padding="12,7"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Blueprint.SurfaceContainerHigh}"
                    Foreground="{DynamicResource Blueprint.OnSurface}"
                    BorderBrush="{DynamicResource Blueprint.Outline}"
                    BorderThickness="1"
                    Visibility="Collapsed"
                    ToolTip="Mở trạng thái cập nhật"
                    Cursor="Hand">

                <Button.Template>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">

                            <ContentPresenter
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Margin="{TemplateBinding Padding}"/>

                        </Border>


                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.92"/>

                            </Trigger>


                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.78"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Button.Template>


                <Grid IsHitTestVisible="False">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <!-- ========================================= -->
                    <!-- HEADER                                    -->
                    <!-- ========================================= -->

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="24"/>
                        </Grid.ColumnDefinitions>


                        <!-- ===================================== -->
                        <!-- ICON AREA                             -->
                        <!-- ===================================== -->

                        <Grid Grid.Column="0"
                              Width="28"
                              Height="28">


                            <!-- DOWNLOAD ICON -->
                            <Border x:Name="IndicatorDownloadIconBorder"
                                    Width="28"
                                    Height="28"
                                    CornerRadius="8"
                                    Background="{DynamicResource Blueprint.PrimaryContainer}">

                                <materialDesign:PackIcon
                                    Kind="DownloadCircleOutline"
                                    Width="17"
                                    Height="17"
                                    Foreground="{DynamicResource Blueprint.Primary}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                            </Border>


                            <!-- READY ICON -->
                            <Border x:Name="IndicatorReadyIconBorder"
                                    Width="28"
                                    Height="28"
                                    CornerRadius="8"
                                    Background="{DynamicResource Blueprint.SuccessContainer}"
                                    Visibility="Collapsed">

                                <materialDesign:PackIcon
                                    Kind="CheckCircleOutline"
                                    Width="17"
                                    Height="17"
                                    Foreground="{DynamicResource Blueprint.OnSuccessContainer}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                            </Border>

                        </Grid>


                        <!-- TITLE -->
                        <TextBlock x:Name="IndicatorTitleText"
                                   Grid.Column="1"
                                   Text="Đang tải bản cập nhật"
                                   FontFamily="{DynamicResource Blueprint.Font.Header}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="8,0,8,0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Blueprint.OnSurface}"/>


                        <!-- DOWNLOAD PERCENT -->
                        <TextBlock x:Name="IndicatorPercentText"
                                   Grid.Column="2"
                                   Text="0%"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Blueprint.Primary}"/>


                        <!-- EXPAND -->
                        <materialDesign:PackIcon
                            Grid.Column="3"
                            Kind="ChevronUp"
                            Width="17"
                            Height="17"
                            Margin="7,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"/>

                    </Grid>


                    <!-- ========================================= -->
                    <!-- DETAILS                                   -->
                    <!-- ========================================= -->

                    <TextBlock x:Name="IndicatorDetailsText"
                               Grid.Row="1"
                               Text="Đang chuẩn bị tải..."
                               FontSize="10"
                               Margin="38,1,0,3"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"/>


                    <!-- ========================================= -->
                    <!-- DOWNLOAD PROGRESS                         -->
                    <!-- ========================================= -->

                    <ProgressBar x:Name="IndicatorProgressBar"
                                 Grid.Row="2"
                                 Height="4"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Foreground="{DynamicResource Blueprint.Primary}"/>

                </Grid>

            </Button>

        </Grid>

    </Border>

</UserControl>