<UserControl x:Class="DocumentManagement.Views.DocumentListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:DocumentManagement.Converters"
             xmlns:local="clr-namespace:DocumentManagement.Views"
             xmlns:utilities="clr-namespace:DocumentManagement.Utilities"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="360"
             FontFamily="Inter, Segoe UI">
    <UserControl.Resources>
        <Style x:Key="LocalFilterChipStyle" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ChipBorder" 
                                Background="Transparent"
                                BorderBrush="{Binding BorderColor}"
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="2,6" 
                                Cursor="Hand">
                            <TextBlock x:Name="ChipText" 
                                       Text="{TemplateBinding Content}" 
                                       FontSize="10.5" 
                                       Foreground="{Binding TextSecondaryColor}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="#3B82F6"/>
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="ChipText" Property="Foreground" Value="White"/>
                                <Setter TargetName="ChipText" Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{Binding CardBackgroundColor}" CornerRadius="16" Margin="0,0,20,0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.08"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Search & Sort -->
                <RowDefinition Height="Auto"/> <!-- Quick Filters -->
                <RowDefinition Height="*"/>    <!-- List -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Header với tiêu đề và số lượng -->
            <Border Grid.Row="0" Padding="20,16,20,12" BorderBrush="{Binding BorderColor}" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FileDocumentMultipleOutline" Width="20" Height="20" Foreground="#3B82F6" VerticalAlignment="Center"/>
                        <TextBlock Text="Danh sách hợp đồng" FontFamily="{DynamicResource Blueprint.Font.Header}" FontSize="14" FontWeight="SemiBold" Foreground="{Binding TextPrimaryColor}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border Background="{DynamicResource Blueprint.PrimaryContainer}" CornerRadius="10" Padding="8,4" HorizontalAlignment="Right">
                        <TextBlock Foreground="{DynamicResource Blueprint.OnPrimaryContainer}" FontSize="11" FontWeight="SemiBold">
                                    <Run Text="{Binding FilteredDocuments.Count, Mode=OneWay}"/>
                                    <Run Text="hồ sơ"/>
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>

            <!-- Search và Sort -->
            <Grid Grid.Row="1" Margin="16,12,16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{Binding BackgroundColor}" CornerRadius="10" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="Magnify" Foreground="{Binding TextSecondaryColor}" Width="18" Height="18" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Tìm hợp đồng..." Margin="8,0,0,0" FontSize="12" Foreground="{Binding TextSecondaryColor}" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox AutomationProperties.Name="Tìm hợp đồng theo số hợp đồng, dự án hoặc hạng mục" ToolTip="Tìm theo số hợp đồng, tên dự án hoặc hạng mục" x:Name="SearchBox" Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="{Binding TextPrimaryColor}" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="CaretBrush" Value="{Binding TextPrimaryColor}"/>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                </Border>
                <!-- Sort Button with Popup -->
                <Grid Grid.Column="1" Margin="8,0,0,0">
                    <Button x:Name="SortButton" Background="{Binding BackgroundColor}" BorderThickness="0" Padding="8,0" Height="36" MaxWidth="154" Cursor="Hand"
                                    ToolTip="{Binding CurrentSortName}" Click="SortButton_Click" AutomationProperties.Name="{Binding CurrentSortName}">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Sort" Width="16" Height="16" Foreground="{Binding TextSecondaryColor}" VerticalAlignment="Center"/><TextBlock Text="{Binding CurrentSortName}" FontSize="10" Foreground="{Binding TextPrimaryColor}" Margin="5,0,0,0" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Popup x:Name="SortPopup" StaysOpen="False" Placement="Bottom" PlacementTarget="{Binding ElementName=SortButton}" 
                                   VerticalOffset="4" HorizontalOffset="-100" AllowsTransparency="True">
                        <Border Background="{Binding ContextMenuBackground}" BorderBrush="{Binding ContextMenuBorder}" BorderThickness="1" CornerRadius="10" Padding="4">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.2"/>
                            </Border.Effect>
                            <StackPanel MinWidth="160">
                                <RadioButton Content="Số HĐ (A-Z)" GroupName="Sort" IsChecked="{Binding SelectedSortIndex, Converter={StaticResource SortIndexConverter}, ConverterParameter=0}" 
                                                     Style="{StaticResource MaterialDesignRadioButton}" Foreground="{Binding TextPrimaryColor}" Margin="8,6" Cursor="Hand"/>
                                <RadioButton Content="Số HĐ (Z-A)" GroupName="Sort" IsChecked="{Binding SelectedSortIndex, Converter={StaticResource SortIndexConverter}, ConverterParameter=1}"
                                                     Style="{StaticResource MaterialDesignRadioButton}" Foreground="{Binding TextPrimaryColor}" Margin="8,6" Cursor="Hand"/>
                                <Border Height="1" Background="{Binding ContextMenuBorder}" Margin="8,4"/>
                                <RadioButton Content="Ngày ký (Mới nhất)" GroupName="Sort" IsChecked="{Binding SelectedSortIndex, Converter={StaticResource SortIndexConverter}, ConverterParameter=2}"
                                                     Style="{StaticResource MaterialDesignRadioButton}" Foreground="{Binding TextPrimaryColor}" Margin="8,6" Cursor="Hand"/>
                                <RadioButton Content="Ngày ký (Cũ nhất)" GroupName="Sort" IsChecked="{Binding SelectedSortIndex, Converter={StaticResource SortIndexConverter}, ConverterParameter=3}"
                                                     Style="{StaticResource MaterialDesignRadioButton}" Foreground="{Binding TextPrimaryColor}" Margin="8,6" Cursor="Hand"/>
                                <Border Height="1" Background="{Binding ContextMenuBorder}" Margin="8,4"/>
                                <RadioButton Content="Giá trị (Cao nhất)" GroupName="Sort" IsChecked="{Binding SelectedSortIndex, Converter={StaticResource SortIndexConverter}, ConverterParameter=4}"
                                                     Style="{StaticResource MaterialDesignRadioButton}" Foreground="{Binding TextPrimaryColor}" Margin="8,6" Cursor="Hand"/>
                                <RadioButton Content="Giá trị (Thấp nhất)" GroupName="Sort" IsChecked="{Binding SelectedSortIndex, Converter={StaticResource SortIndexConverter}, ConverterParameter=5}"
                                                     Style="{StaticResource MaterialDesignRadioButton}" Foreground="{Binding TextPrimaryColor}" Margin="8,6" Cursor="Hand"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Grid>

            <!-- Quick Filters (Chips) - Compact Version -->
            <StackPanel Grid.Row="2" Margin="16,0,16,16">
                <TextBlock Text="LỌC THEO TRẠNG THÁI" FontSize="9" FontWeight="Bold" Foreground="{Binding TextSecondaryColor}" Margin="4,0,0,6" Opacity="0.7"/>
                <UniformGrid Columns="3">
                    <RadioButton Style="{StaticResource LocalFilterChipStyle}" Content="Tất cả" 
                                 IsChecked="{Binding SelectedQuickFilterIndex, Converter={StaticResource SortIndexConverter}, ConverterParameter=0}"/>
                    <RadioButton Style="{StaticResource LocalFilterChipStyle}" Content="Đang thực hiện" Margin="4,0"
                                 IsChecked="{Binding SelectedQuickFilterIndex, Converter={StaticResource SortIndexConverter}, ConverterParameter=1}"/>
                    <RadioButton Style="{StaticResource LocalFilterChipStyle}" Content="Hoàn thành" 
                                 IsChecked="{Binding SelectedQuickFilterIndex, Converter={StaticResource SortIndexConverter}, ConverterParameter=2}"/>
                </UniformGrid>
            </StackPanel>

            <Grid Grid.Row="3">
                <Grid>
                    <!-- Skeleton Loading -->
                    <StackPanel Visibility="{Binding IsLoadingDocuments, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="8,0,8,0">
                        <Border Margin="8,4" Padding="12" CornerRadius="8" Background="{Binding BackgroundColor}">
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard Storyboard="{StaticResource SkeletonShimmer}"/>
                                </EventTrigger>
                            </Border.Triggers>
                            <StackPanel>
                                <Grid>
                                    <Border Background="{Binding BorderColor}" CornerRadius="4" Width="120" Height="16" HorizontalAlignment="Left"/>
                                    <Border Background="{Binding BorderColor}" CornerRadius="4" Width="70" Height="12" HorizontalAlignment="Right"/>
                                </Grid>
                                <Border Background="{Binding BorderColor}" CornerRadius="4" Width="200" Height="14" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                                <Border Background="{Binding BorderColor}" CornerRadius="4" Width="150" Height="12" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                                <Border Background="{Binding BorderColor}" CornerRadius="4" Width="100" Height="14" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Margin="8,4" Padding="12" CornerRadius="8" Background="{Binding BackgroundColor}">
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard Storyboard="{StaticResource SkeletonShimmer}"/>
                                </EventTrigger>
                            </Border.Triggers>
                            <StackPanel>
                                <Grid>
                                    <Border Background="{Binding BorderColor}" CornerRadius="4" Width="140" Height="16" HorizontalAlignment="Left"/>
                                    <Border Background="{Binding BorderColor}" CornerRadius="4" Width="70" Height="12" HorizontalAlignment="Right"/>
                                </Grid>
                                <Border Background="{Binding BorderColor}" CornerRadius="4" Width="180" Height="14" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                                <Border Background="{Binding BorderColor}" CornerRadius="4" Width="130" Height="12" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                                <Border Background="{Binding BorderColor}" CornerRadius="4" Width="90" Height="14" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Margin="8,4" Padding="12" CornerRadius="8" Background="{Binding BackgroundColor}">
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard Storyboard="{StaticResource SkeletonShimmer}"/>
                                </EventTrigger>
                            </Border.Triggers>
                            <StackPanel>
                                <Grid>
                                    <Border Background="{Binding BorderColor}" CornerRadius="4" Width="110" Height="16" HorizontalAlignment="Left"/>
                                    <Border Background="{Binding BorderColor}" CornerRadius="4" Width="70" Height="12" HorizontalAlignment="Right"/>
                                </Grid>
                                <Border Background="{Binding BorderColor}" CornerRadius="4" Width="220" Height="14" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                                <Border Background="{Binding BorderColor}" CornerRadius="4" Width="160" Height="12" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                                <Border Background="{Binding BorderColor}" CornerRadius="4" Width="110" Height="14" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    
                    <!-- Actual Document List with Virtualization -->
                    <ListBox ItemsSource="{Binding FilteredDocuments}" Margin="8,0,8,0"
                                     Visibility="{Binding IsLoadingDocuments, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                     Background="Transparent" BorderThickness="0"
                                     VirtualizingStackPanel.IsVirtualizing="True"
                                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.CanContentScroll="True"
                                     SelectedItem="{Binding SelectedDocument, Mode=TwoWay}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="ItemBorder" Margin="8,6" Padding="12" CornerRadius="10" Cursor="Hand" 
                                        Background="{Binding DataContext.BackgroundColor, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                        BorderThickness="1" BorderBrush="{Binding DataContext.BorderColor, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                    <Border.ToolTip>
                                        <ToolTip Background="{Binding DataContext.CardBackgroundColor, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                                 BorderBrush="{Binding DataContext.BorderColor, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                                 BorderThickness="1" Padding="12">
                                            <StackPanel MaxWidth="300">
                                                <TextBlock Text="{Binding ContractNumber}" Foreground="{Binding DataContext.TextPrimaryColor, RelativeSource={RelativeSource AncestorType=ListBox}}" FontSize="14" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding ProjectName}" Foreground="{Binding DataContext.TextSecondaryColor, RelativeSource={RelativeSource AncestorType=ListBox}}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding ItemName}" Foreground="{Binding DataContext.TextSecondaryColor, RelativeSource={RelativeSource AncestorType=ListBox}}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                <Border Height="1" Background="{Binding DataContext.BorderColor, RelativeSource={RelativeSource AncestorType=ListBox}}" Margin="0,8"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Ngày ký" Foreground="{Binding DataContext.TextSecondaryColor, RelativeSource={RelativeSource AncestorType=ListBox}}" FontSize="10"/>
                                                        <TextBlock Text="{Binding SignDate, StringFormat='{}{0:dd/MM/yyyy}'}" Foreground="{Binding DataContext.TextPrimaryColor, RelativeSource={RelativeSource AncestorType=ListBox}}" FontSize="11"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="Giá trị HĐ" Foreground="{Binding DataContext.TextSecondaryColor, RelativeSource={RelativeSource AncestorType=ListBox}}" FontSize="10"/>
                                                        <TextBlock Text="{Binding ContractValue, StringFormat='{}{0:N0} đ'}" Foreground="{Binding DataContext.TextPrimaryColor, RelativeSource={RelativeSource AncestorType=ListBox}}" FontSize="11"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Giá trị phụ lục" Foreground="{Binding DataContext.TextSecondaryColor, RelativeSource={RelativeSource AncestorType=ListBox}}" FontSize="10"/>
                                                        <TextBlock Text="{Binding TotalAppendixValue, StringFormat='{}{0:N0} đ'}" Foreground="{DynamicResource Blueprint.Warning}" FontSize="11"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="Tổng giá trị" Foreground="{Binding DataContext.TextSecondaryColor, RelativeSource={RelativeSource AncestorType=ListBox}}" FontSize="10"/>
                                                        <TextBlock Text="{Binding TotalValue, StringFormat='{}{0:N0} đ'}" Foreground="{DynamicResource Blueprint.Primary}" FontSize="11" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Text="Click để xem chi tiết • Ctrl+E để sửa" Foreground="{Binding DataContext.TextSecondaryColor, RelativeSource={RelativeSource AncestorType=ListBox}}" FontSize="10" Margin="0,8,0,0" FontStyle="Italic"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </Border.ToolTip>
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.SelectDocumentCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <StackPanel>
                                        <!-- Header: Number & Date -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="ContractNumberText" Grid.Column="0" Text="{Binding ContractNumber}" 
                                                       Foreground="{Binding DataContext.TextPrimaryColor, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                                       FontSize="12" FontWeight="Bold" 
                                                       TextWrapping="Wrap" Margin="0,0,8,0"/>
                                            <TextBlock x:Name="SignDateText" Grid.Column="1" Text="{Binding SignDate, StringFormat='{}{0:dd/MM/yyyy}'}" 
                                                       Foreground="{Binding DataContext.TextSecondaryColor, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                                       FontSize="11" VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Details -->
                                        <TextBlock x:Name="ProjectNameText" Text="{Binding ProjectName}" Foreground="{Binding DataContext.TextSecondaryColor, RelativeSource={RelativeSource AncestorType=ListBox}}" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="ItemNameText" Text="{Binding ItemName}" Foreground="{Binding DataContext.TextSecondaryColor, RelativeSource={RelativeSource AncestorType=ListBox}}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        
                                        <!-- Contract and appendix values -->
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Giá trị hợp đồng" Foreground="{Binding DataContext.TextSecondaryColor, RelativeSource={RelativeSource AncestorType=ListBox}}" FontSize="10"/>
                                                <TextBlock Text="{Binding ContractValue, StringFormat='{}{0:N0} đ'}" Foreground="{Binding DataContext.TextPrimaryColor, RelativeSource={RelativeSource AncestorType=ListBox}}" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Giá trị phụ lục" Foreground="{Binding DataContext.TextSecondaryColor, RelativeSource={RelativeSource AncestorType=ListBox}}" FontSize="10"/>
                                                <TextBlock Text="{Binding TotalAppendixValue, StringFormat='{}{0:N0} đ'}" Foreground="{DynamicResource Blueprint.Warning}" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Grid>
                                        <!-- Status Section -->
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="LabelStatusText" Grid.Column="0" Text="Tình trạng" 
                                                       Foreground="{Binding DataContext.TextSecondaryColor, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                                       FontSize="11" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Border Visibility="{Binding IsFolderMissing, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        Background="{DynamicResource Blueprint.WarningContainer}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="FolderAlert" Width="10" Height="10" Foreground="{DynamicResource Blueprint.OnWarningContainer}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Thiếu thư mục" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Blueprint.OnWarningContainer}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Completed -->
                                                <Border Visibility="{Binding IsCompleted, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        Background="{DynamicResource Blueprint.SuccessContainer}" CornerRadius="4" Padding="6,2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="CheckCircle" Width="10" Height="10" Foreground="{DynamicResource Blueprint.OnSuccessContainer}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Đã hoàn thành" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Blueprint.OnSuccessContainer}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Incomplete -->
                                                <Border Visibility="{Binding IsCompleted, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                                        Background="{DynamicResource Blueprint.ErrorContainer}" CornerRadius="4" Padding="6,2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="ClockOutline" Width="10" Height="10" Foreground="{DynamicResource Blueprint.OnErrorContainer}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Chưa hoàn thành" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Blueprint.OnErrorContainer}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Blueprint.SelectionStrong}"/>
                                        <Setter TargetName="ItemBorder" Property="BorderThickness" Value="2"/>
                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Blueprint.Selection}"/>
                                        <Setter TargetName="ItemBorder" Property="Opacity" Value="1"/>
                                        <Setter TargetName="ItemBorder" Property="Margin" Value="6,4"/>
                                        <Setter TargetName="ContractNumberText" Property="Foreground" Value="{DynamicResource Blueprint.OnSurface}"/>
                                        <Setter TargetName="SignDateText" Property="Foreground" Value="{DynamicResource Blueprint.OnPrimaryContainer}"/>
                                        <Setter TargetName="ProjectNameText" Property="Foreground" Value="{DynamicResource Blueprint.OnSurface}"/>
                                        <Setter TargetName="ItemNameText" Property="Foreground" Value="{DynamicResource Blueprint.OnSurfaceVariant}"/>
                                        <Setter TargetName="LabelStatusText" Property="Foreground" Value="{DynamicResource Blueprint.OnPrimaryContainer}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="False">
                                        <Setter TargetName="ItemBorder" Property="Opacity" Value="0.85"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                    <!-- Empty state uses existing collection/filter state only. -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding FilteredDocuments.Count}" Value="0"/>
                                            <Condition Binding="{Binding IsLoadingDocuments}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <materialDesign:PackIcon Kind="FileSearchOutline" Width="48" Height="48" Foreground="{Binding TextSecondaryColor}" HorizontalAlignment="Center"/>
                        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{Binding TextPrimaryColor}" Margin="0,12,0,6" TextAlignment="Center" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Không có hồ sơ phù hợp"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedQuickFilterIndex}" Value="1"><Setter Property="Text" Value="Không có hồ sơ đang thực hiện"/></DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedQuickFilterIndex}" Value="2"><Setter Property="Text" Value="Không có hồ sơ đã hoàn thành"/></DataTrigger>
                                        <DataTrigger Binding="{Binding IsSearchActive}" Value="True"><Setter Property="Text" Value="Không tìm thấy hồ sơ"/></DataTrigger>
                                        <DataTrigger Binding="{Binding Documents.Count}" Value="0"><Setter Property="Text" Value="Chưa có hồ sơ nào"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="{Binding TextSecondaryColor}" TextAlignment="Center" MaxWidth="280" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Chọn Tất cả để xem các hồ sơ khác."/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSearchActive}" Value="True"><Setter Property="Text" Value="Thử từ khóa khác hoặc chọn Tất cả trong bộ lọc trạng thái."/></DataTrigger>
                                        <DataTrigger Binding="{Binding Documents.Count}" Value="0"><Setter Property="Text" Value="Thêm hồ sơ đầu tiên hoặc quét thư mục để bắt đầu."/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Content="+ Thêm hồ sơ" Margin="0,16,0,0" Command="{Binding OpenAddDialogCommand}" Background="{DynamicResource Blueprint.Primary}" Foreground="{DynamicResource Blueprint.OnPrimary}" Padding="16,10">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding Documents.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
            <Border Grid.Row="4" BorderBrush="{Binding BorderColor}" BorderThickness="0,1,0,0" Padding="12,14,12,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- User Avatar + Menu -->
                    <Grid Grid.Column="0">
                        <ToggleButton x:Name="UserMenuToggle" 
                                      IsChecked="{Binding IsUserMenuOpen, Mode=TwoWay}"
                                      Background="Transparent" BorderThickness="0" Padding="4" Cursor="Hand" HorizontalAlignment="Left">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="8">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="36" Height="36" Fill="#3B82F6" VerticalAlignment="Center">
                                    <Ellipse.ToolTip>
                                        <TextBlock Text="{Binding CurrentUser.FullName}"/>
                                    </Ellipse.ToolTip>
                                </Ellipse>
                                <Grid Margin="-36,0,0,0" Width="36" Height="36" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding UserInitial}" Foreground="White" FontSize="14" FontWeight="Bold" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding CurrentUser.AvatarPath, Converter={StaticResource NullToVisibilityConverter}}"/>
                                    <Ellipse Visibility="{Binding CurrentUser.AvatarPath, Converter={StaticResource NotNullToVisibilityConverter}}">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding CurrentUser.AvatarPath, Converter={StaticResource SafeImageSourceConverter}}" Stretch="UniformToFill"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </Grid>
                                <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding CurrentUser.FullName, TargetNullValue='Người dùng', FallbackValue='Người dùng'}" 
                                               FontFamily="{DynamicResource Blueprint.Font.Header}"
                                               Foreground="{Binding TextPrimaryColor}" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="Nhấn để cài đặt" Foreground="{Binding TextSecondaryColor}" FontSize="11"/>
                                </StackPanel>
                                <materialDesign:PackIcon Kind="ChevronUp" Width="16" Height="16" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{Binding TextSecondaryColor}"/>
                            </StackPanel>
                        </ToggleButton>
                        
                        <Popup x:Name="UserMenuPopup" IsOpen="{Binding IsUserMenuOpen}" StaysOpen="False" Placement="Top" PlacementTarget="{Binding ElementName=UserMenuToggle}" VerticalOffset="-8" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="{Binding CardBackgroundColor}" CornerRadius="12" Padding="8" MinWidth="240" BorderBrush="{Binding BorderColor}" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.25"/>
                                </Border.Effect>
                                <StackPanel>
                                     <Button Command="{Binding OpenUserProfileCommand}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Padding="12,10" Foreground="{Binding TextPrimaryColor}">
                                         <Button.Style>
                                             <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                                 <Setter Property="Height" Value="Auto"/>
                                             </Style>
                                         </Button.Style>
                                         <StackPanel Orientation="Horizontal">
                                             <materialDesign:PackIcon Kind="AccountCircle" Width="18" Height="18" Foreground="{Binding TextSecondaryColor}" VerticalAlignment="Center"/>
                                             <TextBlock Text="Thông tin tài khoản" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                         </StackPanel>
                                     </Button>
                                     <Border Height="1" Background="{Binding BorderColor}" Margin="4,4"/>
                                     <Button Command="{Binding LogoutCommand}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Padding="12,10" Foreground="#EF4444">
                                         <Button.Style>
                                             <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                                 <Setter Property="Height" Value="Auto"/>
                                             </Style>
                                         </Button.Style>
                                         <StackPanel Orientation="Horizontal">
                                             <materialDesign:PackIcon Kind="Logout" Width="18" Height="18" Foreground="#EF4444" VerticalAlignment="Center"/>
                                             <TextBlock Text="Đăng xuất" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                         </StackPanel>
                                     </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                    
                    <!-- Settings Button -->
                    <!-- Settings Button -->
                    <Grid Grid.Column="1">
                        <ToggleButton x:Name="SettingsToggle" 
                                      IsChecked="{Binding IsSettingsOpen, Mode=TwoWay}"
                                      Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" Width="36" Height="36" AutomationProperties.Name="Cài đặt danh sách" ToolTip="Cài đặt danh sách">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                            <materialDesign:PackIcon Kind="Cog" Width="18" Height="18" Foreground="{Binding TextSecondaryColor}"/>
                        </ToggleButton>

                        <Popup x:Name="SettingsPopup" IsOpen="{Binding IsSettingsOpen}" StaysOpen="False" 
                               Placement="Top" PlacementTarget="{Binding ElementName=SettingsToggle}" 
                               VerticalOffset="-8" HorizontalOffset="-292"
                               AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="{Binding CardBackgroundColor}" CornerRadius="16" Padding="24" Width="340" MaxHeight="700" BorderBrush="{Binding BorderColor}" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.25"/>
                                </Border.Effect>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock Text="Giao diện" FontSize="14" FontWeight="SemiBold" Foreground="{Binding TextPrimaryColor}" Margin="0,0,0,12"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border Width="55" Height="38" CornerRadius="8" Background="#F1F5F9" BorderThickness="2" Cursor="Hand" Margin="0,0,8,0"
                                                BorderBrush="{Binding LightThemeBorderColor}">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" Command="{Binding SetThemeCommand}" CommandParameter="Light"/>
                                            </Border.InputBindings>
                                            <materialDesign:PackIcon Kind="WhiteBalanceSunny" Width="18" Height="18" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Width="55" Height="38" CornerRadius="8" Background="#1E293B" BorderThickness="2" Cursor="Hand"
                                                BorderBrush="{Binding DarkThemeBorderColor}">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" Command="{Binding SetThemeCommand}" CommandParameter="Dark"/>
                                            </Border.InputBindings>
                                            <materialDesign:PackIcon Kind="MoonWaningCrescent" Width="18" Height="18" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock FontSize="11" Foreground="{Binding TextSecondaryColor}" Margin="0,0,0,16">
                                        <Run Text="Hiện tại: "/><Run Text="{Binding CurrentThemeName, Mode=OneWay}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                    
                                    <!-- Đường dẫn lưu hồ sơ -->
                                    <TextBlock Text="Thư mục lưu hồ sơ" FontSize="14" FontWeight="SemiBold" Foreground="{Binding TextPrimaryColor}" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding BaseFolderPath, UpdateSourceTrigger=PropertyChanged}" 
                                                 Background="{Binding BackgroundColor}" 
                                                 Foreground="{Binding TextPrimaryColor}" 
                                                 BorderBrush="{Binding BorderColor}" 
                                                 BorderThickness="1" 
                                                 Padding="8,6" 
                                                 FontSize="12"
                                                 IsReadOnly="True"
                                                 VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Width="36" Height="36" Padding="0" Margin="8,0,0,0" 
                                                Background="{Binding BackgroundColor}" BorderThickness="1" BorderBrush="{Binding BorderColor}"
                                                Command="{Binding BrowseFolderCommand}" ToolTip="Chọn thư mục" AutomationProperties.Name="Chọn thư mục">
                                            <materialDesign:PackIcon Kind="FolderOpen" Width="18" Height="18" Foreground="{Binding TextSecondaryColor}"/>
                                        </Button>
                                    </Grid>
                                    
                                    <!-- AI Settings Provider Selection -->
                                    <TextBlock Text="Cài đặt AI" FontSize="14" FontWeight="SemiBold" Foreground="{Binding TextPrimaryColor}" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <RadioButton Content="Gemini" IsChecked="{Binding SelectedAIProvider, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Gemini}" 
                                                     Foreground="{Binding TextPrimaryColor}" FontSize="12" Margin="0,0,16,0"/>
                                        <RadioButton Content="Groq" IsChecked="{Binding SelectedAIProvider, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Groq}" 
                                                     Foreground="{Binding TextPrimaryColor}" FontSize="12"/>
                                        <RadioButton Content="Ollama (offline)" IsChecked="{Binding SelectedAIProvider, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Ollama}" 
                                                     Foreground="{Binding TextPrimaryColor}" FontSize="12" Margin="16,0,0,0"/>
                                    </StackPanel>

                                    
                                    <TextBlock Text="{Binding SelectedAIProvider, StringFormat='{}{0} API Keys'}" FontSize="13" FontWeight="SemiBold" Foreground="{Binding TextSecondaryColor}" Margin="0,4,0,8"/>
                                    
                                    <!-- Hiển thị danh sách key: STT, TÊN, KEY -->
                                    <Border Background="{Binding BackgroundColor}" BorderBrush="{Binding BorderColor}" BorderThickness="1" CornerRadius="4" Padding="8" MaxHeight="100" Margin="0,0,0,8">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding CurrentApiKeyList}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                 <ColumnDefinition Width="25"/>
                                                                 <ColumnDefinition Width="60"/>
                                                                 <ColumnDefinition Width="*"/>
                                                             </Grid.ColumnDefinitions>
                                                             <TextBlock Grid.Column="0" Text="{Binding Index}" FontSize="11" Foreground="{Binding DataContext.TextSecondaryColor, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                             <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="#F59E0B"/>
                                                             <TextBlock Grid.Column="2" Text="{Binding MaskedKey}" FontSize="11" Foreground="{Binding DataContext.TextSecondaryColor, RelativeSource={RelativeSource AncestorType=ItemsControl}}" FontFamily="Consolas"/>
                                                         </Grid>
                                                     </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                    <TextBlock Text="{Binding CurrentApiKeyCount, StringFormat='Tổng: {0} key'}" FontSize="10" Foreground="{Binding TextSecondaryColor}" Margin="0,0,0,8"/>
                                    
                                    <!-- Import CSV + Clear -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Button Background="#3B82F6" utilities:ButtonVisuals.HoverBackground="{DynamicResource Blueprint.PrimaryHover}" utilities:ButtonVisuals.PressedBackground="{DynamicResource Blueprint.PrimaryPressed}" Foreground="White" Height="32" Padding="12,0" 
                                                BorderThickness="0" materialDesign:ButtonAssist.CornerRadius="6"
                                                Command="{Binding ImportApiKeyCsvCommand}" ToolTip="Import file CSV (TÊN,KEY)" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="FileImport" Width="16" Height="16" VerticalAlignment="Center"/>
                                                <TextBlock Text="Import CSV" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Background="#EF4444" utilities:ButtonVisuals.HoverBackground="#BE123C" utilities:ButtonVisuals.PressedBackground="#9F1239" Foreground="White" Height="32" Padding="12,0" Margin="8,0,0,0"
                                                BorderThickness="0" materialDesign:ButtonAssist.CornerRadius="6"
                                                Command="{Binding ClearAllApiKeysCommand}" ToolTip="Xóa tất cả API key" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="DeleteForever" Width="16" Height="16" VerticalAlignment="Center"/>
                                                <TextBlock Text="Xóa hết" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock FontSize="10" Foreground="{Binding TextSecondaryColor}" Margin="0,0,0,16" TextWrapping="Wrap">
                                        <Run Text="File CSV: cột TÊN, KEY. "/>
                                        <Hyperlink IsEnabled="{Binding SelectedAIProvider, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Gemini}" 
                                                   NavigateUri="https://aistudio.google.com/apikey" RequestNavigate="Hyperlink_RequestNavigate"><Run Text="Lấy Gemini Key"/></Hyperlink>
                                        <Run Text=" | "/>
                                        <Hyperlink IsEnabled="{Binding SelectedAIProvider, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Groq}"
                                                   NavigateUri="https://console.groq.com/keys" RequestNavigate="Hyperlink_RequestNavigate"><Run Text="Lấy Groq Key"/></Hyperlink>
                                    </TextBlock>
                                    
                                    <!-- AI Model Selection -->
                                    <TextBlock Text="{Binding SelectedAIProvider, StringFormat='{}{0} Model'}" FontSize="13" FontWeight="SemiBold" Foreground="{Binding TextSecondaryColor}" Margin="0,0,0,8"/>
                                    <ComboBox ItemsSource="{Binding CurrentModels}" 
                                              SelectedItem="{Binding SelectedAIModel}"
                                              Background="{Binding BackgroundColor}"
                                              Foreground="{Binding TextPrimaryColor}"
                                              BorderBrush="{Binding BorderColor}"
                                              BorderThickness="1"
                                              Padding="8,6"
                                              FontSize="12"
                                              Margin="0,0,0,16"/>


                                    <!-- Quét thư mục -->
                                    <TextBlock Text="Đồng bộ hóa" FontSize="14" FontWeight="SemiBold" Foreground="{Binding TextPrimaryColor}" Margin="0,0,0,8"/>
                                    <Button Command="{Binding ScanFolderCommand}" Background="{Binding BackgroundColor}" BorderBrush="{Binding BorderColor}" BorderThickness="1" 
                                            Height="38" Padding="16,0" HorizontalAlignment="Left" Margin="0,0,0,16" materialDesign:ButtonAssist.CornerRadius="8" ToolTip="Quét thư mục lưu trữ để cập nhật dữ liệu">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FolderSyncOutline" Width="16" Height="16" Foreground="{Binding TextSecondaryColor}" VerticalAlignment="Center"/>
                                            <TextBlock Text="Quét thư mục lưu trữ" FontSize="11.5" Foreground="{Binding TextPrimaryColor}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Giới thiệu -->
                                    <Border Height="1" Background="{Binding BorderColor}" Margin="0,0,0,16"/>
                                    <StackPanel Orientation="Horizontal" Opacity="0.5">
                                        <materialDesign:PackIcon Kind="InformationOutline" Width="14" Height="14" Foreground="{Binding TextSecondaryColor}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{x:Static utilities:AppVersionInfo.ProductVersionLabel}" FontSize="11" Foreground="{Binding TextSecondaryColor}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
