<UserControl x:Class="DocumentManagement.Views.DashboardView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:DocumentManagement.Converters"
        xmlns:views="clr-namespace:DocumentManagement.Views"
        xmlns:utilities="clr-namespace:DocumentManagement.Utilities"
         
        Background="{Binding BackgroundColor}"
        FontFamily="Inter, Segoe UI"
        PreviewMouseDown="DashboardView_PreviewMouseDown"
        SizeChanged="DashboardView_SizeChanged">
    <UserControl.Resources>
        <!-- Re-using global Blueprint palette from SharedStyles.xaml -->
    </UserControl.Resources>
    
    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header Area (Streamlined) -->
        <Grid x:Name="DashboardHeader" Grid.Row="0" Margin="24,20,24,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="QUẢN LÝ HỒ SƠ" FontFamily="{DynamicResource Blueprint.Font.Header}" FontSize="18" FontWeight="Bold" Foreground="{Binding TextPrimaryColor}"/>
                    <TextBlock Text="{x:Static utilities:AppVersionInfo.VersionLabel}" FontSize="11" Foreground="{Binding TextSecondaryColor}" Margin="10,5,0,0"/>
                </StackPanel>
                <TextBlock Text="Hệ thống quản lý tài liệu kỹ thuật &amp; hợp đồng" FontFamily="{DynamicResource Blueprint.Font.Body}" FontSize="11" Foreground="{Binding TextSecondaryColor}" Opacity="0.8" Margin="0,4,0,0"/>
            </StackPanel>
            
            <StackPanel x:Name="DashboardHeaderActions" Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Margin="0,0,12,0">
                    <Button x:Name="GuaranteeNotificationButton" Command="{Binding ToggleGuaranteeNotificationsCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="38" Padding="12,0" ToolTip="Cảnh báo bảo lãnh">
                        <Grid>
                            <materialDesign:PackIcon Kind="BellOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                            <Border Width="18"
                                    Height="18"
                                    CornerRadius="9"
                                    Background="{DynamicResource Blueprint.Error}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="12,-8,-8,0"
                                    Visibility="{Binding HasGuaranteeAlerts, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding GuaranteeAlertCount}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Button>
                </Grid>
                <Button Command="{Binding OpenInitialChecklistSummaryCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="38" Padding="12,0" Margin="0,0,12,0" ToolTip="Tổng hợp thành phần hồ sơ">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ClipboardCheckOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                        <TextBlock Text="THÀNH PHẦN HS" FontFamily="{DynamicResource Blueprint.Font.Header}" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ExportExcelCommand}" Style="{StaticResource SuccessButtonStyle}" Height="38" Padding="12,0" Margin="0,0,12,0" ToolTip="Xuất báo cáo Excel">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FileExcel" Width="18" Height="18" VerticalAlignment="Center"/>
                        <TextBlock Text="XUẤT EXCEL" FontFamily="{DynamicResource Blueprint.Font.Header}" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenAddDialogCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="38" Padding="16,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" VerticalAlignment="Center"/>
                        <TextBlock Text="THÊM HỒ SƠ" FontFamily="{DynamicResource Blueprint.Font.Header}" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </StackPanel>

        </Grid>

        <Border x:Name="GuaranteeNotificationHost"
                Grid.Row="0"
                Grid.RowSpan="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,112,24,24"
                Panel.ZIndex="100"
                Visibility="{Binding IsGuaranteeNotificationOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <views:GuaranteeNotificationPanel DataContext="{Binding}"/>
        </Border>

        <Grid x:Name="DashboardContentLayout" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="DashboardListRow" Height="*"/>
                <RowDefinition x:Name="DashboardDetailRow" Height="0"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="DashboardListColumn" Width="0.3*" MinWidth="280" MaxWidth="420"/> <!-- Danh sách -->
                <ColumnDefinition x:Name="DashboardDetailColumn" Width="0.7*"/>   <!-- Chi tiết -->
            </Grid.ColumnDefinitions>

            <!-- Cột trái: Danh sách hợp đồng -->
            <Border x:Name="DashboardListPanel" Grid.Column="0" Margin="24,0,12,24" Background="{Binding CardBackgroundColor}" CornerRadius="16">
                <views:DocumentListView DataContext="{Binding}"/>
            </Border>

            <!-- Cột phải: Chi tiết & Tabs -->
            <Grid x:Name="DashboardDetailPanel" Grid.Column="1" Margin="12,0,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Thống kê nhanh -->
                    <RowDefinition Height="*"/>    <!-- Tabs nội dung -->
                </Grid.RowDefinitions>

                <!-- Content Row (Tabs) -->
                <Border Grid.Row="0" Grid.RowSpan="2" Background="{Binding CardBackgroundColor}" CornerRadius="16" ClipToBounds="True">
                    <views:DocumentDetailView DataContext="{Binding}"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

