<Window x:Class="DocumentManagement.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:utilities="clr-namespace:DocumentManagement.Utilities"
        mc:Ignorable="d"
        Title="Document Manager - Đăng nhập" Height="620" Width="860"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="True"
        ShowActivated="True" Topmost="False"
        utilities:ResponsiveScaleBehavior.IsEnabled="True"
        utilities:ResponsiveScaleBehavior.DesignWidth="860"
        utilities:ResponsiveScaleBehavior.DesignHeight="620"
        FontFamily="Inter, Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Converters.xaml"/>
            </ResourceDictionary.MergedDictionaries><Style x:Key="LoginInputBorderStyle" TargetType="Border"><Setter Property="BorderBrush" Value="{DynamicResource Blueprint.Outline}"/><Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Blueprint.Primary}"/></Trigger></Style.Triggers></Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="12" Background="{DynamicResource Blueprint.Surface}" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4.5*"/>
                <ColumnDefinition Width="5.5*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: BRANDING -->
            <Border Grid.Column="0" Background="{DynamicResource Blueprint.Surface}" CornerRadius="12,0,0,12" ClipToBounds="True">
                <Grid>
                    
                    <StackPanel VerticalAlignment="Center" Margin="32,0">
                        <!-- Logo -->
                        <Border Width="80" Height="80" Background="{DynamicResource Blueprint.Primary}" CornerRadius="16" HorizontalAlignment="Center" Margin="0,0,0,24">
                            <materialDesign:PackIcon Kind="CityVariantOutline" Width="48" Height="48" Foreground="{DynamicResource Blueprint.OnPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Title -->
                        <TextBlock Text="HỆ THỐNG&#x0a;QUẢN LÝ HỒ SƠ" FontSize="26" FontFamily="{DynamicResource Blueprint.Font.Header}" FontWeight="ExtraBold" Foreground="{DynamicResource Blueprint.OnSurface}" HorizontalAlignment="Center" TextAlignment="Center" LineHeight="36" Margin="0,0,0,16"/>
                        <TextBlock Text="Quản lý hợp đồng và hồ sơ nghiệm thu" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,24" LineHeight="20"/>

                        <Border BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="0,1,0,0" Padding="0,20,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><materialDesign:PackIcon Kind="FileDocumentEditOutline" Width="18" Height="18" Foreground="{DynamicResource Blueprint.Primary}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Hợp đồng, phụ lục và thanh toán" FontSize="13" Foreground="{DynamicResource Blueprint.OnSurface}" TextWrapping="Wrap" /></Grid>
                                <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><materialDesign:PackIcon Kind="ClipboardCheckOutline" Width="18" Height="18" Foreground="{DynamicResource Blueprint.Primary}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Hồ sơ nghiệm thu CVXD và VTĐV" FontSize="13" Foreground="{DynamicResource Blueprint.OnSurface}" TextWrapping="Wrap" /></Grid>
                                <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><materialDesign:PackIcon Kind="FileWordBox" Width="18" Height="18" Foreground="{DynamicResource Blueprint.Primary}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Tạo hồ sơ Word từ mẫu" FontSize="13" Foreground="{DynamicResource Blueprint.OnSurface}" TextWrapping="Wrap"/></Grid>
                            </StackPanel>
                        </Border>
                        <!-- Version -->
                        <TextBlock Text="{x:Static utilities:AppVersionInfo.VersionLabel}" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" FontSize="12" HorizontalAlignment="Center" Margin="0,32,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- RIGHT COLUMN: LOGIN FORM -->
            <Border Grid.Column="1" Background="{DynamicResource Blueprint.SurfaceContainer}" CornerRadius="0,12,12,0" MouseLeftButtonDown="DragWindow_MouseLeftButtonDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Close Button -->
                    <Button Grid.Row="0" x:Name="CloseButton" HorizontalAlignment="Right" VerticalAlignment="Top" 
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"
                            Padding="12,8" Click="CloseButton_Click" Margin="0,8,8,0">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18" />
                    </Button>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" MaxWidth="420" Margin="16,0,16,16">
                            
                            <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsLoggingIn}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><!-- FORM CARD -->
                            <Border Background="{DynamicResource Blueprint.Surface}" Padding="24" CornerRadius="12" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="1">
                                <Grid>
                                    <!-- QUICK LOGIN VIEW -->
                                    <StackPanel Visibility="{Binding IsQuickLoginMode, Converter={StaticResource BoolToVis}}">
                                        <!-- Avatar -->
                                        <Border Width="80" Height="80" CornerRadius="40" Margin="0,0,0,24" BorderBrush="{DynamicResource Blueprint.Primary}" BorderThickness="2" HorizontalAlignment="Center">
                                            <Grid>
                                                <!-- Fallback Icon if no avatar -->
                                                <materialDesign:PackIcon Kind="Account" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"/>
                                                <!-- Actual Avatar Image -->
                                                <Ellipse>
                                                    <Ellipse.Fill>
                                                        <ImageBrush ImageSource="{Binding LastUserAvatarPath, Converter={StaticResource SafeImageSourceConverter}}" Stretch="UniformToFill"/>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                            </Grid>
                                        </Border>

                                        <TextBlock Text="Đăng nhập lại" FontSize="22" FontFamily="{DynamicResource Blueprint.Font.Header}" FontWeight="Bold" Foreground="{DynamicResource Blueprint.OnSurface}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding LastUserFullName, StringFormat='Xin chào {0}, vui lòng nhập mật khẩu'}" FontSize="13" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" HorizontalAlignment="Stretch" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,24"/>

                                        <TextBlock Text="Mật khẩu" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Blueprint.OnSurface}" Margin="0,0,0,8"/>
                                        <Border Style="{StaticResource LoginInputBorderStyle}" Background="{DynamicResource Blueprint.SurfaceContainer}" CornerRadius="6" BorderThickness="1" Margin="0,0,0,24" Height="48">
                                            <Grid Margin="12,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Kind="LockOutline" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                
                                                <PasswordBox Grid.Column="1" x:Name="QuickPassBox" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Blueprint.OnSurface}" VerticalContentAlignment="Center" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" CaretBrush="{DynamicResource Blueprint.OnSurface}" 
                                                             PasswordChanged="QuickPassBox_PasswordChanged"
                                                             Visibility="{Binding IsPasswordVisible, Converter={StaticResource InvertedBoolToVis}}"/>
                                                
                                                <TextBox Grid.Column="1" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Blueprint.OnSurface}" VerticalContentAlignment="Center" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" CaretBrush="{DynamicResource Blueprint.OnSurface}"
                                                         Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVis}}"/>

                                                <Button Grid.Column="2" Style="{StaticResource MaterialDesignFlatButton}" Padding="4" Width="32" Height="32" 
                                                        Command="{Binding TogglePasswordVisibilityCommand}"
                                                        Foreground="{DynamicResource Blueprint.OnSurfaceVariant}">
                                                    <Grid>
                                                        <materialDesign:PackIcon Kind="EyeOutline" Visibility="{Binding IsPasswordVisible, Converter={StaticResource InvertedBoolToVis}}"/>
                                                        <materialDesign:PackIcon Kind="EyeOffOutline" Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVis}}"/>
                                                    </Grid>
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <!-- ERROR MESSAGE for Quick Login -->
                                        <Border Background="{DynamicResource Blueprint.ErrorContainer}" 
                                                BorderBrush="{DynamicResource Blueprint.Error}" 
                                                BorderThickness="1" 
                                                CornerRadius="6" 
                                                Padding="12,10" 
                                                Margin="0,0,0,16"
                                                Visibility="{Binding ErrorMessage, Converter={StaticResource StringVisibilityConverter}}">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Kind="AlertCircleOutline" 
                                                                         Foreground="{DynamicResource Blueprint.Error}" 
                                                                         Width="18" Height="18" 
                                                                         VerticalAlignment="Center" 
                                                                         Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" 
                                                           Foreground="{DynamicResource Blueprint.Error}" 
                                                           FontSize="13" 
                                                           FontWeight="Medium"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Center"/></Grid>
                                        </Border>

                                        <Button Style="{StaticResource MaterialDesignRaisedButton}" Background="{DynamicResource Blueprint.Primary}" Foreground="{DynamicResource Blueprint.OnPrimary}" BorderThickness="0" Height="48" 
                                                materialDesign:ButtonAssist.CornerRadius="6" Command="{Binding LoginCommand}" IsDefault="True">
                                            <StackPanel Orientation="Horizontal">
                                                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" Width="18" Height="18" IsIndeterminate="True" Foreground="{DynamicResource Blueprint.OnPrimary}" Margin="0,0,8,0" Visibility="{Binding IsLoggingIn, Converter={StaticResource BoolToVis}}"/><TextBlock FontSize="15" FontWeight="Bold" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Đăng nhập"/><Style.Triggers><DataTrigger Binding="{Binding IsLoggingIn}" Value="True"><Setter Property="Text" Value="Đang xử lý..."/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                                <materialDesign:PackIcon Kind="ChevronRight" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource Blueprint.Primary}" Height="40" Margin="0,24,0,0"
                                                Command="{Binding SwitchToFullLoginCommand}">
                                            <TextBlock Text="Đăng nhập bằng tài khoản khác" FontSize="13"/>
                                        </Button>
                                    </StackPanel>

                                    <!-- FULL LOGIN / REGISTER VIEW -->
                                    <StackPanel Visibility="{Binding IsQuickLoginMode, Converter={StaticResource InvertedBoolToVis}}">
                                        <!-- Lock Icon -->
                                        <Border Width="64" Height="64" Background="{DynamicResource Blueprint.PrimaryContainer}" CornerRadius="32" HorizontalAlignment="Center" Margin="0,0,0,24">
                                            <materialDesign:PackIcon Kind="Lock" Width="28" Height="28" Foreground="{DynamicResource Blueprint.Primary}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <materialDesign:PackIcon.Effect>
                                                    <DropShadowEffect Color="#2563EB" BlurRadius="20" ShadowDepth="0"/>
                                                </materialDesign:PackIcon.Effect>
                                            </materialDesign:PackIcon>
                                        </Border>

                                        <TextBlock Text="Tạo tài khoản Admin" 
                                                   Visibility="{Binding IsRegistrationMode, Converter={StaticResource BoolToVis}}"
                                                   FontSize="22" FontFamily="{DynamicResource Blueprint.Font.Header}" FontWeight="Bold" Foreground="{DynamicResource Blueprint.OnSurface}" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                                        
                                        <TextBlock Text="Đăng nhập" 
                                                   Visibility="{Binding IsRegistrationMode, Converter={StaticResource InvertedBoolToVis}}"
                                                   FontSize="22" FontFamily="{DynamicResource Blueprint.Font.Header}" FontWeight="Bold" Foreground="{DynamicResource Blueprint.OnSurface}" Margin="0,0,0,8" HorizontalAlignment="Center"/>

                                        <TextBlock Text="Vui lòng đăng nhập để tiếp tục sử dụng" FontSize="13" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" HorizontalAlignment="Center" Margin="0,0,0,32" Visibility="{Binding IsRegistrationMode, Converter={StaticResource InvertedBoolToVis}}"/>
                                        <TextBlock Text="Thiết lập tài khoản quản trị đầu tiên" FontSize="13" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" HorizontalAlignment="Center" Margin="0,0,0,32" Visibility="{Binding IsRegistrationMode, Converter={StaticResource BoolToVis}}"/>

                                        <!-- COMMON FIELDS -->
                                        <TextBlock Text="Tên đăng nhập" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Blueprint.OnSurface}" Margin="0,0,0,8"/>
                                        <Border Style="{StaticResource LoginInputBorderStyle}" Background="{DynamicResource Blueprint.SurfaceContainer}" CornerRadius="6" BorderThickness="1" Margin="0,0,0,20" Height="48">
                                            <Grid Margin="12,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Kind="AccountOutline" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <TextBox x:Name="UsernameBox" Grid.Column="1" Text="{Binding Username}" materialDesign:HintAssist.Hint="Nhập tên đăng nhập" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Blueprint.OnSurface}" VerticalContentAlignment="Center" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" CaretBrush="{DynamicResource Blueprint.OnSurface}"/>
                                            </Grid>
                                        </Border>

                                        <TextBlock Text="Mật khẩu" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Blueprint.OnSurface}" Margin="0,0,0,8"/>
                                        <Border Style="{StaticResource LoginInputBorderStyle}" Background="{DynamicResource Blueprint.SurfaceContainer}" CornerRadius="6" BorderThickness="1" Margin="0,0,0,20" Height="48">
                                            <Grid Margin="12,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Kind="LockOutline" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                
                                                <PasswordBox Grid.Column="1" x:Name="PassBox" materialDesign:HintAssist.Hint="Nhập mật khẩu" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Blueprint.OnSurface}" VerticalContentAlignment="Center" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" CaretBrush="{DynamicResource Blueprint.OnSurface}" 
                                                             PasswordChanged="PassBox_PasswordChanged"
                                                             Visibility="{Binding IsPasswordVisible, Converter={StaticResource InvertedBoolToVis}}"/>
                                                
                                                <TextBox Grid.Column="1" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Blueprint.OnSurface}" VerticalContentAlignment="Center" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" CaretBrush="{DynamicResource Blueprint.OnSurface}"
                                                         Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVis}}"/>

                                                <Button Grid.Column="2" Style="{StaticResource MaterialDesignFlatButton}" Padding="4" Width="32" Height="32" 
                                                        Command="{Binding TogglePasswordVisibilityCommand}"
                                                        Foreground="{DynamicResource Blueprint.OnSurfaceVariant}">
                                                    <Grid>
                                                        <materialDesign:PackIcon Kind="EyeOutline" Visibility="{Binding IsPasswordVisible, Converter={StaticResource InvertedBoolToVis}}"/>
                                                        <materialDesign:PackIcon Kind="EyeOffOutline" Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVis}}"/>
                                                    </Grid>
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <!-- REGISTRATION SPECIFIC FIELDS -->
                                        <StackPanel Visibility="{Binding IsRegistrationMode, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Họ và tên" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Blueprint.OnSurface}" Margin="0,0,0,8"/>
                                            <Border Style="{StaticResource LoginInputBorderStyle}" Background="{DynamicResource Blueprint.SurfaceContainer}" CornerRadius="6" BorderThickness="1" Margin="0,0,0,20" Height="48">
                                                <Grid Margin="12,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <materialDesign:PackIcon Kind="CardAccountDetailsOutline" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                    <TextBox Grid.Column="1" Text="{Binding FullName}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Blueprint.OnSurface}" VerticalContentAlignment="Center" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" CaretBrush="{DynamicResource Blueprint.OnSurface}"/>
                                                </Grid>
                                            </Border>

                                            <TextBlock Text="Số điện thoại" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Blueprint.OnSurface}" Margin="0,0,0,8"/>
                                            <Border Style="{StaticResource LoginInputBorderStyle}" Background="{DynamicResource Blueprint.SurfaceContainer}" CornerRadius="6" BorderThickness="1" Margin="0,0,0,20" Height="48">
                                                <Grid Margin="12,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <materialDesign:PackIcon Kind="PhoneOutline" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                    <TextBox Grid.Column="1" Text="{Binding Phone}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Blueprint.OnSurface}" VerticalContentAlignment="Center" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" CaretBrush="{DynamicResource Blueprint.OnSurface}"/>
                                                </Grid>
                                            </Border>

                                            <Button Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource Blueprint.Primary}" HorizontalAlignment="Left" Margin="0,0,0,20" Command="{Binding SelectAvatarCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="ImageOutline" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Chọn ảnh đại diện"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>

                                        <Grid Visibility="{Binding IsRegistrationMode, Converter={StaticResource InvertedBoolToVis}}" Margin="0,0,0,32">
                                            <Button Style="{StaticResource MaterialDesignFlatButton}" Content="Quên mật khẩu?" Foreground="{DynamicResource Blueprint.Primary}" Padding="0" Height="20" HorizontalAlignment="Right" Command="{Binding ForgotPasswordCommand}"/>
                                        </Grid>

                                        <!-- ERROR MESSAGE -->
                                        <Border Background="{DynamicResource Blueprint.ErrorContainer}" 
                                                BorderBrush="{DynamicResource Blueprint.Error}" 
                                                BorderThickness="1" 
                                                CornerRadius="6" 
                                                Padding="12,10" 
                                                Margin="0,0,0,16"
                                                Visibility="{Binding ErrorMessage, Converter={StaticResource StringVisibilityConverter}}">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Kind="AlertCircleOutline" 
                                                                         Foreground="{DynamicResource Blueprint.Error}" 
                                                                         Width="18" Height="18" 
                                                                         VerticalAlignment="Center" 
                                                                         Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" 
                                                           Foreground="{DynamicResource Blueprint.Error}" 
                                                           FontSize="13" 
                                                           FontWeight="Medium"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Center"/></Grid>
                                        </Border>

                                        <!-- ACTIONS -->
                                        <Button Style="{StaticResource MaterialDesignRaisedButton}" Background="{DynamicResource Blueprint.Primary}" Foreground="{DynamicResource Blueprint.OnPrimary}" BorderThickness="0" Height="48" 
                                                materialDesign:ButtonAssist.CornerRadius="6" Command="{Binding LoginCommand}" 
                                                Visibility="{Binding IsRegistrationMode, Converter={StaticResource InvertedBoolToVis}}" IsDefault="True">
                                            <StackPanel Orientation="Horizontal">
                                                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" Width="18" Height="18" IsIndeterminate="True" Foreground="{DynamicResource Blueprint.OnPrimary}" Margin="0,0,8,0" Visibility="{Binding IsLoggingIn, Converter={StaticResource BoolToVis}}"/><TextBlock FontSize="15" FontWeight="Bold" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Đăng nhập"/><Style.Triggers><DataTrigger Binding="{Binding IsLoggingIn}" Value="True"><Setter Property="Text" Value="Đang xử lý..."/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                                <materialDesign:PackIcon Kind="ChevronRight" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        
                                        <Button Style="{StaticResource MaterialDesignRaisedButton}" Background="{DynamicResource Blueprint.Primary}" Foreground="{DynamicResource Blueprint.OnPrimary}" BorderThickness="0" Height="48" 
                                                materialDesign:ButtonAssist.CornerRadius="6" Command="{Binding RegisterAdminCommand}" 
                                                Visibility="{Binding IsRegistrationMode, Converter={StaticResource BoolToVis}}" IsDefault="True">
                                            <StackPanel Orientation="Horizontal">
                                                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" Width="18" Height="18" IsIndeterminate="True" Foreground="{DynamicResource Blueprint.OnPrimary}" Margin="0,0,8,0" Visibility="{Binding IsLoggingIn, Converter={StaticResource BoolToVis}}"/><TextBlock FontSize="15" FontWeight="Bold" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Tạo tài khoản"/><Style.Triggers><DataTrigger Binding="{Binding IsLoggingIn}" Value="True"><Setter Property="Text" Value="Đang xử lý..."/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                                <materialDesign:PackIcon Kind="ChevronRight" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Grid Margin="0,24" Visibility="{Binding IsRegistrationMode, Converter={StaticResource InvertedBoolToVis}}">
                                            <Separator Background="{DynamicResource Blueprint.Outline}" Margin="0,0,0,0"/>
                                            <TextBlock Text="hoặc" Background="{DynamicResource Blueprint.Surface}" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" HorizontalAlignment="Center" Padding="8,0" FontSize="12"/>
                                        </Grid>

                                        <Button Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="{DynamicResource Blueprint.Outline}" Foreground="{DynamicResource Blueprint.OnSurface}" Height="48" 
                                                materialDesign:ButtonAssist.CornerRadius="6"
                                                Command="{Binding LoginAsGuestCommand}" Visibility="{Binding IsRegistrationMode, Converter={StaticResource InvertedBoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="LockOpenVariantOutline" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Đăng nhập tài khoản Guest" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            
                            <!-- FOOTER -->
                            <TextBlock Text="Powered by LQL" FontSize="12" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" HorizontalAlignment="Center" Margin="0,32,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
