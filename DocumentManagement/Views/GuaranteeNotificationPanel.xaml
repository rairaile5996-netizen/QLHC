<UserControl x:Class="DocumentManagement.Views.GuaranteeNotificationPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:models="clr-namespace:DocumentManagement.Models"
             mc:Ignorable="d"
             Width="420"
             MaxHeight="520">
    <Border Padding="16"
            CornerRadius="16"
            Background="{DynamicResource Blueprint.SurfaceContainer}"
            BorderBrush="{DynamicResource Blueprint.Outline}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.34" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Cảnh báo bảo lãnh"
                               FontFamily="{DynamicResource Blueprint.Font.Header}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Blueprint.OnSurface}"/>
                    <TextBlock Text="{Binding GuaranteeAlertCount, StringFormat='{}{0} cảnh báo chưa xử lý'}"
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Command="{Binding CloseGuaranteeNotificationPanelCommand}"
                        Style="{StaticResource ToolbarIconButtonStyle}">
                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                </Button>
            </Grid>

            <Border Grid.Row="1"
                    Visibility="{Binding HasGuaranteeAlerts, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                    Padding="18"
                    CornerRadius="12"
                    Background="{DynamicResource Blueprint.SurfaceBright}">
                <StackPanel HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="34" Height="34" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Không có cảnh báo bảo lãnh đang hoạt động."
                               Margin="0,10,0,0"
                               TextAlignment="Center"
                               Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1"
                          Visibility="{Binding HasGuaranteeAlerts, Converter={StaticResource BooleanToVisibilityConverter}}"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding GuaranteeAlerts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:GuaranteeAlertItem}">
                            <Button Command="{Binding DataContext.OpenGuaranteeAlertCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Margin="0,0,0,10"
                                    Padding="0"
                                    MinHeight="116"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Background="Transparent"
                                    BorderThickness="0">
                                <Border x:Name="AlertCard"
                                        MinHeight="116"
                                        HorizontalAlignment="Stretch"
                                        Padding="14"
                                        CornerRadius="14"
                                        Background="{DynamicResource Blueprint.SurfaceBright}"
                                        BorderBrush="{DynamicResource Blueprint.Outline}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding ContractNumber}" FontWeight="Bold" Foreground="{DynamicResource Blueprint.OnSurface}"/>
                                            <TextBlock Text="{Binding TypeDisplay}" Margin="0,4,0,0" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding LetterNumber, StringFormat='Số: {0}'}" Margin="0,4,0,0" Foreground="{DynamicResource Blueprint.OnSurface}"/>
                                            <TextBlock Text="{Binding RelationLabel}" Margin="0,4,0,0" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Width="124" HorizontalAlignment="Right">
                                            <TextBlock x:Name="SeverityText" Text="{Binding SeverityDisplay}" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Right" HorizontalAlignment="Stretch"/>
                                            <TextBlock Text="{Binding ExpiryText}" Margin="0,6,0,0" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding RemainingText}" Margin="0,4,0,0" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Severity}" Value="{x:Static models:GuaranteeAlertSeverity.Warning}">
                                    <Setter TargetName="AlertCard" Property="BorderBrush" Value="{DynamicResource Blueprint.Warning}"/>
                                    <Setter TargetName="SeverityText" Property="Foreground" Value="{DynamicResource Blueprint.Warning}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Severity}" Value="{x:Static models:GuaranteeAlertSeverity.Urgent}">
                                    <Setter TargetName="AlertCard" Property="BorderBrush" Value="{DynamicResource Blueprint.Error}"/>
                                    <Setter TargetName="SeverityText" Property="Foreground" Value="{DynamicResource Blueprint.Error}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Severity}" Value="{x:Static models:GuaranteeAlertSeverity.Overdue}">
                                    <Setter TargetName="AlertCard" Property="BorderBrush" Value="{DynamicResource Blueprint.Error}"/>
                                    <Setter TargetName="SeverityText" Property="Foreground" Value="{DynamicResource Blueprint.Error}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
