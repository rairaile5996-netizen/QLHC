<UserControl x:Class="DocumentManagement.Views.SettingsPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    
    <Border Background="{Binding CardBackgroundColor}" CornerRadius="12" Padding="16" MinWidth="280">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.25"/>
        </Border.Effect>
        <StackPanel>
            <!-- Theme Section -->
            <TextBlock Text="Giao diện" FontSize="14" FontWeight="SemiBold" Foreground="{Binding TextPrimaryColor}" Margin="0,0,0,12"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Border Width="55" Height="38" CornerRadius="8" Background="#F1F5F9" BorderThickness="2" Cursor="Hand" Margin="0,0,8,0"
                        BorderBrush="{Binding LightThemeBorderColor}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding SetThemeCommandCommand}" CommandParameter="Light"/>
                    </Border.InputBindings>
                    <materialDesign:PackIcon Kind="WhiteBalanceSunny" Width="18" Height="18" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border Width="55" Height="38" CornerRadius="8" Background="#1E293B" BorderThickness="2" Cursor="Hand"
                        BorderBrush="{Binding DarkThemeBorderColor}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding SetThemeCommandCommand}" CommandParameter="Dark"/>
                    </Border.InputBindings>
                    <materialDesign:PackIcon Kind="MoonWaningCrescent" Width="18" Height="18" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
            <TextBlock FontSize="11" Foreground="{Binding TextSecondaryColor}" Margin="0,0,0,16">
                <Run Text="Hiện tại: "/><Run Text="{Binding CurrentThemeName, Mode=OneWay}" FontWeight="SemiBold"/>
            </TextBlock>
            
            <!-- Folder Path Section -->
            <TextBlock Text="Thư mục lưu hồ sơ" FontSize="14" FontWeight="SemiBold" Foreground="{Binding TextPrimaryColor}" Margin="0,0,0,8"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding BaseFolderPath, UpdateSourceTrigger=PropertyChanged}" 
                         Background="{Binding BackgroundColor}" 
                         Foreground="{Binding TextPrimaryColor}" 
                         BorderBrush="{Binding BorderColor}" 
                         BorderThickness="1" 
                         Padding="8,6" 
                         FontSize="12"
                         IsReadOnly="True"
                         VerticalAlignment="Center"/>
                <Button Grid.Column="1" Width="36" Height="36" Padding="0" Margin="8,0,0,0" 
                        Background="{Binding BackgroundColor}" BorderThickness="1" BorderBrush="{Binding BorderColor}"
                        Command="{Binding BrowseFolderCommand}" ToolTip="Chọn thư mục">
                    <materialDesign:PackIcon Kind="FolderOpen" Width="18" Height="18" Foreground="{Binding TextSecondaryColor}"/>
                </Button>
            </Grid>
            
            <!-- Gemini API Keys Section -->
            <TextBlock Text="Gemini API Keys" FontSize="14" FontWeight="SemiBold" Foreground="{Binding TextPrimaryColor}" Margin="0,16,0,8"/>
            <Border Background="{Binding BackgroundColor}" BorderBrush="{Binding BorderColor}" BorderThickness="1" CornerRadius="4" Padding="8" MaxHeight="120">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding GeminiApiKeyList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="25"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Index}" FontSize="11" Foreground="{Binding DataContext.TextSecondaryColor, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="#F59E0B"/>
                                    <TextBlock Grid.Column="2" Text="{Binding MaskedKey}" FontSize="11" Foreground="{Binding DataContext.TextSecondaryColor, RelativeSource={RelativeSource AncestorType=ItemsControl}}" FontFamily="Consolas"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            <TextBlock Text="{Binding GeminiApiKeyCount, StringFormat='Tổng: {0} key'}" FontSize="10" Foreground="{Binding TextSecondaryColor}" Margin="0,4,0,8"/>
            
            <!-- Import/Clear Buttons -->
            <StackPanel Orientation="Horizontal">
                <Button Background="#3B82F6" Foreground="White" Height="32" Padding="12,0" 
                        BorderThickness="0"
                        Command="{Binding ImportApiKeyCsvCommand}" ToolTip="Import file CSV (TÊN,KEY)" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FileImport" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Import CSV" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Background="#EF4444" Foreground="White" Height="32" Padding="12,0" Margin="8,0,0,0"
                        BorderThickness="0"
                        Command="{Binding ClearAllApiKeysCommand}" ToolTip="Xóa tất cả API key" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="DeleteForever" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Xóa hết" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock FontSize="10" Foreground="{Binding TextSecondaryColor}" Margin="0,4,0,0" TextWrapping="Wrap">
                <Run Text="File CSV: cột TÊN, KEY. "/>
                <Hyperlink NavigateUri="https://aistudio.google.com/apikey" RequestNavigate="Hyperlink_RequestNavigate">
                    <Run Text="Lấy key tại Google AI Studio"/>
                </Hyperlink>
            </TextBlock>
            
            <!-- Gemini Model Section -->
            <TextBlock Text="Gemini Model" FontSize="14" FontWeight="SemiBold" Foreground="{Binding TextPrimaryColor}" Margin="0,16,0,8"/>
            <ComboBox ItemsSource="{Binding GeminiModels}" 
                      SelectedItem="{Binding SelectedGeminiModel}"
                      Background="{Binding BackgroundColor}"
                      Foreground="{Binding TextPrimaryColor}"
                      BorderBrush="{Binding BorderColor}"
                      BorderThickness="1"
                      Padding="8,6"
                      FontSize="12"/>
        </StackPanel>
    </Border>
</UserControl>
