<Window x:Class="DocumentManagement.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:DocumentManagement.ViewModels"
        xmlns:views="clr-namespace:DocumentManagement.Views"
        xmlns:utilities="clr-namespace:DocumentManagement.Utilities"
        xmlns:updates="clr-namespace:DocumentManagement.Views.Updates"
        mc:Ignorable="d"
        Title="Document Manager"
        WindowState="Normal"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="{DynamicResource Blueprint.Surface}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        FontFamily="Inter, Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>


    <Window.Resources>

        <!-- ================================================= -->
        <!-- DataTemplates to link ViewModels to Views         -->
        <!-- ================================================= -->

        <DataTemplate DataType="{x:Type vm:MainViewModel}">
            <views:DashboardView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CvxdWindowViewModel}">
            <views:CvxdView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:VtdvViewModel}">
            <views:VtdvView/>
        </DataTemplate>


        <!-- ================================================= -->
        <!-- SIDEBAR BUTTON STYLE                              -->
        <!-- ================================================= -->

        <Style x:Key="SidebarButtonStyle"
               TargetType="RadioButton">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource Blueprint.OnSurfaceVariant}"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Width"
                    Value="48"/>

            <Setter Property="Height"
                    Value="48"/>

            <Setter Property="Margin"
                    Value="0,8"/>

            <Setter Property="HorizontalAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="RadioButton">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12">

                            <ContentPresenter
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"/>

                        </Border>


                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter Property="Background"
                                        Value="#1A2563EB"/>

                                <Setter Property="Foreground"
                                        Value="{DynamicResource Blueprint.OnSurface}"/>

                            </Trigger>


                            <Trigger Property="IsChecked"
                                     Value="True">

                                <Setter Property="Background"
                                        Value="#1A2563EB"/>

                                <Setter Property="Foreground"
                                        Value="{DynamicResource Blueprint.Primary}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <!-- ===================================================== -->
    <!-- ROOT                                                  -->
    <!-- ===================================================== -->

    <Border Background="{DynamicResource Blueprint.SurfaceContainer}"
            ClipToBounds="True">

        <Grid RenderOptions.ClearTypeHint="Enabled">


            <!-- ================================================= -->
            <!-- MAIN CONTENT AREA                                 -->
            <!-- ================================================= -->

            <Grid Background="{DynamicResource Blueprint.Surface}">

                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- ============================================= -->
                <!-- CUSTOM TITLE BAR                              -->
                <!-- ============================================= -->

                <Grid Grid.Row="0"
                      Background="Transparent">


                    <!-- LEFT -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                Margin="8,0"
                                VerticalAlignment="Center">

                        <Button x:Name="BackButton"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Width="36"
                                Height="32"
                                Padding="0"
                                Click="BackButton_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="Quay lại chọn module">

                            <materialDesign:PackIcon
                                Kind="ArrowLeft"
                                Width="18"
                                Height="18"
                                Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"/>

                        </Button>

                    </StackPanel>


                    <!-- RIGHT -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,0,4,0"
                                VerticalAlignment="Center">

                        <!-- MINIMIZE -->
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Width="40"
                                Height="32"
                                Padding="0"
                                Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"
                                Click="MinimizeButton_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True">

                            <materialDesign:PackIcon
                                Kind="WindowMinimize"
                                Width="18"
                                Height="18"/>

                        </Button>


                        <!-- CLOSE -->
                        <Button x:Name="CloseBtn"
                                Width="40"
                                Height="32"
                                Padding="0"
                                Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"
                                Click="CloseButton_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True">

                            <Button.Style>

                                <Style TargetType="Button"
                                       BasedOn="{StaticResource MaterialDesignFlatButton}">

                                    <Style.Triggers>

                                        <Trigger Property="IsMouseOver"
                                                 Value="True">

                                            <Setter Property="Background"
                                                    Value="#EF4444"/>

                                            <Setter Property="Foreground"
                                                    Value="White"/>

                                        </Trigger>

                                    </Style.Triggers>

                                </Style>

                            </Button.Style>


                            <materialDesign:PackIcon
                                Kind="Close"
                                Width="18"
                                Height="18"/>

                        </Button>

                    </StackPanel>

                </Grid>


                <!-- ============================================= -->
                <!-- DYNAMIC VIEW LOADER                           -->
                <!-- ============================================= -->

                <ContentControl Grid.Row="1"
                                Content="{Binding CurrentView}"
                                Margin="0"
                                ClipToBounds="True"/>

            </Grid>


            <!-- ================================================= -->
            <!-- UPDATE HOST                                      -->
            <!-- NỔI TRÊN TOÀN BỘ SHELL                           -->
            <!-- ================================================= -->

            <updates:UpdateHostView
                x:Name="UpdateHost"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,24,24"
                Panel.ZIndex="1000"/>

        </Grid>

    </Border>

</Window>
