<UserControl x:Class="DocumentManagement.Views.SharedProjectInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             Padding="32">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>
    <StackPanel SizeChanged="RootStack_SizeChanged">
        <!-- Section 1: Main Project & Contract Cards -->
        <Grid x:Name="MainInfoGrid" Margin="0,0,0,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="0.85*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Left Card: Project Information -->
            <Border x:Name="ProjectInfoCard" Grid.Column="0" Background="{DynamicResource Blueprint.SurfaceBright}" CornerRadius="12" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="1" Padding="32" Margin="0,0,12,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <Border Background="#3B82F6" CornerRadius="4" Padding="8,4" Margin="0,0,12,0">
                            <materialDesign:PackIcon Kind="City" Foreground="White" Width="16" Height="16" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="THÔNG TIN DỰ ÁN" FontFamily="{DynamicResource Blueprint.Font.Header}" FontSize="14" FontWeight="Black" Foreground="{DynamicResource Blueprint.OnSurface}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel>
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="DỰ ÁN" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" Margin="0,0,0,8"/>
                            <Border Background="{DynamicResource Blueprint.Surface}" Padding="12,4" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Blueprint.Outline}">
                                <TextBox Text="{Binding TenDuAn}" IsEnabled="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=ContentControl}}" Foreground="{DynamicResource Blueprint.OnSurface}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0" Background="Transparent"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="CÔNG TRÌNH" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" Margin="0,0,0,8"/>
                            <Border Background="{DynamicResource Blueprint.Surface}" Padding="12,4" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Blueprint.Outline}">
                                <TextBox Text="{Binding TenCongTrinh}" IsEnabled="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=ContentControl}}" Foreground="{DynamicResource Blueprint.OnSurface}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0" Background="Transparent"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="HẠNG MỤC / GÓI THẦU" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" Margin="0,0,0,8"/>
                            <Border Background="{DynamicResource Blueprint.Surface}" Padding="12,4" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Blueprint.Outline}">
                                <TextBox Text="{Binding TenHangMuc}" IsEnabled="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=ContentControl}}" Foreground="{DynamicResource Blueprint.OnSurface}" FontSize="13" TextWrapping="Wrap" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0" Background="Transparent" MinHeight="40"/>
                            </Border>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="ĐỊA ĐIỂM XÂY DỰNG" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" Margin="0,0,0,8"/>
                            <Border Background="{DynamicResource Blueprint.Surface}" Padding="12,4" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Blueprint.Outline}">
                                <TextBox Text="{Binding DiaDiem}" IsEnabled="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=ContentControl}}" Foreground="{DynamicResource Blueprint.OnSurface}" FontSize="13" TextWrapping="Wrap" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0" Background="Transparent" MinHeight="40"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Right Card: Contract Information -->
            <Border x:Name="ContractInfoCard" Grid.Column="1" Background="{DynamicResource Blueprint.SurfaceBright}" CornerRadius="12" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="1" Padding="24" Margin="12,0,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <Border Background="#F59E0B" CornerRadius="4" Padding="8,4" Margin="0,0,12,0">
                            <materialDesign:PackIcon Kind="FileDocumentEdit" Foreground="White" Width="16" Height="16" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="THÔNG TIN HỢP ĐỒNG" FontFamily="{DynamicResource Blueprint.Font.Header}" FontSize="14" FontWeight="Black" Foreground="#F59E0B" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="SỐ HỢP ĐỒNG" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding DisplayContractNumber}" Foreground="#3B82F6" FontSize="18" FontWeight="Black"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="NGÀY KÝ KẾT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding DisplaySignDate}" Foreground="{DynamicResource Blueprint.OnSurface}" FontSize="15" FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="BỘ TEMPLATE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding TemplateProfiles}"
                                  SelectedItem="{Binding TemplateProfile, UpdateSourceTrigger=PropertyChanged}"
                                  MinHeight="34"
                                  Foreground="{DynamicResource Blueprint.OnSurface}"
                                  materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Representatives Title -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
            <materialDesign:PackIcon Kind="AccountGroup" Foreground="#F59E0B" Width="24" Height="24" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <TextBlock Text="ĐẠI DIỆN CÁC BÊN LIÊN QUAN" FontFamily="{DynamicResource Blueprint.Font.Header}" FontSize="16" FontWeight="Black" Foreground="{DynamicResource Blueprint.OnSurface}" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Representative Cards Grid -->
        <Grid x:Name="RepresentativesGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Column 1: TVGS -->
            <Border x:Name="TvgsCard" Grid.Column="0" Background="{DynamicResource Blueprint.SurfaceBright}" CornerRadius="12" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="1" Padding="24" Margin="0,0,8,0" IsEnabled="{Binding IsTvgsSectionEnabled}">
                <StackPanel>
                    <Border Background="#2563EB" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,20">
                        <TextBlock Text="TƯ VẤN GIÁM SÁT" FontFamily="{DynamicResource Blueprint.Font.Header}" FontSize="10" FontWeight="Black" Foreground="White"/>
                    </Border>
                    <TextBlock Text="Không áp dụng với mẫu PKH" Visibility="{Binding IsTvgsSectionLocked, Converter={StaticResource BoolToVisibilityConverter}}" FontSize="10" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" Margin="0,-12,0,12"/>
                    
                    <TextBlock Text="ĐƠN VỊ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding TenTuVanGiamSat}" 
                             IsEnabled="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                             FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Blueprint.OnSurface}" Margin="0,0,0,16"
                             materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Blueprint.Outline}" Padding="0,4"/>

                    <TextBlock Text="KÝ HIỆU CÔNG TY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" Margin="0,0,0,4"/>
                    <Border Background="{DynamicResource Blueprint.Surface}" Padding="12,8" CornerRadius="4" Margin="0,0,0,16">
                        <TextBox Text="{Binding KyHieuTVGS}" IsEnabled="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                 Foreground="{DynamicResource Blueprint.OnSurface}" FontSize="13" BorderThickness="0" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"/>
                    </Border>
                    
                    <TextBlock Text="ĐẠI DIỆN TVGS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" Margin="0,0,0,4"/>
                    <Border Background="{DynamicResource Blueprint.Surface}" Padding="12,8" CornerRadius="4" Margin="0,0,0,16">
                        <TextBox Text="{Binding DaiDienTVGS}" IsEnabled="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                 Foreground="{DynamicResource Blueprint.OnSurface}" FontSize="13" BorderThickness="0" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"/>
                    </Border>

                    <TextBlock Text="CHỨC VỤ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" Margin="0,0,0,4"/>
                    <Border Background="{DynamicResource Blueprint.Surface}" Padding="12,8" CornerRadius="4">
                        <TextBox Text="{Binding ChucVuTVGS}" IsEnabled="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                 Foreground="{DynamicResource Blueprint.OnSurface}" FontSize="13" BorderThickness="0" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Column 2: Bên giao thầu -->
            <Border x:Name="GiaoThauCard" Grid.Column="1" Background="{DynamicResource Blueprint.SurfaceBright}" CornerRadius="12" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="1" Padding="24" Margin="8,0" IsEnabled="{Binding IsEmployerSectionEnabled}">
                <StackPanel>
                    <Border Background="#D97706" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,20">
                        <TextBlock Text="BÊN GIAO THẦU" FontFamily="{DynamicResource Blueprint.Font.Header}" FontSize="10" FontWeight="Black" Foreground="White"/>
                    </Border>
                    <TextBlock Text="Không áp dụng với mẫu Bà Nà" Visibility="{Binding IsEmployerSectionLocked, Converter={StaticResource BoolToVisibilityConverter}}" FontSize="10" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" Margin="0,-12,0,12"/>
                    
                    <TextBlock Text="ĐƠN VỊ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding TenChuDauTu}" 
                             IsEnabled="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                             FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Blueprint.OnSurface}" Margin="0,0,0,16"
                             materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Blueprint.Outline}" Padding="0,4"/>

                    <TextBlock Text="KÝ HIỆU CÔNG TY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" Margin="0,0,0,4"/>
                    <Border Background="{DynamicResource Blueprint.Surface}" Padding="12,8" CornerRadius="4" Margin="0,0,0,16">
                        <TextBox Text="{Binding KyHieuChuDauTu}" IsEnabled="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                 Foreground="{DynamicResource Blueprint.OnSurface}" FontSize="13" BorderThickness="0" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"/>
                    </Border>
                    
                    <TextBlock Text="ĐẠI DIỆN CĐT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" Margin="0,0,0,4"/>
                    <Border Background="{DynamicResource Blueprint.Surface}" Padding="12,8" CornerRadius="4" Margin="0,0,0,16">
                        <TextBox Text="{Binding DaiDienChuDauTu}" IsEnabled="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                 Foreground="{DynamicResource Blueprint.OnSurface}" FontSize="13" BorderThickness="0" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"/>
                    </Border>

                    <TextBlock Text="CHỨC VỤ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" Margin="0,0,0,4"/>
                    <Border Background="{DynamicResource Blueprint.Surface}" Padding="12,8" CornerRadius="4">
                        <TextBox Text="{Binding ChucVuCDT}" IsEnabled="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                 Foreground="{DynamicResource Blueprint.OnSurface}" FontSize="13" BorderThickness="0" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Column 3: Bên nhận thầu -->
            <Border x:Name="NhanThauCard" Grid.Column="2" Background="{DynamicResource Blueprint.SurfaceBright}" CornerRadius="12" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="1" Padding="24" Margin="8,0,0,0">
                <StackPanel>
                    <Border Background="#059669" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,20">
                        <TextBlock Text="BÊN NHẬN THẦU" FontFamily="{DynamicResource Blueprint.Font.Header}" FontSize="10" FontWeight="Black" Foreground="White"/>
                    </Border>
                    
                    <TextBlock Text="ĐƠN VỊ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding TenNhaThau}" 
                             IsEnabled="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                             FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Blueprint.OnSurface}" Margin="0,0,0,16"
                             materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Blueprint.Outline}" Padding="0,4"/>

                    <TextBlock Text="KÝ HIỆU CÔNG TY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" Margin="0,0,0,4"/>
                    <Border Background="{DynamicResource Blueprint.Surface}" Padding="12,8" CornerRadius="4" Margin="0,0,0,16">
                        <TextBox Text="{Binding KyHieuNhaThau}" IsEnabled="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                 Foreground="{DynamicResource Blueprint.OnSurface}" FontSize="13" BorderThickness="0" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"/>
                    </Border>
                    
                    <TextBlock Text="ĐẠI DIỆN NHÀ THẦU" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" Margin="0,0,0,4"/>
                    <Border Background="{DynamicResource Blueprint.Surface}" Padding="12,8" CornerRadius="4" Margin="0,0,0,16">
                        <TextBox Text="{Binding DaiDienNhaThau}" IsEnabled="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                 Foreground="{DynamicResource Blueprint.OnSurface}" FontSize="13" BorderThickness="0" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"/>
                    </Border>

                    <TextBlock Text="CHỨC VỤ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" Margin="0,0,0,4"/>
                    <Border Background="{DynamicResource Blueprint.Surface}" Padding="12,8" CornerRadius="4">
                        <TextBox Text="{Binding ChucVuNT}" IsEnabled="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                 Foreground="{DynamicResource Blueprint.OnSurface}" FontSize="13" BorderThickness="0" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
