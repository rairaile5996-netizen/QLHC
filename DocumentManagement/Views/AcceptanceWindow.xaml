<Window x:Class="DocumentManagement.Views.AcceptanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:DocumentManagement.ViewModels"
        xmlns:views="clr-namespace:DocumentManagement.Views"
        Title="Hồ Sơ Nghiệm Thu" 
        WindowState="Normal" 
        WindowStyle="None" 
        ResizeMode="CanResize" 
        AllowsTransparency="False" 
        Background="{DynamicResource Blueprint.Surface}"
        FontFamily="Inter, Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/> <!-- Sidebar -->
            <ColumnDefinition Width="*"/>   <!-- Content -->
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="{DynamicResource Blueprint.SurfaceContainer}" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="*"/>    <!-- Lists -->
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <Border Grid.Row="0" Background="{DynamicResource Blueprint.SurfaceBright}" Padding="16,12" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ClipboardCheckOutline" Width="20" Height="20" Foreground="{DynamicResource Blueprint.Primary}" VerticalAlignment="Center"/>
                            <TextBlock Text="CÔNG CỤ CVXD" FontSize="14" FontWeight="Bold" Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Hồ sơ nghiệm thu" FontSize="11" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" Margin="28,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- LISTS -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,16,0,0">
                        <!-- DANH SÁCH CVXD -->
                        <TextBlock Text="DANH SÁCH CVXD" 
                                   FontSize="11" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" 
                                   Margin="16,0,16,8"/>
                        
                        <RadioButton Style="{StaticResource MaterialDesignTabRadioButton}"
                                     Content="Hồ sơ CVXD"
                                     FontSize="13"
                                     IsChecked="True"
                                     Command="{Binding NavigateToCvxdCommand}"
                                     GroupName="AcceptanceModule"
                                     Margin="8,0,8,4"
                                     Padding="12,8"/>

                        <!-- DANH SÁCH VTĐV -->
                        <TextBlock Text="DANH SÁCH VTĐV" 
                                   FontSize="11" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" 
                                   Margin="16,24,16,8"/>
                        
                        <RadioButton Style="{StaticResource MaterialDesignTabRadioButton}"
                                     Content="Nghiệm thu VTĐV"
                                     FontSize="13"
                                     Command="{Binding NavigateToVtdvCommand}"
                                     GroupName="AcceptanceModule"
                                     Margin="8,0,8,4"
                                     Padding="12,8"/>

                        <TextBlock Text="PHÊ DUYỆT VẬT TƯ" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" Margin="16,24,16,8"/>
                        <RadioButton Style="{StaticResource MaterialDesignTabRadioButton}" Content="PDVT" FontSize="13" Command="{Binding NavigateToPdvtCommand}" GroupName="AcceptanceModule" Margin="8,0,8,4" Padding="12,8"/>

                        <TextBlock Text="HỒ SƠ PHÁP LÝ" 
                                   FontSize="11" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource Blueprint.OnSurfaceVariant}" 
                                   Margin="16,24,16,8"/>

                        <RadioButton Style="{StaticResource MaterialDesignTabRadioButton}"
                                     Content="Tạo HSPL"
                                     FontSize="13"
                                     Command="{Binding NavigateToHsplCommand}"
                                     GroupName="AcceptanceModule"
                                     Margin="8,0,8,4"
                                     Padding="12,8">
                            <RadioButton.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileDocumentEditOutline" Width="18" Height="18" Margin="0,0,8,0"/>
                                        <TextBlock Text="Tạo HSPL"/>
                                    </StackPanel>
                                </DataTemplate>
                            </RadioButton.ContentTemplate>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Column="1" Background="{DynamicResource Blueprint.Surface}">
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/> <!-- Title Bar -->
                <RowDefinition Height="*"/>  <!-- Content -->
            </Grid.RowDefinitions>

            <!-- TITLE BAR -->
            <Border Grid.Row="0" Background="Transparent" BorderBrush="{DynamicResource Blueprint.Outline}" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="MinimizeButton" Style="{StaticResource MaterialDesignFlatButton}" Width="46" Height="36" Padding="0" Click="MinimizeButton_Click" WindowChrome.IsHitTestVisibleInChrome="True">
                            <materialDesign:PackIcon Kind="WindowMinimize" Width="16" Height="16" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"/>
                        </Button>
                        <Button x:Name="CloseButton" Style="{StaticResource MaterialDesignFlatButton}" Width="46" Height="36" Padding="0" Click="CloseButton_Click" WindowChrome.IsHitTestVisibleInChrome="True">
                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Foreground="{DynamicResource Blueprint.OnSurfaceVariant}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CONTENT AREA -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type vm:CvxdWindowViewModel}">
                        <views:CvxdView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:VtdvViewModel}">
                        <views:VtdvView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:HsplViewModel}">
                        <views:HsplView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:PdvtViewModel}">
                        <views:PdvtView/>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </Grid>
    </Grid>
</Window>
