<UserControl x:Class="DocumentManagement.Views.AiChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:DocumentManagement.Converters">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </UserControl.Resources>
    
    <Border Background="{Binding CardBackgroundColor}" CornerRadius="12" Width="380">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Header -->
            <Border Grid.Row="0" BorderBrush="{Binding BorderColor}" BorderThickness="0,0,0,1" Padding="16,12">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Robot" Width="24" Height="24" Foreground="#8B5CF6" VerticalAlignment="Center"/>
                        <TextBlock Text="AI Trợ lý Hợp đồng" FontSize="16" FontWeight="Bold" Foreground="{Binding TextPrimaryColor}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Padding="4" 
                            Command="{Binding ClearChatCommand}" ToolTip="Xóa lịch sử chat" Cursor="Hand">
                        <materialDesign:PackIcon Kind="DeleteOutline" Width="20" Height="20" Foreground="{Binding TextSecondaryColor}"/>
                    </Button>
                </Grid>
            </Border>
            
            <!-- Chat Messages -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" x:Name="ChatScrollViewer">
                <ItemsControl ItemsSource="{Binding ChatMessages}" Margin="12,8,12,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,4" Padding="12,10" CornerRadius="12" MaxWidth="320">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                <Setter Property="Background" Value="#3B82F6"/>
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsUser}" Value="False">
                                                <Setter Property="Background" Value="{Binding DataContext.BackgroundColor, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="13">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsUser}" Value="False">
                                                    <Setter Property="Foreground" Value="{Binding DataContext.TextPrimaryColor, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            
            <!-- Loading Indicator -->
            <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="12,0,12,8"
                    Background="{Binding BackgroundColor}" CornerRadius="12" Padding="12,8"
                    Visibility="{Binding IsChatLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Loading" Width="16" Height="16" Foreground="#8B5CF6" VerticalAlignment="Center">
                        <materialDesign:PackIcon.RenderTransform>
                            <RotateTransform x:Name="LoadingRotate" CenterX="8" CenterY="8"/>
                        </materialDesign:PackIcon.RenderTransform>
                        <materialDesign:PackIcon.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </materialDesign:PackIcon.Triggers>
                    </materialDesign:PackIcon>
                    <TextBlock Text="Đang xử lý..." FontSize="12" Foreground="{Binding TextSecondaryColor}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            
            <!-- Input Area -->
            <Border Grid.Row="2" BorderBrush="{Binding BorderColor}" BorderThickness="0,1,0,0" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{Binding BackgroundColor}" CornerRadius="12" Padding="12,10" VerticalAlignment="Bottom">
                        <Grid>
                            <TextBox x:Name="ChatInputBox"
                                     Text="{Binding ChatInput, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="Transparent" BorderThickness="0" 
                                     Foreground="{Binding TextPrimaryColor}" FontSize="13"
                                     TextWrapping="Wrap" AcceptsReturn="False"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled"
                                     MaxHeight="120"
                                     MinHeight="20"
                                     VerticalContentAlignment="Top"
                                     KeyDown="ChatInputBox_KeyDown"
                                     materialDesign:HintAssist.Hint="Hỏi về hợp đồng... (Enter gửi)"
                                     materialDesign:HintAssist.IsFloating="False"
                                     materialDesign:TextFieldAssist.DecorationVisibility="Collapsed">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TextBox">
                                                    <ScrollViewer x:Name="PART_ContentHost" 
                                                                  VerticalScrollBarVisibility="Auto"
                                                                  HorizontalScrollBarVisibility="Disabled"/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Grid>
                    </Border>
                    <Button Grid.Column="1" Width="40" Height="40" Margin="8,0,0,0" VerticalAlignment="Bottom"
                            Background="#8B5CF6" BorderThickness="0" Cursor="Hand"
                            Command="{Binding SendChatMessageCommand}"
                            IsEnabled="{Binding IsChatLoading, Converter={StaticResource InverseBoolConverter}}"
                            ToolTip="Gửi">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="20">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <materialDesign:PackIcon Kind="Send" Width="18" Height="18" Foreground="White"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
