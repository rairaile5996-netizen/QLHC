<Window x:Class="DocumentManagement.ColumnNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Thêm cột"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent">
    <Window.Resources>
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8"/>
        </Style>
    </Window.Resources>

    <Border Background="#0F172A" CornerRadius="16" BorderBrush="#1E293B" BorderThickness="1" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.45"/>
        </Border.Effect>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="10" Background="#1E293B">
                    <materialDesign:PackIcon Kind="TableColumnPlusAfter" Width="24" Height="24" Foreground="#3B82F6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="Thêm cột" FontSize="17" FontWeight="ExtraBold" Foreground="White"/>
                    <TextBlock Text="Dùng cho mapping placeholder không cố định" FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" Click="Cancel_Click">
                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18" Foreground="#94A3B8"/>
                </Button>
            </Grid>

            <TextBlock x:Name="MessageText" Grid.Row="1" TextWrapping="Wrap" Foreground="#CBD5E1" FontSize="13" LineHeight="19" Margin="0,0,0,14"/>

            <Border Grid.Row="2" Background="#111C2E" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="12,2" Margin="0,0,0,22">
                <TextBox x:Name="NameTextBox"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="White"
                         FontSize="14"
                         Height="36"
                         VerticalContentAlignment="Center"
                         materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                         KeyDown="NameTextBox_KeyDown"/>
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy" Click="Cancel_Click" Style="{StaticResource DialogButtonStyle}" Background="Transparent" Foreground="#94A3B8" BorderBrush="#334155" BorderThickness="1" Margin="0,0,10,0"/>
                <Button Content="Thêm cột" Click="Ok_Click" Style="{StaticResource DialogButtonStyle}" Background="#2563EB" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
